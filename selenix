    hexRowLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
    hexRowLabel.Font = Enum.Font.BuilderSansBold
    hexRowLabel.TextSize = 14
    hexRowLabel.TextXAlignment = Enum.TextXAlignment.Left
    hexRowLabel.Parent = hexRow
    local hexBox = Instance.new("TextBox")
    hexBox.AnchorPoint = Vector2.new(1, 0.5)
    hexBox.Position = UDim2.new(1, 0, 0.5, 0)
    hexBox.Size = UDim2.new(0, 110, 0, 28)
    hexBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    hexBox.Text = Utils.ToHex(current())
    hexBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    hexBox.Font = Enum.Font.BuilderSans
    hexBox.TextSize = 14
    hexBox.ClearTextOnFocus = false
    hexBox.Parent = hexRow
    Utils.AddCorner(hexBox, UDim.new(0, 6))
    Utils.AddPadding(hexBox, UDim.new(0, 8))

    -- RGB inputs (vertical, non-overlapping)
    local rgbRow = Instance.new("Frame")
    rgbRow.Size = UDim2.new(1, 0, 0, 108)
    rgbRow.Position = UDim2.new(0, 0, 0, 254)
    rgbRow.BackgroundTransparency = 1
    rgbRow.Parent = exp.Body
    local rgbLayout = Instance.new("UIListLayout")
    rgbLayout.Padding = UDim.new(0, 6)
    rgbLayout.Parent = rgbRow

    local refresh -- forward declaration

    local function sanitizeRGBText(txt)
        local filtered = txt:gsub("%D", "")
        if #filtered > 3 then filtered = filtered:sub(1, 3) end
        local num = tonumber(filtered) or 0
        if num > 255 then filtered = "255" end
        if filtered == "" then filtered = "0" end
        return filtered
    end

    -- RGB fields used to call refresh() on EVERY keystroke via
    -- GetPropertyChangedSignal("Text"), which re-set ~10 properties (hex
    -- label, all three color bars, both cursors, swatch, sibling boxes)
    -- per character typed. Typing "255" fired 3 full refreshes. Debounced
    -- with task.defer so rapid keystrokes within the same frame collapse
    -- into a single refresh, while still feeling instant to the user.
    local rgbRefreshPending = false
    local function requestRGBRefresh(onCommit)
        if rgbRefreshPending then return end
        rgbRefreshPending = true
        task.defer(function()
            rgbRefreshPending = false
            onCommit()
        end)
    end

    -- Labels created for each RGB field (R:/G:/B:), tracked here so
    -- ApplyTheme can restyle them like every other field label — previously
    -- they (and the hex/RGB input boxes below) were left at a fixed color
    -- and never reacted to a theme change at all, unlike the visually
    -- identical Components.Textbox input.
    local rgbLabels = {}

    local function makeRGBField(labelText, order, onCommit)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, 32)
        holder.LayoutOrder = order
        holder.BackgroundTransparency = 1
        holder.Parent = rgbRow
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 30, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = labelText
        lbl.TextColor3 = Color3.fromRGB(200, 200, 210)
        lbl.Font = Enum.Font.BuilderSansBold
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = holder
        table.insert(rgbLabels, lbl)
        local box = Instance.new("TextBox")
        box.Position = UDim2.new(0, 34, 0, 0)
        box.Size = UDim2.new(1, -34, 1, 0)
        box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        box.Text = "0"
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.Font = Enum.Font.BuilderSans
        box.TextSize = 14
        box.ClearTextOnFocus = false
        box.Parent = holder
        Utils.AddCorner(box, UDim.new(0, 6))
        Utils.AddPadding(box, UDim.new(0, 6))

        local isUpdating = false
        connMgr:Track(box:GetPropertyChangedSignal("Text"):Connect(function()
            if isUpdating then return end
            local clean = sanitizeRGBText(box.Text)
            if clean ~= box.Text then
                isUpdating = true
                box.Text = clean
                box.CursorPosition = #clean + 1
                isUpdating = false
            end
            requestRGBRefresh(onCommit)
        end))
        connMgr:Track(box.FocusLost:Connect(function()
            local clean = sanitizeRGBText(box.Text)
            if clean ~= box.Text then box.Text = clean end
            onCommit()
        end))
        return box
    end

    local rBox, gBox, bBox
    local function updateColorFromRGB()
        local r = math.clamp(tonumber(rBox.Text) or 0, 0, 255)
        local g = math.clamp(tonumber(gBox.Text) or 0, 0, 255)
        local b = math.clamp(tonumber(bBox.Text) or 0, 0, 255)
        hue, sat, val = Color3.fromRGB(r, g, b):ToHSV()
        refresh()
    end
    rBox = makeRGBField("R:", 1, updateColorFromRGB)
    gBox = makeRGBField("G:", 2, updateColorFromRGB)
    bBox = makeRGBField("B:", 3, updateColorFromRGB)

    -- Presets
    local presetColors = opts.Presets or {
        Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0),
        Color3.fromRGB(255, 60, 60), Color3.fromRGB(255, 150, 40),
        Color3.fromRGB(255, 230, 50), Color3.fromRGB(60, 220, 90),
        Color3.fromRGB(50, 210, 220), Color3.fromRGB(60, 120, 255),
        Color3.fromRGB(170, 80, 255), Color3.fromRGB(255, 90, 180),
    }
    local presetRow = Instance.new("Frame")
    presetRow.Size = UDim2.new(1, 0, 0, 26)
    presetRow.Position = UDim2.new(0, 0, 0, 370)
    presetRow.BackgroundTransparency = 1
    presetRow.Parent = exp.Body
    local presetLayout = Instance.new("UIListLayout")
    presetLayout.FillDirection = Enum.FillDirection.Horizontal
    presetLayout.Padding = UDim.new(0, 6)
    presetLayout.Parent = presetRow

    refresh = function()
        local pureHue = Color3.fromHSV(hue, 1, 1)
        sv.BackgroundColor3 = pureHue
        local picked = current()
        swatch.BackgroundColor3 = picked
        hexLabel.Text = Utils.ToHex(picked)
        if not hexBox:IsFocused() then hexBox.Text = Utils.ToHex(picked) end
        if not rBox:IsFocused() then rBox.Text = tostring(math.floor(picked.R * 255 + 0.5)) end
        if not gBox:IsFocused() then gBox.Text = tostring(math.floor(picked.G * 255 + 0.5)) end
        if not bBox:IsFocused() then bBox.Text = tostring(math.floor(picked.B * 255 + 0.5)) end
        svCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
        hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
        bwCursor.Position = UDim2.new(val, 0, 0.5, 0)
        bwGrad.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromHSV(hue, sat, 1))
        if opts.Callback then opts.Callback(picked) end
    end

    for _, presetColor in ipairs(presetColors) do
        local pbtn = Instance.new("TextButton")
        pbtn.Size = UDim2.new(0, 26, 0, 26)
        pbtn.BackgroundColor3 = presetColor
        pbtn.Text = ""
        pbtn.Parent = presetRow
        Utils.AddCorner(pbtn, UDim.new(0, 6))
        Animator.AddThickenStroke(pbtn, connMgr)
        connMgr:Track(pbtn.MouseButton1Click:Connect(function()
            hue, sat, val = presetColor:ToHSV()
            refresh()
        end))
    end

    -- Drag handling for SV box / hue bar / bw bar. All three follow the
    -- same shape — InputBegan sets which bar is active and does an
    -- immediate update, InputChanged re-runs that same update while
    -- dragging — previously duplicated three times over with only the
    -- updateXxx function and the "sv"/"hue"/"bw" tag changing. Now driven
    -- by one small dispatch table (dragUpdaters) plus one shared
    -- bindDragStart helper instead of three near-identical InputBegan
    -- blocks and a three-way if/elseif in InputChanged.
    local activeDrag = nil
    local function updateSV(pos)
        local absPos, absSize = sv.AbsolutePosition, sv.AbsoluteSize
        sat = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        val = 1 - math.clamp((pos.Y - absPos.Y) / absSize.Y, 0, 1)
        refresh()
    end
    local function updateHue(pos)
        local absPos, absSize = hueBar.AbsolutePosition, hueBar.AbsoluteSize
        hue = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        refresh()
    end
    local function updateBW(pos)
        local absPos, absSize = bwBar.AbsolutePosition, bwBar.AbsoluteSize
        val = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        refresh()
    end
    local dragUpdaters = { sv = updateSV, hue = updateHue, bw = updateBW }

    local function bindDragStart(bar, key, updateFn)
        connMgr:Track(bar.InputBegan:Connect(function(input)
            if Utils.IsPointerDown(input) then
                activeDrag = key
                updateFn(input.Position)
            end
        end))
    end
    bindDragStart(sv, "sv", updateSV)
    bindDragStart(hueBar, "hue", updateHue)
    bindDragStart(bwBar, "bw", updateBW)

    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if Utils.IsPointerDown(input) then activeDrag = nil end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if activeDrag and Utils.IsPointerMove(input) then
            dragUpdaters[activeDrag](input.Position)
        end
    end))

    connMgr:Track(hexBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local color, ok = Utils.HexToColor3(hexBox.Text)
            if ok then
                hue, sat, val = color:ToHSV()
                refresh()
                return
            end
        end
        hexBox.Text = Utils.ToHex(current())
    end))

    refresh()

    local self = { Instance = exp.Container }
    function self:Get() return current() end
    -- Programmatically set the color (used by Window:LoadConfig). Expects
    -- a Color3.
    function self:Set(color)
        hue, sat, val = color:ToHSV()
        refresh()
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, headerTextColor, boxTextColor = Utils.PanelColors(color, accent)
        local hexTextColor = (Utils.GetLuminance(panelBg) > 0.55) and Color3.fromRGB(90, 90, 100) or Color3.fromRGB(190, 190, 200)
        -- The RGB/HEX numeric input boxes previously stayed a fixed dark
        -- gray no matter the theme (unlike Components.Textbox's identical-
        -- purpose input, which always tracks Utils.Darken(color, 0.8)) — now
        -- themed the same way, for consistency with every other input field
        -- in the library.
        local entries = {
            { exp.Header, { BackgroundColor3 = panelBg } },
            { exp.TitleLabel, { TextColor3 = headerTextColor } },
            { hexLabel, { TextColor3 = hexTextColor } },
            { hexRowLabel, { TextColor3 = headerTextColor } },
            { hexBox, { BackgroundColor3 = darkBg, TextColor3 = boxTextColor } },
        }
        for _, lbl in ipairs(rgbLabels) do
            table.insert(entries, { lbl, { TextColor3 = headerTextColor } })
        end
        for _, box in ipairs({ rBox, gBox, bBox }) do
            table.insert(entries, { box, { BackgroundColor3 = darkBg, TextColor3 = boxTextColor } })
        end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- ThemeGrid (grid of preset color/accent swatches) ----------
function Components.ThemeGrid(parent, theme, connMgr, opts)
    local presets = opts.Presets or {}

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.LayoutOrder = opts.LayoutOrder or 0
    container.BackgroundTransparency = 1
    container.Parent = parent
    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 44, 0, 44)
    grid.CellPadding = UDim2.new(0, 14, 0, 14)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = container

    local swatches = {}
    local selectedIndex = opts.DefaultIndex or 1

    local function selectIndex(index)
        selectedIndex = index
        for i, s in ipairs(swatches) do
            local isSel = (i == index)
            TweenService:Create(s.stroke, TweenInfo.new(0.25, EASE, EASE_OUT), { Transparency = isSel and 0 or 1 }):Play()
            TweenService:Create(s.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
        end
    end

    for index, preset in ipairs(presets) do
        local color, accent = preset[1], preset[2]
        local previewColor = Utils.Brighten(color, 1.7)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.BackgroundColor3 = previewColor
        btn.Text = ""
        btn.Parent = container
        Utils.AddCorner(btn, UDim.new(1, 0))

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = (index == selectedIndex) and 0 or 1
        stroke.Parent = btn

        local check = Instance.new("TextLabel")
        check.Size = UDim2.new(1, 0, 1, 0)
        check.BackgroundTransparency = 1
        check.Text = "✓"
        check.TextColor3 = Color3.fromRGB(255, 255, 255)
        check.Font = Enum.Font.BuilderSansBold
        check.TextSize = 20
        check.TextTransparency = (index == selectedIndex) and 0 or 1
        check.ZIndex = 2
        check.Parent = btn

        table.insert(swatches, { check = check, stroke = stroke })

        Animator.AddThickenStroke(btn, connMgr)
        connMgr:Track(btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(previewColor, 1.15) }):Play()
        end))
        connMgr:Track(btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = previewColor }):Play()
        end))
        connMgr:Track(btn.MouseButton1Click:Connect(function()
            theme:Apply(color, accent)
            selectIndex(index)
            if opts.Callback then opts.Callback(color, accent) end
        end))
    end

    local self = { Instance = container }
    -- Swatches always show their own fixed preset colors — this only keeps
    -- the selection ring in sync when the theme changes from somewhere
    -- OTHER than clicking a swatch in this grid (e.g. a second ThemeGrid,
    -- or a direct theme:Apply() call elsewhere), so the ring doesn't point
    -- at a stale preset.
    function self:ApplyTheme(color, accent)
        for i, preset in ipairs(presets) do
            if preset[1] == color and preset[2] == accent then
                if i ~= selectedIndex then selectIndex(i) end
                return
            end
        end
    end
    theme:Subscribe(function(c, a) self:ApplyTheme(c, a) end)
    return self
end

-- ---------- GradientPicker (toggle + preset gradient grid) ----------
function Components.GradientPicker(parent, theme, connMgr, opts)
    local gradients = opts.TargetGradients or {} -- list of UIGradient objects to drive
    local presets = opts.Presets or {}

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, 0, 0, 40)
    toggleFrame.LayoutOrder = opts.LayoutOrder or 0
    toggleFrame.Parent = parent
    Utils.AddCorner(toggleFrame, UDim.new(0, 8))

    local toggleLabel = Instance.new("TextLabel")
    toggleLabel.Size = UDim2.new(1, -85, 1, 0)
    toggleLabel.Position = UDim2.new(0, 10, 0, 0)
    toggleLabel.BackgroundTransparency = 1
    toggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleLabel.TextXAlignment = Enum.TextXAlignment.Left
    toggleLabel.Font = Enum.Font.BuilderSansBold
    toggleLabel.TextSize = 16
    toggleLabel.Parent = toggleFrame

    local track = Instance.new("TextButton")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -15, 0.5, 0)
    track.Size = UDim2.new(0, 52, 0, 28)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = toggleFrame
    Utils.AddCorner(track, UDim.new(1, 0))
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 3, 0.5, 0)
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Utils.AddCorner(knob, UDim.new(1, 0))

    local gridContainer = Instance.new("Frame")
    gridContainer.Size = UDim2.new(1, 0, 0, 0)
    gridContainer.AutomaticSize = Enum.AutomaticSize.Y
    gridContainer.LayoutOrder = (opts.LayoutOrder or 0) + 1
    gridContainer.BackgroundTransparency = 1
    gridContainer.Parent = parent
    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 44, 0, 44)
    grid.CellPadding = UDim2.new(0, 14, 0, 14)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = gridContainer

    local GRADIENT_BRIGHTEN = 1.35
    local enabled = false
    local selectedIndex = nil
    local swatches = {}

    local function pushGradientColors(instant)
        local c1, c2
        if selectedIndex then
            c1, c2 = presets[selectedIndex][1], presets[selectedIndex][2]
        else
            c1, c2 = theme.Color, theme.Accent
        end
        local b1, b2 = Utils.Brighten(c1, GRADIENT_BRIGHTEN), Utils.Brighten(c2, GRADIENT_BRIGHTEN)
        for _, entry in ipairs(gradients) do
            local grad, tint = entry.Gradient, entry.Tint or 1
            local sc = ColorSequence.new(Utils.Darken(b1, tint), Utils.Darken(b2, tint))
            Animator.TweenGradientColor(grad, sc, 0.35, connMgr, instant)
        end
    end

    local function setEnabled(v)
        enabled = v
        toggleLabel.Text = (opts.Text or "Chế độ Gradient") .. ": " .. (enabled and "Bật" or "Tắt")
        local darkBg = Utils.Darken(theme.Color, 0.8)
        local trackColor = enabled and Utils.Brighten(theme.Accent, 1.15) or darkBg
        -- Same near-white-but-tinted knob treatment as Components.Toggle —
        -- always reads as white, still tinted lightly by the live accent.
        local knobColor = Utils.GetKnobColor(theme.Accent)
        local knobX = enabled and (52 - 22 - 3) or 3
        TweenService:Create(track, TweenInfo.new(0.3, EASE, EASE_OUT), { BackgroundColor3 = trackColor }):Play()
        TweenService:Create(knob, TweenInfo.new(0.3, EASE, EASE_OUT), { Position = UDim2.new(0, knobX, 0.5, 0), BackgroundColor3 = knobColor }):Play()
        for _, entry in ipairs(gradients) do entry.Gradient.Enabled = enabled end
        if enabled then pushGradientColors(true) end
    end

    connMgr:Track(track.MouseButton1Click:Connect(function() setEnabled(not enabled) end))

    local function selectPreset(index)
        selectedIndex = index
        for i, s in ipairs(swatches) do
            local isSel = (i == index)
            TweenService:Create(s.stroke, TweenInfo.new(0.25, EASE, EASE_OUT), { Transparency = isSel and 0 or 1 }):Play()
            TweenService:Create(s.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
        end
        if enabled then pushGradientColors(false) end
    end

    for index, preset in ipairs(presets) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.BackgroundColor3 = preset[1]
        btn.Text = ""
        btn.Parent = gridContainer
        Utils.AddCorner(btn, UDim.new(0, 10))

        local swatchGrad = Instance.new("UIGradient")
        swatchGrad.Color = ColorSequence.new(preset[1], preset[2])
        swatchGrad.Rotation = 45
        swatchGrad.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 1
        stroke.Parent = btn

        local check = Instance.new("TextLabel")
        check.Size = UDim2.new(1, 0, 1, 0)
        check.BackgroundTransparency = 1
        check.Text = "✓"
        check.TextColor3 = Color3.fromRGB(255, 255, 255)
        check.Font = Enum.Font.BuilderSansBold
        check.TextSize = 20
        check.TextTransparency = 1
        check.ZIndex = 2
        check.Parent = btn

        table.insert(swatches, { check = check, stroke = stroke })
        Animator.AddThickenStroke(btn, connMgr)
        connMgr:Track(btn.MouseButton1Click:Connect(function()
            selectPreset(index)
            if not enabled then setEnabled(true) end
        end))
    end

    setEnabled(false)

    local self = { Instance = toggleFrame, GridInstance = gridContainer }
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        -- Retint the track in both states now — previously this only fired
        -- when `enabled` was false, so picking a new theme while gradient
        -- mode was ON left the toggle showing the *old* accent color.
        local trackColor = enabled and Utils.Brighten(accent, 1.15) or Utils.Darken(color, 0.8)
        local knobColor = Utils.GetKnobColor(accent)
        Animator.ApplyTheme(isInitial, {
            { toggleFrame, { BackgroundColor3 = panelBg } },
            { toggleLabel, { TextColor3 = textColor } },
            { track, { BackgroundColor3 = trackColor } },
            { knob, { BackgroundColor3 = knobColor } },
        })
        if enabled and not selectedIndex then
            pushGradientColors(isInitial)
        end
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Keybind ----------
-- opts: {
--   Text (label), Default (Enum.KeyCode or nil), EmptyText (shown when
--   unbound), Flag (for SaveConfig/LoadConfig), Callback(keyCode) — fires
--   when the user finishes (re)binding a key, Pressed() — fires whenever
--   the currently-bound key is pressed while NOT rebinding.
-- }
--
-- Click the key button to enter "listening" mode (button shows "..." and
-- turns accent-colored); the next keyboard key pressed becomes the new
-- bind (Escape cancels without changing anything). Only one Keybind per
-- window may listen at a time — see keybindListening above — so rebinding
-- one Keybind can't accidentally trigger another Keybind's Pressed() for
-- the same keystroke.
function Components.Keybind(parent, theme, connMgr, opts)
    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -110, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Text or "Phím tắt"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.BuilderSansBold
    label.TextSize = 16
    label.Parent = frame

    local keyBtn = Instance.new("TextButton")
    keyBtn.AnchorPoint = Vector2.new(1, 0.5)
    keyBtn.Position = UDim2.new(1, -10, 0.5, 0)
    keyBtn.Size = UDim2.new(0, 90, 0, 28)
    keyBtn.AutoButtonColor = false
    keyBtn.Font = Enum.Font.BuilderSansBold
    keyBtn.TextSize = 13
    keyBtn.TextTruncate = Enum.TextTruncate.AtEnd
    keyBtn.Parent = frame
    Utils.AddCorner(keyBtn, UDim.new(0, 6))
    Animator.AddThickenStroke(keyBtn, connMgr)

    local currentKey = opts.Default
    local listening = false

    local function keyText()
        if listening then return "..." end
        if currentKey then return currentKey.Name end
        return opts.EmptyText or "Chưa đặt"
    end
    keyBtn.Text = keyText()

    local function restyleKeyBtn(instant)
        local darkBg = Utils.Darken(theme.Color, 0.8)
        local bg = listening and theme.Accent or darkBg
        local info = TweenInfo.new(instant and 0 or 0.2, EASE, EASE_OUT)
        TweenService:Create(keyBtn, info, {
            BackgroundColor3 = bg,
            TextColor3 = Utils.GetTextColorFor(bg, theme.Accent),
        }):Play()
    end

    local function setListening(v)
        listening = v
        keyBtn.Text = keyText()
        restyleKeyBtn(false)
        if v then
            keybindListening[connMgr] = true
        else
            -- Deferred instead of synchronous: other Keybinds on this same
            -- window may still be mid-way through handling the SAME
            -- InputBegan event (their connections fire after this one in
            -- the same dispatch). Clearing the flag synchronously here let
            -- them see it as already-cleared and wrongly fire their own
            -- Pressed() for the key that just finished a rebind. task.defer
            -- pushes the clear to after this input event has fully
            -- propagated to every connection.
            task.defer(function()
                if not listening then -- guard against being re-triggered before this runs
                    keybindListening[connMgr] = nil
                end
            end)
        end
    end

    connMgr:Track(keyBtn.MouseButton1Click:Connect(function()
        -- Don't start listening if some OTHER Keybind on this window is
        -- already mid-rebind — avoids two controls racing to capture the
        -- same next keystroke.
        if not listening and not keybindListening[connMgr] then
            setListening(true)
        end
    end))

    -- Single InputBegan handler covers both roles: capturing a new key
    -- while listening, and firing Pressed() for the already-bound key
    -- during normal use — avoids registering two overlapping InputBegan
    -- connections per Keybind.
    connMgr:Track(UserInputService.InputBegan:Connect(function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if listening then
            if input.KeyCode == Enum.KeyCode.Escape then
                setListening(false)
                return
            end
            currentKey = input.KeyCode
            setListening(false)
            if opts.Callback then opts.Callback(currentKey) end
            return
        end

        -- While ANY Keybind on this window is mid-rebind, every other
        -- Keybind suppresses its own Pressed() — the key being typed right
        -- now is meant to set a new bind elsewhere, not to "use" this one.
        if not processed and currentKey and input.KeyCode == currentKey
            and not keybindListening[connMgr] then
            if opts.Pressed then opts.Pressed() end
        end
    end))

    local self = { Instance = frame }
    -- Returns the key's Name (string) rather than the EnumItem, so it
    -- round-trips through SaveConfig/LoadConfig's JSON encoding (which
    -- only special-cases Color3) with no extra handling needed.
    function self:Get() return currentKey and currentKey.Name or nil end
    -- Programmatically bind a key by name (used by Window:LoadConfig).
    -- Silently ignores names that aren't valid Enum.KeyCode members. Also
    -- fires opts.Callback so a config-loaded bind actually reaches
    -- consumer code — previously LoadConfig would only repaint the button
    -- text and the game logic behind the keybind was never rewired.
    function self:Set(name)
        if type(name) ~= "string" then return end
        local key = Enum.KeyCode[name]
        if not key then return end
        currentKey = key
        keyBtn.Text = keyText()
        if opts.Callback then opts.Callback(currentKey) end
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { label, { TextColor3 = textColor } },
        })
        restyleKeyBtn(isInitial)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Accordion ----------
-- Section xổ/thu dùng lại ExpandableHeader, nhưng thay vì fixed BodyHeight
-- thì tự đo chiều cao nội dung bên trong qua UIListLayout.AbsoluteContentSize
-- mỗi khi có control mới được thêm, rồi gọi exp.SetBodyHeight để cập nhật.
local AccordionMeta = {}
AccordionMeta.__index = AccordionMeta

function Components.Accordion(parent, theme, connMgr, opts)
    local exp = Components.ExpandableHeader(parent, theme, connMgr, {
        Text = opts.Text or "Nhóm",
        LayoutOrder = opts.LayoutOrder,
        BodyHeight = 0,
    })

    local body = exp.Body
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = body
    Utils.AddPadding(body, UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 4), UDim.new(0, 10))

    local function recompute()
        exp.SetBodyHeight(layout.AbsoluteContentSize.Y + 14)
    end
    connMgr:Track(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(recompute))

    -- FIX: previously this priming block only ran when opts.DefaultOpen
    -- was true, so an accordion created with DefaultOpen = false (the
    -- common case) never had its real content height measured until the
    -- user manually opened it for the first time. At that point
    -- exp.SetOpen(true) would tween to the *stale* default openHeight
    -- (BodyHeight=0 -> closedHeight+6px) and only snap to the correct,
    -- much taller size once AbsoluteContentSize's changed-signal fired a
    -- frame later — visible as the body "jumping"/overlapping whatever
    -- sits below the header. Now the height is always primed up front,
    -- regardless of DefaultOpen, so the very first open already animates
    -- to the correct size.
    task.defer(function()
        RunService.Heartbeat:Wait()
        recompute()
        if opts.DefaultOpen then
            exp.SetOpen(true)
        end
    end)

    local self = setmetatable({ Instance = exp.Container }, AccordionMeta)
    self._body, self._theme, self._connMgr, self._order = body, theme, connMgr, 0

    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, headerTextColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { exp.Header, { BackgroundColor3 = panelBg } },
            { exp.TitleLabel, { TextColor3 = headerTextColor } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- Sinh AccordionMeta:CreateToggle/Slider/... bằng bảng ánh xạ thay vì chép
-- tay 12 hàm gần giống hệt TabMeta — cùng tinh thần "gom logic lặp lại"
-- như ExpandableHeader đã làm cho Dropdown/MultiDropdown/ColorPicker.
local ACCORDION_FACTORY_MAP = {
    CreateLabel = { fn = "Label" },
    CreateButton = { fn = "Button" },
    CreateToggle = { fn = "Toggle", flag = true },
    CreateSlider = { fn = "Slider", flag = true },
    CreateNumberStepper = { fn = "NumberStepper", flag = true },
    CreateTextbox = { fn = "Textbox", flag = true },
    CreateDropdown = { fn = "Dropdown", flag = true },
    CreateMultiDropdown = { fn = "MultiDropdown", flag = true },
    CreateRadioGroup = { fn = "RadioGroup", flag = true },
    CreateColorPicker = { fn = "ColorPicker", flag = true },
    CreateKeybind = { fn = "Keybind", flag = true },
    CreateDivider = { fn = "Divider" },
}
for methodName, info in pairs(ACCORDION_FACTORY_MAP) do
    AccordionMeta[methodName] = function(self, opts)
        opts = opts or {}
        self._order = self._order + 1
        opts.LayoutOrder = self._order
        local obj = Components[info.fn](self._body, self._theme, self._connMgr, opts)
        if info.flag and self._window then self._window:_registerFlag(opts.Flag, obj) end
        -- Register with the owning tab's search index, same as top-level
        -- TabMeta:CreateXxx controls, so CreateSearchBar's filter also
        -- reaches controls nested inside an accordion — previously these
        -- were invisible to search entirely.
        if obj and obj.Instance and self._tab then
            local searchText = opts.Text or opts.Title or ""
            obj.Instance:SetAttribute("SelenixSearchText", tostring(searchText):lower())
            self._tab._searchEntries = self._tab._searchEntries or {}
            table.insert(self._tab._searchEntries, obj.Instance)
        end
        return obj
    end
end

-- ---------- TableList ----------
-- Danh sách cuộn được, mỗi dòng có Text/SubText + checkbox riêng (vd: bật
-- ??? cho từng player). opts.Items = { { Text, SubText, Toggled, OnToggle(state), OnClick } }.
-- :Refresh(newItems) rebuild toàn bộ (khi player join/leave), dùng lại
-- pattern rowConnMgr như Dropdown/MultiDropdown để không leak connection.
function Components.TableList(parent, theme, connMgr, opts)
    local items = opts.Items or {}
    local rowHeight = opts.RowHeight or 34
    local maxVisible = opts.MaxVisibleRows or 5
    local hasHeader = opts.Text and opts.Text ~= ""
    local headerHeight = hasHeader and 30 or 0
    local rowConnMgr = ConnectionManager.new()

    local container = Instance.new("Frame")
    container.LayoutOrder = opts.LayoutOrder or 0
    container.Parent = parent
    Utils.AddCorner(container, UDim.new(0, 8))

    local headerLabel
    if hasHeader then
        headerLabel = Instance.new("TextLabel")
        headerLabel.Size = UDim2.new(1, -20, 0, headerHeight)
        headerLabel.Position = UDim2.new(0, 10, 0, 4)
        headerLabel.BackgroundTransparency = 1
        headerLabel.Text = opts.Text
        headerLabel.TextXAlignment = Enum.TextXAlignment.Left
        headerLabel.Font = Enum.Font.BuilderSansBold
        headerLabel.TextSize = 14
        headerLabel.Parent = container
    end

    local scroller = Instance.new("ScrollingFrame")
    scroller.Position = UDim2.new(0, 6, 0, headerHeight + 4)
    scroller.BackgroundTransparency = 1
    scroller.BorderSizePixel = 0
    scroller.ScrollBarThickness = 4
    scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroller.Parent = container
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 4)
    listLayout.Parent = scroller

    local emptyLabel = Instance.new("TextLabel")
    emptyLabel.Size = UDim2.new(1, 0, 0, rowHeight)
    emptyLabel.BackgroundTransparency = 1
    emptyLabel.Text = opts.EmptyText or "Không có mục nào"
    emptyLabel.TextXAlignment = Enum.TextXAlignment.Left
    emptyLabel.Font = Enum.Font.BuilderSans
    emptyLabel.TextSize = 13
    emptyLabel.Parent = scroller
    Utils.AddPadding(emptyLabel, UDim.new(0, 8))

    local rows = {}
    local function updateContainerHeight()
        local scrollH = math.max(math.min(#items, maxVisible), 1) * (rowHeight + 4)
        scroller.Size = UDim2.new(1, -12, 0, scrollH)
        container.Size = UDim2.new(1, 0, 0, headerHeight + scrollH + 10)
    end

    local function rebuild()
        rowConnMgr:DisconnectAll()
        for _, row in ipairs(rows) do row.holder:Destroy() end
        table.clear(rows)
        emptyLabel.Visible = (#items == 0)

        for i, item in ipairs(items) do
            local holder = Instance.new("TextButton")
            holder.Size = UDim2.new(1, 0, 0, rowHeight)
            holder.LayoutOrder = i
            holder.Text = ""
            holder.AutoButtonColor = false
            holder.Parent = scroller
            Utils.AddCorner(holder, UDim.new(0, 6))
            Animator.AddThickenStroke(holder, rowConnMgr)

            local hasToggle = item.OnToggle ~= nil
            local toggled = item.Toggled and true or false
            local check, mark

            if hasToggle then
                check = Instance.new("Frame")
                check.AnchorPoint = Vector2.new(0, 0.5)
                check.Position = UDim2.new(0, 8, 0.5, 0)
                check.Size = UDim2.new(0, 18, 0, 18)
                check.Parent = holder
                Utils.AddCorner(check, UDim.new(0, 4))
                -- FIX: this used to be `local mark = Instance.new(...)`,
                -- which shadowed the OUTER `mark` declared above (in
                -- `local check, mark`) with a brand-new block-scoped
                -- variable. The outer `mark` stayed nil forever, so the
                -- MouseButton1Click handler below's
                -- `TweenService:Create(mark, ...)` threw on every click —
                -- which meant the subsequent `item.OnToggle(toggled)` call
                -- never ran. Assigning to the outer `mark` (no `local`)
                -- fixes both the error and the dead callback.
                mark = Instance.new("TextLabel")
                mark.Size = UDim2.new(1, 0, 1, 0)
                mark.BackgroundTransparency = 1
                mark.Text = "✓"
                mark.TextColor3 = Color3.fromRGB(255, 255, 255)
                mark.Font = Enum.Font.BuilderSansBold
                mark.TextSize = 13
                mark.TextTransparency = toggled and 0 or 1
                mark.Parent = check
            end

            local textLabel = Instance.new("TextLabel")
            textLabel.Position = UDim2.new(0, hasToggle and 36 or 10, 0, 0)
            textLabel.Size = UDim2.new(1, hasToggle and -130 or -104, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = item.Text or ""
            textLabel.TextXAlignment = Enum.TextXAlignment.Left
            textLabel.Font = Enum.Font.BuilderSans
            textLabel.TextSize = 14
            textLabel.TextTruncate = Enum.TextTruncate.AtEnd
            textLabel.Parent = holder

            local subLabel
            if item.SubText then
                subLabel = Instance.new("TextLabel")
                subLabel.AnchorPoint = Vector2.new(1, 0.5)
                subLabel.Position = UDim2.new(1, -10, 0.5, 0)
                subLabel.Size = UDim2.new(0, 80, 1, 0)
                subLabel.BackgroundTransparency = 1
                subLabel.Text = item.SubText
                subLabel.TextXAlignment = Enum.TextXAlignment.Right
                subLabel.Font = Enum.Font.BuilderSans
                subLabel.TextSize = 13
                subLabel.Parent = holder
            end

            if hasToggle then
                rowConnMgr:Track(holder.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    rows[i].toggled = toggled
                    TweenService:Create(mark, TweenInfo.new(0.2, EASE, EASE_OUT), { TextTransparency = toggled and 0 or 1 }):Play()
                    TweenService:Create(check, TweenInfo.new(0.2, EASE, EASE_OUT), {
                        BackgroundColor3 = toggled and theme.Accent or Utils.Darken(theme.Color, 0.75)
                    }):Play()
                    item.OnToggle(toggled)
                end))
            elseif item.OnClick then
                rowConnMgr:Track(holder.MouseButton1Click:Connect(function() item.OnClick() end))
            end

            table.insert(rows, { holder = holder, check = check, mark = mark, textLabel = textLabel, subLabel = subLabel, toggled = toggled })
        end
        updateContainerHeight()
    end
    rebuild()

    local self = { Instance = container }
    -- Rebuilds the row list from a new Items array (e.g. player join/leave).
    function self:Refresh(newItems)
        items = newItems or {}
        rebuild()
    end
    function self:Destroy() rowConnMgr:DisconnectAll() end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        local darkBg = Utils.Darken(color, 0.75)
        local rowBg = Utils.Darken(color, 0.85)
        local subColor = Utils.GetTextColorFor(rowBg, accent)
        local entries = {
            { container, { BackgroundColor3 = panelBg } },
            { emptyLabel, { TextColor3 = subColor } },
        }
        if headerLabel then table.insert(entries, { headerLabel, { TextColor3 = textColor } }) end
        for _, row in ipairs(rows) do
            table.insert(entries, { row.holder, { BackgroundColor3 = rowBg } })
            table.insert(entries, { row.textLabel, { TextColor3 = textColor } })
            if row.subLabel then table.insert(entries, { row.subLabel, { TextColor3 = subColor } }) end
            if row.check then
                table.insert(entries, { row.check, { BackgroundColor3 = row.toggled and accent or darkBg } })
            end
        end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end


-- ---------- ProgressBar ----------
-- Thanh tiến trình CHỈ ĐỌC (khác Slider — không kéo được), dùng cho loading
-- task, thanh XP, cooldown hiển thị, v.v. Điều khiển bằng obj:Set(v).
--
-- opts: { Text, Min (0), Max (100), Default (Min), ShowLabel (true),
--         Suffix (nil -> hiện %, hoặc vd " coins" để hiện số thô), Flag }
function Components.ProgressBar(parent, theme, connMgr, opts)
    local min, max, range = Utils.ClampRange(opts.Min or 0, opts.Max or 100)
    local value = math.clamp(opts.Default or min, min, max)
    local showLabel = opts.ShowLabel ~= false

    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, showLabel and 40 or 14)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label
    if showLabel then
        label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -20, 0, 20)
        label.Position = UDim2.new(0, 10, 0, 4)
        label.BackgroundTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.BuilderSansBold
        label.TextSize = 14
        label.Parent = frame
    end

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 8)
    track.Position = UDim2.new(0, 10, 0, showLabel and 28 or 4)
    track.BorderSizePixel = 0
    track.Parent = frame
    Utils.AddCorner(track, UDim.new(1, 0))

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((value - min) / range, 0, 1, 0)
    fill.BorderSizePixel = 0
    fill.Parent = track
    Utils.AddCorner(fill, UDim.new(1, 0))

    local function labelText()
        if opts.Suffix then
            return (opts.Text or "Tiến trình") .. ": " .. tostring(value) .. opts.Suffix
        end
        local pct = math.floor(((value - min) / range) * 100 + 0.5)
        return (opts.Text or "Tiến trình") .. ": " .. pct .. "%"
    end
    if label then label.Text = labelText() end

    local self = { Instance = frame }
    function self:Get() return value end
    -- instant (optional bool): skip the fill tween, e.g. for the very
    -- first paint or a hard reset.
    function self:Set(v, instant)
        v = math.clamp(v, min, max)
        value = v
        if label then label.Text = labelText() end
        local alpha = (value - min) / range
        local info = TweenInfo.new(instant and 0 or 0.25, EASE, EASE_OUT)
        TweenService:Create(fill, info, { Size = UDim2.new(alpha, 0, 1, 0) }):Play()
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, textColor = Utils.PanelColors(color, accent)
        local entries = {
            { frame, { BackgroundColor3 = panelBg } },
            { track, { BackgroundColor3 = darkBg } },
            { fill, { BackgroundColor3 = accent } },
        }
        if label then table.insert(entries, { label, { TextColor3 = textColor } }) end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Tooltip ----------
-- Gắn thêm lên MỘT control đã tồn tại (không tạo dòng mới trong tab).
-- Desktop: hiện khi MouseEnter/MouseLeave. Android/touch (môi trường
-- chính của Khôi): hiện sau khi giữ (long-press) target quá `Delay` giây,
-- ẩn ngay khi nhả tay — dùng token đếm giống pattern debounce của
-- Components.Keybind/Notification để tránh hiện tooltip trễ sau khi đã
-- nhả tay (vuốt lướt qua nhanh sẽ không kích hoạt).
--
-- target PHẢI là GuiButton (hoặc Frame có Active=true) để nhận
-- MouseEnter/InputBegan/InputEnded.
--
-- opts: { Text, Delay (0.45s), Position ("top"|"bottom", default "top") }
function Components.Tooltip(target, theme, connMgr, opts)
    opts = opts or {}
    local delay = opts.Delay or 0.45
    local above = (opts.Position ~= "bottom")

    local bubble = Instance.new("TextLabel")
    bubble.AnchorPoint = above and Vector2.new(0.5, 1) or Vector2.new(0.5, 0)
    bubble.Position = above and UDim2.new(0.5, 0, 0, -8) or UDim2.new(0.5, 0, 1, 8)
    bubble.Size = UDim2.new(0, 0, 0, 26)
    bubble.AutomaticSize = Enum.AutomaticSize.X
    bubble.Text = opts.Text or ""
    bubble.Font = Enum.Font.BuilderSans
    bubble.TextSize = 12
    bubble.TextColor3 = Color3.fromRGB(255, 255, 255)
    bubble.BackgroundTransparency = 1
    bubble.TextTransparency = 1
    bubble.ZIndex = 50
    bubble.Visible = false
    bubble.Parent = target
    Utils.AddCorner(bubble, UDim.new(0, 6))
    Utils.AddPadding(bubble, UDim.new(0, 8), UDim.new(0, 8))

    local stroke = Instance.new("UIStroke")
    stroke.Transparency = 1
    stroke.Thickness = 1
    stroke.Parent = bubble

    local shown = false
    local token = 0

    local function fadeTo(visible)
        shown = visible
        if visible then bubble.Visible = true end
        local info = TweenInfo.new(0.18, EASE, EASE_OUT)
        TweenService:Create(bubble, info, {
            TextTransparency = visible and 0 or 1,
            BackgroundTransparency = visible and 0.05 or 1,
        }):Play()
        TweenService:Create(stroke, info, { Transparency = visible and 0.6 or 1 }):Play()
        if not visible then
            task.delay(0.2, function() if not shown then bubble.Visible = false end end)
        end
    end

    connMgr:Track(target.MouseEnter:Connect(function() fadeTo(true) end))
    connMgr:Track(target.MouseLeave:Connect(function() fadeTo(false) end))

    connMgr:Track(target.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch then return end
        token = token + 1
        local myToken = token
        task.delay(delay, function()
            if myToken == token then fadeTo(true) end
        end)
    end))
    connMgr:Track(target.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch then return end
        token = token + 1 -- invalidates any pending show from InputBegan above
        if shown then fadeTo(false) end
    end))

    local self = { Instance = bubble }
    function self:SetText(text) bubble.Text = text end
    function self:ApplyTheme(color, accent, isInitial)
        local bg = Utils.Darken(color, 0.6)
        local border = Utils.Brighten(color, 1.6)
        Animator.ApplyTheme(isInitial, {
            { bubble, { BackgroundColor3 = bg } },
            { stroke, { Color = border } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- SegmentedControl ----------
-- Pill ngang chọn-1 kiểu iOS, gọn hơn RadioGroup (dạng list dọc) cho
-- 2-4 lựa chọn ngắn. Highlight trượt bằng UDim2 Scale (mọi ô rộng bằng
-- nhau = 1/N) nên không cần đo AbsoluteSize/Heartbeat như các control
-- tự-đo khác trong file (Accordion, Paragraph).
--
-- opts: { Text (không hiện, chỉ để search-index bắt được), Options,
--         Default, Callback(text), Flag }
function Components.SegmentedControl(parent, theme, connMgr, opts)
    local options = opts.Options or {}
    local n = math.max(#options, 1)
    local selectedIndex = 1
    if opts.Default then
        for i, t in ipairs(options) do if t == opts.Default then selectedIndex = i; break end end
    end

    local outer = Instance.new("Frame")
    outer.Size = opts.Size or UDim2.new(1, 0, 0, 38)
    outer.LayoutOrder = opts.LayoutOrder or 0
    outer.ClipsDescendants = true
    outer.Parent = parent
    Utils.AddCorner(outer, UDim.new(0, 8))
    Utils.AddPadding(outer, UDim.new(0, 3), UDim.new(0, 3), UDim.new(0, 3), UDim.new(0, 3))

    local highlight = Instance.new("Frame")
    highlight.Size = UDim2.new(1 / n, 0, 1, 0)
    highlight.Position = UDim2.new((selectedIndex - 1) / n, 0, 0, 0)
    highlight.BorderSizePixel = 0
    highlight.ZIndex = 1
    highlight.Parent = outer
    Utils.AddCorner(highlight, UDim.new(0, 6))

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 1, 0)
    row.BackgroundTransparency = 1
    row.ZIndex = 2
    row.Parent = outer
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = row

    local buttons = {}
    local function restyle()
        for i, b in ipairs(buttons) do
            local isSel = (i == selectedIndex)
            local target = isSel
                and Utils.GetTextColorFor(theme.Accent, theme.Accent)
                or Utils.GetTextColorFor(Utils.Brighten(theme.Color, 1.2), theme.Accent)
            TweenService:Create(b, TweenInfo.new(0.2, EASE, EASE_OUT), { TextColor3 = target }):Play()
        end
        TweenService:Create(highlight, TweenInfo.new(0.25, EASE, EASE_OUT), {
            Position = UDim2.new((selectedIndex - 1) / n, 0, 0, 0)
        }):Play()
    end

    for i, text in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1 / n, 0, 1, 0)
        b.LayoutOrder = i
        b.BackgroundTransparency = 1
        b.Text = text
        b.Font = Enum.Font.BuilderSansBold
        b.TextSize = 13
        b.AutoButtonColor = false
        b.Parent = row
        connMgr:Track(b.MouseButton1Click:Connect(function()
            if i == selectedIndex then return end
            selectedIndex = i
            restyle()
            if opts.Callback then opts.Callback(text) end
        end))
        table.insert(buttons, b)
    end

    local self = { Instance = outer }
    function self:Get() return options[selectedIndex] end
    function self:Set(v)
        for i, t in ipairs(options) do
            if t == v and i ~= selectedIndex then
                selectedIndex = i
                restyle()
                if opts.Callback then opts.Callback(v) end
                return
            end
        end
    end
    function self:ApplyTheme(color, accent, isInitial)
        local outerBg = Utils.Darken(color, 0.85)
        Animator.ApplyTheme(isInitial, {
            { outer, { BackgroundColor3 = outerBg } },
            { highlight, { BackgroundColor3 = accent } },
        })
        restyle()
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- LogPanel (Console) ----------
-- Khung cuộn hiện log runtime trong UI thay vì print() ra console
-- executor (tiện khi test trên điện thoại, không có console riêng để
-- xem). obj:Log(text, level) thêm 1 dòng; vượt quá MaxLines thì dòng cũ
-- nhất bị xoá (giống pattern rowConnMgr-less trim của Notification's
-- max-visible-toasts, chỉ đơn giản hơn vì mỗi dòng không có connection
-- riêng cần disconnect).
--
-- opts: { Text (tiêu đề, optional), MaxLines (100), ShowTimestamp (true),
--         AutoScroll (true), Height (160, chiều cao vùng cuộn) }
function Components.LogPanel(parent, theme, connMgr, opts)
    local maxLines = opts.MaxLines or 100
    local showTimestamp = opts.ShowTimestamp ~= false
    local autoScroll = opts.AutoScroll ~= false
    local visibleHeight = opts.Height or 160
    local hasHeader = opts.Text and opts.Text ~= ""
    local headerHeight = hasHeader and 26 or 0

    local LEVEL_COLORS = {
        info = Color3.fromRGB(190, 190, 200),
        success = Color3.fromRGB(90, 210, 130),
        warning = Color3.fromRGB(230, 170, 50),
        error = Color3.fromRGB(230, 90, 90),
    }

    local container = Instance.new("Frame")
    container.Size = opts.Size or UDim2.new(1, 0, 0, headerHeight + visibleHeight + 10)
    container.LayoutOrder = opts.LayoutOrder or 0
    container.Parent = parent
    Utils.AddCorner(container, UDim.new(0, 8))

    local headerLabel
    if hasHeader then
        headerLabel = Instance.new("TextLabel")
        headerLabel.Size = UDim2.new(1, -20, 0, headerHeight)
        headerLabel.Position = UDim2.new(0, 10, 0, 4)
        headerLabel.BackgroundTransparency = 1
        headerLabel.Text = opts.Text
        headerLabel.TextXAlignment = Enum.TextXAlignment.Left
        headerLabel.Font = Enum.Font.BuilderSansBold
        headerLabel.TextSize = 13
        headerLabel.Parent = container
    end

    local scroller = Instance.new("ScrollingFrame")
    scroller.Position = UDim2.new(0, 6, 0, headerHeight + 4)
    scroller.Size = UDim2.new(1, -12, 0, visibleHeight)
    scroller.BorderSizePixel = 0
    scroller.ScrollBarThickness = 4
    scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroller.Parent = container
    Utils.AddCorner(scroller, UDim.new(0, 6))
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = scroller
    Utils.AddPadding(scroller, UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 4), UDim.new(0, 4))

    local lines = {}
    local self = { Instance = container }

    function self:Log(text, level)
        level = level or "info"
        local row = Instance.new("TextLabel")
        row.Size = UDim2.new(1, 0, 0, 0)
        row.AutomaticSize = Enum.AutomaticSize.Y
        row.LayoutOrder = #lines + 1
        row.BackgroundTransparency = 1
        row.TextWrapped = true
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.TextYAlignment = Enum.TextYAlignment.Top
        row.Font = Enum.Font.Code
        row.TextSize = 12
        row.TextColor3 = LEVEL_COLORS[level] or LEVEL_COLORS.info
        local prefix = showTimestamp and ("[" .. os.date("%H:%M:%S") .. "] ") or ""
        row.Text = prefix .. tostring(text)
        row.Parent = scroller

        table.insert(lines, row)
        if #lines > maxLines then
            local oldest = table.remove(lines, 1)
            oldest:Destroy()
        end

        if autoScroll then
            -- Same "wait a Heartbeat for AutomaticSize/AutomaticCanvasSize
            -- to converge" pattern used elsewhere (Notification, Paragraph)
            -- before trusting AbsoluteCanvasSize/AbsoluteWindowSize.
            task.defer(function()
                RunService.Heartbeat:Wait()
                scroller.CanvasPosition = Vector2.new(
                    0, math.max(scroller.AbsoluteCanvasSize.Y - scroller.AbsoluteWindowSize.Y, 0)
                )
            end)
        end
    end

    function self:Clear()
        for _, row in ipairs(lines) do row:Destroy() end
        table.clear(lines)
    end

    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        local darkBg = Utils.Darken(color, 0.85)
        local entries = {
            { container, { BackgroundColor3 = panelBg } },
            { scroller, { BackgroundColor3 = darkBg } },
        }
        if headerLabel then table.insert(entries, { headerLabel, { TextColor3 = textColor } }) end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

local NOTIF_TYPES = {
    success = { Color3.fromRGB(60, 200, 120), "✓" },
    error   = { Color3.fromRGB(220, 70, 70),  "×" },
    warning = { Color3.fromRGB(230, 170, 50), "!" },
    info    = { Color3.fromRGB(70, 140, 230), "i" },
}

function Components.Notification(parent, theme, connMgr, opts)
    local typeInfo = NOTIF_TYPES[opts.Type] or NOTIF_TYPES.info
    local accentColor, iconText = typeInfo[1], typeInfo[2]

    local duration = opts.Duration
    if duration == nil then duration = 4 end
    if duration == false then duration = 0 end
    local isSticky = not (duration and duration > 0)

    -- Notifications are laid out by a UIListLayout on `parent` (the toast
    -- container). UIListLayout re-applies its own computed Position to every
    -- direct child whenever it recalculates the stack (new toast added,
    -- another toast resized/removed, etc), which fights any tween that's
    -- also driving that child's Position. Fix: give each toast its own
    -- invisible "slot" that IS the direct list-managed child (reserves the
    -- correct stacking space via AutomaticSize, never has its Position
    -- tweened), and make the visible `card` a child of that slot instead of
    -- of `parent` directly.
    local slot = Instance.new("Frame")
    slot.Name = "NotificationSlot"
    slot.Size = UDim2.new(1, 0, 0, 0)
    slot.AutomaticSize = Enum.AutomaticSize.Y
    slot.LayoutOrder = opts.LayoutOrder or 0
    slot.BackgroundTransparency = 1
    slot.Parent = parent

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = Utils.Brighten(theme.Color, 1.25)
    card.BorderSizePixel = 0
    -- Left un-clipped until Dismiss() explicitly turns it on, so the nested
    -- AutomaticSize convergence (see note above) never gets caught mid-
    -- computation and visibly cropped.
    card.ClipsDescendants = false
    card.Parent = slot
    Utils.AddCorner(card, UDim.new(0, 10))

    local stroke = Instance.new("UIStroke")
    stroke.Color = Utils.Brighten(theme.Color, 1.5)
    stroke.Thickness = 1
    stroke.Parent = card

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 4, 1, 0)
    accentBar.BackgroundColor3 = accentColor
    accentBar.BorderSizePixel = 0
    accentBar.Parent = card
    Utils.AddCorner(accentBar, UDim.new(0, 2))

    local contentHolder = Instance.new("Frame")
    contentHolder.Position = UDim2.new(0, 14, 0, 14)
    contentHolder.Size = UDim2.new(1, -52, 0, 0)
    contentHolder.AutomaticSize = Enum.AutomaticSize.Y
    contentHolder.BackgroundTransparency = 1
    contentHolder.Parent = card
    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 6)
    contentLayout.Parent = contentHolder

    local headerRow = Instance.new("Frame")
    headerRow.Size = UDim2.new(1, 0, 0, 0)
    headerRow.AutomaticSize = Enum.AutomaticSize.Y
    headerRow.LayoutOrder = 1
    headerRow.BackgroundTransparency = 1
    headerRow.Parent = contentHolder
    local headerLayout = Instance.new("UIListLayout")
    headerLayout.FillDirection = Enum.FillDirection.Horizontal
    headerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    headerLayout.Padding = UDim.new(0, 12)
    headerLayout.Parent = headerRow

    local iconHolder = Instance.new("Frame")
    iconHolder.Size = UDim2.new(0, 26, 0, 26)
    iconHolder.LayoutOrder = 1
    iconHolder.BackgroundColor3 = accentColor
    iconHolder.BackgroundTransparency = 0.8
    iconHolder.BorderSizePixel = 0
    iconHolder.Parent = headerRow
    Utils.AddCorner(iconHolder, UDim.new(1, 0))

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(1, 0, 1, 0)
    icon.BackgroundTransparency = 1
    icon.Text = iconText
    icon.TextColor3 = accentColor
    icon.Font = Enum.Font.BuilderSansBold
    icon.TextSize = 14
    icon.Parent = iconHolder

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -38, 0, 0)
    titleLabel.AutomaticSize = Enum.AutomaticSize.Y
    titleLabel.LayoutOrder = 2
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = opts.Title or "Thông báo"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextYAlignment = Enum.TextYAlignment.Top
    titleLabel.TextWrapped = true
    titleLabel.Font = Enum.Font.BuilderSansBold
    titleLabel.TextSize = 15
    titleLabel.Parent = headerRow

    -- Body text is padded left by icon-width + row padding (26 + 12 = 38)
    -- so it lines up under the title instead of under the icon.
    local bodyLabel = Instance.new("TextLabel")
    bodyLabel.Size = UDim2.new(1, 0, 0, 0)
    bodyLabel.AutomaticSize = Enum.AutomaticSize.Y
    bodyLabel.LayoutOrder = 2
    bodyLabel.BackgroundTransparency = 1
    bodyLabel.Text = opts.Text or ""
    bodyLabel.TextColor3 = Color3.fromRGB(195, 195, 205)
    bodyLabel.TextXAlignment = Enum.TextXAlignment.Left
    bodyLabel.TextYAlignment = Enum.TextYAlignment.Top
    bodyLabel.TextWrapped = true
    bodyLabel.Font = Enum.Font.BuilderSans
    bodyLabel.TextSize = 13
    bodyLabel.Parent = contentHolder
    Utils.AddPadding(bodyLabel, UDim.new(0, 38))

    -- Optional inline action button (opts.Button = { Text, Callback, KeepOpen }).
    -- Created here (for layout order) but its click connection is wired up
    -- below once `self` / Dismiss() exist.
    local actionBtn
    if opts.Button then
        actionBtn = Instance.new("TextButton")
        actionBtn.Size = UDim2.new(0, 0, 0, 30)
        actionBtn.AutomaticSize = Enum.AutomaticSize.X
        actionBtn.LayoutOrder = 3
        actionBtn.BackgroundColor3 = accentColor
        actionBtn.Text = opts.Button.Text or "OK"
        actionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        actionBtn.Font = Enum.Font.BuilderSansBold
        actionBtn.TextSize = 13
        actionBtn.AutoButtonColor = false
        actionBtn.Parent = contentHolder
        Utils.AddCorner(actionBtn, UDim.new(0, 6))
        Utils.AddPadding(actionBtn, UDim.new(0, 14))
        Animator.AddThickenStroke(actionBtn, connMgr)
        connMgr:Track(actionBtn.MouseEnter:Connect(function()
            TweenService:Create(actionBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(accentColor, 1.2) }):Play()
        end))
        connMgr:Track(actionBtn.MouseLeave:Connect(function()
            TweenService:Create(actionBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = accentColor }):Play()
        end))
    end

    local closeBtn = Instance.new("TextButton")
    closeBtn.AnchorPoint = Vector2.new(1, 0)
    closeBtn.Position = UDim2.new(1, -10, 0, 10)
    closeBtn.Size = UDim2.new(0, 22, 0, 22)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    closeBtn.Font = Enum.Font.BuilderSansBold
    closeBtn.TextSize = 13
    closeBtn.ZIndex = 2
    closeBtn.Parent = card

    -- Numeric countdown label replacing the old progress bar. Sits just to
    -- the left of the × button. Only created for non-sticky notifications;
    -- driven directly (no Tween) by the Heartbeat countdown below, so it's
    -- always exactly in sync with the actual time remaining.
    local timerLabel
    if not isSticky then
        timerLabel = Instance.new("TextLabel")
        timerLabel.AnchorPoint = Vector2.new(1, 0)
        timerLabel.Position = UDim2.new(1, -38, 0, 10)
        timerLabel.Size = UDim2.new(0, 24, 0, 22)
        timerLabel.BackgroundTransparency = 1
        timerLabel.Text = tostring(math.ceil(duration))
        timerLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
        timerLabel.TextXAlignment = Enum.TextXAlignment.Right
        timerLabel.Font = Enum.Font.BuilderSansBold
        timerLabel.TextSize = 12
        timerLabel.ZIndex = 2
        timerLabel.Parent = card
    end

    local bottomSpacer = Instance.new("Frame")
    bottomSpacer.Size = UDim2.new(1, 0, 0, 16)
    bottomSpacer.LayoutOrder = 4
    bottomSpacer.BackgroundTransparency = 1
    bottomSpacer.Parent = contentHolder

    connMgr:Track(closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
    end))
    connMgr:Track(closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { TextColor3 = Color3.fromRGB(180, 180, 190) }):Play()
    end))

    -- Whole-card scale for a springy pop on entrance/exit (Size itself is
    -- driven by AutomaticSize, so scale is layered on top via UIScale instead
    -- of tweening Size directly).
    local cardScale = Instance.new("UIScale")
    cardScale.Scale = 0.9
    cardScale.Parent = card

    local iconScale = Instance.new("UIScale")
    iconScale.Scale = 0
    iconScale.Parent = iconHolder

    local baseCardColor = Utils.Brighten(theme.Color, 1.25)
    local baseStrokeColor = Utils.Brighten(theme.Color, 1.5)
    local dismissed = false
    local remainingTime = duration
    local countdownConn = nil
    local self = { Instance = slot }

    card.Active = true -- lets a plain Frame receive MouseEnter/MouseLeave for hover-to-pause

    local function stopCountdown()
        if countdownConn then
            countdownConn:Disconnect()
            countdownConn = nil
        end
    end

    -- Single Heartbeat connection drives both the visible timer label and
    -- the actual auto-dismiss off the same `remainingTime` clock, so the
    -- displayed number reaching 0 and the dismiss firing can never drift
    -- apart or get stuck mid-way.
    local function startCountdown()
        if isSticky or dismissed then return end
        stopCountdown()
        local startClock = os.clock()
        local startRemaining = remainingTime
        countdownConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startClock
            remainingTime = math.max(startRemaining - elapsed, 0)
            if timerLabel then
                timerLabel.Text = tostring(math.ceil(remainingTime))
            end
            if remainingTime <= 0 then
                stopCountdown()
                self:Dismiss()
            end
        end)
        connMgr:Track(countdownConn)
    end

    function self:Dismiss()
        if dismissed then return end
        dismissed = true
        stopCountdown()

        -- Now that the entrance/hover phase is fully done, clip again for
        -- the exit — this hides the slide-out overshoot and the height
        -- collapse in step 2 from spilling outside the card's rounded corners.
        card.ClipsDescendants = true

        -- Step 1: slide the whole card UP and fade it out, so the exit
        -- reads as the toast lifting off the stack (matches the vertical
        -- top-to-bottom layout the toast container uses, instead of the
        -- old horizontal swipe-right). `card` lives inside `slot` (not
        -- directly inside the list-managed container), so this Position
        -- tween is free to run without a UIListLayout recompute snapping
        -- it back mid-flight.
        Animator.TweenAll({
            { titleLabel, { TextTransparency = 1 } },
            { bodyLabel, { TextTransparency = 1 } },
            { icon, { TextTransparency = 1 } },
            { iconHolder, { BackgroundTransparency = 1 } },
            { closeBtn, { TextTransparency = 1 } },
        }, 0.18, EASE, EASE_IN)
        if timerLabel then Animator.Tween(timerLabel, { TextTransparency = 1 }, 0.18, EASE, EASE_IN):Play() end
        if actionBtn then
            Animator.Tween(actionBtn, { BackgroundTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        end
        -- cardScale keeps its own slightly-longer 0.28s duration (the
        -- original had it separate from stroke/accentBar's 0.22s), so it
        -- stays a standalone call rather than joining the batch above.
        Animator.Tween(cardScale, { Scale = 0.94 }, 0.28, EASE, EASE_IN):Play()
        Animator.TweenAll({
            { stroke, { Transparency = 1 } },
            { accentBar, { BackgroundTransparency = 1 } },
        }, 0.22, EASE, EASE_IN)

        -- Gated on each tween's own Completed event so the slide-up ->
        -- collapse -> destroy sequence always lines up with the actual
        -- on-screen animation instead of guessing via task.delay.
        local slideOut = Animator.Tween(card, { Position = UDim2.new(0, 0, 0, -40), BackgroundTransparency = 1 }, 0.3, EASE, EASE_IN)
        slideOut:Play()

        slideOut.Completed:Connect(function()
            -- Step 2: collapse height smoothly so notifications below slide
            -- up into place instead of jumping the instant this one is gone.
            -- Shrinking `card`'s height shrinks `slot`'s AutomaticSize right
            -- along with it, which is what actually drives the list reflow.
            card.AutomaticSize = Enum.AutomaticSize.None
            card.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
            local collapse = Animator.Tween(card, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, EASE, EASE_IN)
            collapse.Completed:Connect(function()
                if opts.OnDismiss then opts.OnDismiss() end
                slot:Destroy()
            end)
            collapse:Play()
        end)
    end

    connMgr:Track(closeBtn.MouseButton1Click:Connect(function() self:Dismiss() end))
    if actionBtn then
        connMgr:Track(actionBtn.MouseButton1Click:Connect(function()
            if opts.Button.Callback then opts.Button.Callback() end
            if opts.Button.KeepOpen ~= true then self:Dismiss() end
        end))
    end

    -- Hovering a notification pauses its countdown (classic toast-UX
    -- courtesy so it doesn't vanish while you're reading it) and gives a
    -- subtle highlight so the card reads as interactive.
    connMgr:Track(card.MouseEnter:Connect(function()
        if dismissed then return end
        stopCountdown()
        TweenService:Create(card, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(baseCardColor, 1.1) }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2, EASE, EASE_OUT), { Color = accentColor, Thickness = 1.5 }):Play()
    end))
    connMgr:Track(card.MouseLeave:Connect(function()
        if dismissed then return end
        TweenService:Create(card, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = baseCardColor }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2, EASE, EASE_OUT), { Color = baseStrokeColor, Thickness = 1 }):Play()
        if not isSticky then
            if remainingTime > 0.05 then
                startCountdown()
            else
                self:Dismiss()
            end
        end
    end))

    -- Entrance: slide DOWN from just above its final spot + fade + a small
    -- springy scale overshoot (Back easing), with the icon popping in a
    -- beat later. We wait two Heartbeat frames first so `card`'s
    -- AutomaticSize has fully converged — this is what fixes both the
    -- jerky entrance and the text appearing to "land" in the wrong spot.
    card.Position = UDim2.new(0, 0, 0, -30)
    card.BackgroundTransparency = 1
    stroke.Transparency = 1
    task.defer(function()
        RunService.Heartbeat:Wait()
        RunService.Heartbeat:Wait()
        if dismissed then return end
        Animator.Tween(card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 }, 0.4, Enum.EasingStyle.Back, EASE_OUT):Play()
        Animator.Tween(cardScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back, EASE_OUT):Play()
        Animator.Tween(stroke, { Transparency = 0 }, 0.3):Play()
        task.delay(0.1, function()
            if dismissed then return end
            Animator.Tween(iconScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back, EASE_OUT):Play()
        end)
        startCountdown()
    end)

    function self:ApplyTheme() end -- notifications keep their creation-time look; they're short-lived
    return self
end


--============================================================
-- MODULE: Tab (forward-declared; methods attached after Window below)
--============================================================
local TabMeta = {}
TabMeta.__index = TabMeta

--============================================================
-- MODULE: Window
-- Owns the ScreenGui, loading screen, chrome (titlebar/drag/resize/
-- minimize) and the tab strip. Delegates page content to Tab objects,
-- which delegate individual controls to Components. There is no in-UI
-- close button — the window is closed programmatically instead, via
-- Library:Destroy() (or Window:Destroy() directly).
--============================================================
local Window = {}
Window.__index = Window

-- Maps a window Title -> its ConnectionManager, for the currently-live
-- window using that title. Lets destroyExisting() fully tear down a
-- previous run's connections (drag/resize/hover/heartbeat tweens) instead
-- of only deleting its ScreenGui and leaking every connection it made,
-- which is what re-running this script used to do every single time.
local activeWindows = {}

local function destroyExisting(playerGui, name)
    local prevConnMgr = activeWindows[name]
    if prevConnMgr then
        prevConnMgr:DisconnectAll()
        activeWindows[name] = nil
    end
    local existing = playerGui:FindFirstChild(name)
    if existing then existing:Destroy() end
end

-- Clamps a desired window size to the current viewport (minus a margin) so
-- a window configured larger than the screen never spawns off-screen or
-- clipped. Used both for the initial Size and for re-fitting on a
-- ViewportSize change (device rotation, window resize, etc).
local VIEWPORT_MARGIN = 40
-- Shared with _setupResize's resize-drag clamp below so a window can never
-- be fit smaller than the size the resize handle itself allows shrinking
-- to. Previously these were two separate, out-of-sync constants (300x220
-- here vs 340x260 in _setupResize), so a window fit to the smaller floor
-- on a tiny viewport would visibly snap larger the first time it was
-- resized by hand.
local MIN_WINDOW_W, MIN_WINDOW_H = 340, 260
local MIN_FIT_W, MIN_FIT_H = MIN_WINDOW_W, MIN_WINDOW_H
local function fitToViewport(size)
    local viewport = workspace.CurrentCamera.ViewportSize
    local maxW = math.max(viewport.X - VIEWPORT_MARGIN, MIN_FIT_W)
    local maxH = math.max(viewport.Y - VIEWPORT_MARGIN, MIN_FIT_H)
    local w = math.min(size.X.Offset, maxW)
    local h = math.min(size.Y.Offset, maxH)
    return UDim2.new(0, w, 0, h)
end

-- Clamps a frame's Position so it stays fully on-screen for the given
-- Size/AnchorPoint. Shared by the titlebar drag handler and the viewport
-- refit handler below — previously only drag clamped position, so a
-- window sitting near a screen edge whose viewport then shrank (rotation,
-- resizing the game window) could end up stuck partly off-screen with no
-- way to recover short of dragging it back manually.
local function clampFramePosition(pos, size, anchor)
    local viewport = workspace.CurrentCamera.ViewportSize
    local w, h = size.X.Offset, size.Y.Offset

    local scaleX = pos.X.Scale * viewport.X
    local scaleY = pos.Y.Scale * viewport.Y

    local minX, maxX = anchor.X * w - scaleX, viewport.X - (1 - anchor.X) * w - scaleX
    local minY, maxY = anchor.Y * h - scaleY, viewport.Y - (1 - anchor.Y) * h - scaleY

    if minX > maxX then minX, maxX = maxX, minX end
    if minY > maxY then minY, maxY = maxY, minY end

    local x = math.clamp(pos.X.Offset, minX, maxX)
    local y = math.clamp(pos.Y.Offset, minY, maxY)
    return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
end

-- Changes a frame's AnchorPoint while keeping its on-screen position
-- unchanged. _setupResize needs this for a center<->top-left round trip
-- (so resizing grows/shrinks from the top-left corner instead of from the
-- center) and _setupMinimize needs it for a center<->top-center round trip
-- (so minimizing collapses toward the titlebar instead of toward the
-- middle) — four call sites previously each hand-derived their own offset
-- math for one specific anchor pair. One formula covers every pair: the
-- position offset shifts by (newAnchor - oldAnchor) * size, read from
-- whatever frame.AnchorPoint currently is rather than assuming which pair
-- is being converted.
local function reanchorFrame(frame, newAnchor)
    local size, pos, oldAnchor = frame.Size, frame.Position, frame.AnchorPoint
    local dx = (newAnchor.X - oldAnchor.X) * size.X.Offset
    local dy = (newAnchor.Y - oldAnchor.Y) * size.Y.Offset
    frame.AnchorPoint = newAnchor
    frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + dx, pos.Y.Scale, pos.Y.Offset + dy)
end

function Window.new(config)
    config = config or {}
    local title = config.Title or "Selenix"
    local size = config.Size or UDim2.new(0, 460, 0, 390)
    -- Optional titlebar icon. Pass an asset id string (e.g. "rbxassetid://123"
    -- or just the numeric id, both accepted below). Leave nil/"" to omit the
    -- icon entirely — the title text then shifts left to fill the freed space
    -- instead of leaving an empty gap where the icon would have been.
    local icon = config.Icon
    if type(icon) == "number" then icon = "rbxassetid://" .. tostring(icon) end
    if icon == "" then icon = nil end

    local playerGui = Player:WaitForChild("PlayerGui")
    destroyExisting(playerGui, title)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = title
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local connMgr = ConnectionManager.new()
    local theme = Theme.new(config.Color or Color3.fromRGB(30, 30, 35), config.Accent or Color3.fromRGB(60, 60, 70))
    activeWindows[title] = connMgr

    local self = setmetatable({
        _title = title,
        _icon = icon,
        _screenGui = screenGui,
        _connMgr = connMgr,
        _theme = theme,
        _tabs = {},
        _tabButtons = {},
        _pages = {},
        _activeTabIndex = 1,
        -- config.Loading (optional): { Manual = bool, WaitForGameLoaded = bool,
        -- PreloadIcon = bool } — see _buildLoadingScreen / SetLoadingProgress.
        _loadingConfig = config.Loading or {},
        -- Flag -> component object registry, populated by Tab:CreateXxx({Flag=...})
        -- and consumed by SaveConfig/LoadConfig below.
        _flags = {},
    }, Window)

    self:_buildChrome(title, fitToViewport(size))
    self:_buildNotificationLayer()
    return self
end

