    self:_setupResize(mainFrame, originalSize)
    self:_setupMinimize(mainFrame, minimizeBtn)
    self:_setupViewportRefit(mainFrame)

    theme:Subscribe(function(color, accent, isInitial)
        local darkTitle = Utils.Darken(color, 0.7)
        local darkTab = Utils.Darken(color, 0.85)
        local strokeColor = Utils.Brighten(color, 1.3)
        local titleTextColor = Utils.GetTextColorFor(darkTitle, accent)

        Animator.ApplyTheme(isInitial, {
            { mainFrame, { BackgroundColor3 = color } },
            { titleBar, { BackgroundColor3 = darkTitle } },
            { tabContainer, { BackgroundColor3 = darkTab } },
            { stroke, { Color = strokeColor } },
            { titleLabel, { TextColor3 = titleTextColor } },
        })

        self:_restyleTabButtons(color, accent)
    end)
end

function Window:_setupViewportRefit(mainFrame)
    local connMgr = self._connMgr
    connMgr:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if self._resizing or self._animating or self._titleDragging then return end

        if self._minimized then
            -- mainFrame's current Size is the minimized bar, not the real
            -- window size, so don't touch it — just keep _currentTargetSize
            -- in sync with the new viewport so restoring later can't pop
            -- back to a size larger than the (possibly now-smaller) screen.
            self._currentTargetSize = fitToViewport(self._currentTargetSize)
            return
        end

        local fitted = fitToViewport(mainFrame.Size)
        local sizeChanged = fitted ~= mainFrame.Size
        if sizeChanged then
            Animator.Tween(mainFrame, { Size = fitted }, 0.25):Play()
            self._currentTargetSize = fitted
        end

        -- Also re-clamp Position: a window parked near a screen edge can
        -- end up partly (or entirely) off-screen once the viewport shrinks
        -- (device rotation, resizing the game window), with nothing else
        -- to pull it back — dragging clamps position, but a passive
        -- viewport change previously didn't.
        local clampedPos = clampFramePosition(mainFrame.Position, sizeChanged and fitted or mainFrame.Size, mainFrame.AnchorPoint)
        if clampedPos ~= mainFrame.Position then
            Animator.Tween(mainFrame, { Position = clampedPos }, 0.25):Play()
        end
    end))
end

function Window:_buildLoadingScreen(title, mainFrame, mainScale, mainShadow)
    local screenGui = self._screenGui
    local theme = self._theme
    local loadingCfg = self._loadingConfig or {}
    local manual = loadingCfg.Manual == true
    local waitForGameLoaded = (loadingCfg.WaitForGameLoaded ~= false)
    local preloadIcon = (loadingCfg.PreloadIcon ~= false) and (self._icon ~= nil)

    local loading = Instance.new("Frame")
    loading.AnchorPoint = Vector2.new(0.5, 0.5)
