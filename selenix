    loading.Size = UDim2.new(0, 280, 0, 130)
    loading.BackgroundColor3 = theme.Color
    loading.BorderSizePixel = 0
    loading.Parent = screenGui
    Utils.AddCorner(loading, UDim.new(0, 12))
    local loadingStroke = Instance.new("UIStroke")
    loadingStroke.Color = Utils.Brighten(theme.Color, 1.3)
    loadingStroke.Thickness = 1
    loadingStroke.Parent = loading

    local loadingTitle = Instance.new("TextLabel")
    loadingTitle.Size = UDim2.new(1, -30, 0, 28)
    loadingTitle.Position = UDim2.new(0, 15, 0, 26)
    loadingTitle.BackgroundTransparency = 1
    loadingTitle.Text = title
    loadingTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    loadingTitle.TextXAlignment = Enum.TextXAlignment.Left
    loadingTitle.Font = Enum.Font.BuilderSansBold
    loadingTitle.TextSize = 20
    loadingTitle.Parent = loading

    local loadingSubtitle = Instance.new("TextLabel")
    loadingSubtitle.Size = UDim2.new(1, -30, 0, 18)
    loadingSubtitle.Position = UDim2.new(0, 15, 0, 56)
    loadingSubtitle.BackgroundTransparency = 1
    loadingSubtitle.Text = "Đang khởi tạo..."
    loadingSubtitle.TextColor3 = Color3.fromRGB(180, 180, 190)
    loadingSubtitle.TextXAlignment = Enum.TextXAlignment.Left
    loadingSubtitle.Font = Enum.Font.BuilderSans
    loadingSubtitle.TextSize = 13
    loadingSubtitle.Parent = loading

    local barTrack = Instance.new("Frame")
    barTrack.Size = UDim2.new(1, -30, 0, 6)
    barTrack.Position = UDim2.new(0, 15, 1, -28)
    barTrack.BackgroundColor3 = Utils.Darken(theme.Color, 0.8)
    barTrack.BorderSizePixel = 0
    barTrack.Parent = loading
    Utils.AddCorner(barTrack, UDim.new(1, 0))

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = theme.Accent
    barFill.BorderSizePixel = 0
    barFill.Parent = barTrack
    Utils.AddCorner(barFill, UDim.new(1, 0))

    local loadingScale = Instance.new("UIScale")
    loadingScale.Scale = 0.85
    loadingScale.Parent = loading
    loading.BackgroundTransparency = 1

    Animator.Tween(loadingScale, { Scale = 1 }, 0.35):Play()
    Animator.Tween(loading, { BackgroundTransparency = 0 }, 0.35):Play()

    local connMgr = self._connMgr
    self._loadingDone = false
    self._loadingAlpha = 0

    local function finishLoading()
        if self._loadingDone then return end
        self._loadingDone = true
        Animator.Tween(loadingScale, { Scale = 0.85 }, 0.3, EASE, EASE_IN):Play()
        local fadeOut = Animator.Tween(loading, { BackgroundTransparency = 1 }, 0.3, EASE, EASE_IN)
        fadeOut.Completed:Connect(function()
            loading:Destroy()
            mainFrame.Visible = true
            Animator.Tween(mainScale, { Scale = 1 }, 0.35):Play()
            Animator.Tween(mainFrame, { BackgroundTransparency = 0 }, 0.45):Play()
            Animator.Tween(mainShadow, { Transparency = 0.45 }, 0.5):Play()
        end)
        fadeOut:Play()
    end
    self._finishLoading = finishLoading

    function self:SetLoadingProgress(alpha, text)
        if self._loadingDone then return end
        alpha = math.clamp(alpha or 0, 0, 1)
        self._loadingAlpha = alpha
        Animator.Tween(barFill, { Size = UDim2.new(alpha, 0, 1, 0) }, 0.25):Play()
        if text then loadingSubtitle.Text = text end
        if alpha >= 1 then finishLoading() end
    end

    function self:FinishLoading(text)
        self:SetLoadingProgress(1, text)
    end

    task.spawn(function()
        local steps = {}
        if waitForGameLoaded and not game:IsLoaded() then table.insert(steps, "game") end
        if preloadIcon then table.insert(steps, "icon") end

        if #steps == 0 then
            if not manual then self:FinishLoading("Sẵn sàng") end
            return
        end

        local capMax = manual and 0.9 or 1.0
        local completed = 0
        local function stepDone(text)
            completed = completed + 1
            self:SetLoadingProgress((completed / #steps) * capMax, text)
        end

        if waitForGameLoaded and not game:IsLoaded() then
            self:SetLoadingProgress(0, "Đang chờ game tải...")
            game.Loaded:Wait()
            stepDone("Đã tải game")
        end
        if preloadIcon then
            local ok = pcall(function()
                ContentProvider:PreloadAsync({ self._icon })
            end)
            stepDone(ok and "Đã tải icon" or "Bỏ qua icon")
        end

        if not manual then
            self:FinishLoading("Sẵn sàng")
        end
    end)
end

function Window:_setupDrag(titleBar, mainFrame)
    local connMgr = self._connMgr
    self._titleDragging = false
    local activeInput, dragStart, startPos

    connMgr:Track(titleBar.InputBegan:Connect(function(input)
        if self._titleDragging or self._resizing or self._animating then return end
        if Utils.IsPointerDown(input) then
            self._titleDragging = true
            activeInput = input
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if self._titleDragging and input == activeInput and Utils.IsPointerMove(input) then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            mainFrame.Position = clampFramePosition(newPos, mainFrame.Size, mainFrame.AnchorPoint)
        end
    end))
    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if self._titleDragging and input == activeInput then
            self._titleDragging = false
            activeInput = nil
        end
    end))
end

function Window:_setupResize(mainFrame, originalSize)
    local connMgr = self._connMgr
    self._currentTargetSize = originalSize
    self._resizing = false

    local function maxSize()
        local viewport = workspace.CurrentCamera.ViewportSize
        return math.max(viewport.X - VIEWPORT_MARGIN, MIN_WINDOW_W),
               math.max(viewport.Y - VIEWPORT_MARGIN, MIN_WINDOW_H)
    end

    local handle = Instance.new("TextButton")
    handle.AnchorPoint = Vector2.new(1, 1)
    handle.Size = UDim2.new(0, 22, 0, 22)
    handle.Position = UDim2.new(1, -2, 1, -2)
    handle.BackgroundTransparency = 1
    handle.Text = "◢"
    handle.TextColor3 = Color3.fromRGB(150, 150, 165)
    handle.TextSize = 16
    handle.Font = Enum.Font.BuilderSansBold
    handle.ZIndex = 15
    handle.Active = true
    handle.Parent = mainFrame
    self._resizeHandle = handle

    local contentGroup = self._contentGroup

    local activeInput, dragStart, startSize
    -- Cached at drag-start instead of recomputed on every InputChanged —
    -- ViewportSize only actually changes on rotation/window-resize (already
    -- covered separately by _setupViewportRefit), not on every mouse-move
    -- frame, so recomputing it per-pixel-dragged was pure waste.
    local cachedMaxW, cachedMaxH
    connMgr:Track(handle.InputBegan:Connect(function(input)
        if self._resizing or self._titleDragging or self._minimized or self._animating then return end
        if Utils.IsPointerDown(input) then
            self._resizing = true
            activeInput = input
            dragStart = input.Position
            reanchorFrame(mainFrame, Vector2.new(0, 0))
            startSize = mainFrame.Size
            cachedMaxW, cachedMaxH = maxSize()
            contentGroup.Visible = false
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if self._resizing and input == activeInput and Utils.IsPointerMove(input) then
            local delta = input.Position - dragStart
            local w = math.clamp(startSize.X.Offset + delta.X, MIN_WINDOW_W, cachedMaxW)
            local h = math.clamp(startSize.Y.Offset + delta.Y, MIN_WINDOW_H, cachedMaxH)
            mainFrame.Size = UDim2.new(0, w, 0, h)
        end
    end))
    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if self._resizing and input == activeInput then
            self._resizing = false
            activeInput = nil
            self._currentTargetSize = mainFrame.Size
            reanchorFrame(mainFrame, Vector2.new(0.5, 0.5))
            contentGroup.Visible = true
        end
    end))
    connMgr:Track(handle.MouseEnter:Connect(function()
        if not self._minimized then Animator.Tween(handle, { TextColor3 = Color3.fromRGB(220, 220, 230) }, 0.25):Play() end
    end))
    connMgr:Track(handle.MouseLeave:Connect(function()
        Animator.Tween(handle, { TextColor3 = Color3.fromRGB(150, 150, 165) }, 0.25):Play()
    end))
end

function Window:_setupMinimize(mainFrame, minimizeBtn)
    local connMgr = self._connMgr
    self._minimized = false
    self._animating = false

    local MINIMIZED_HEIGHT = 40
    local SIZE_TWEEN_TIME = 0.4
    local CONTENT_FADE_OUT_TIME = 0.22
    local CONTENT_FADE_IN_TIME = 0.28

    connMgr:Track(minimizeBtn.MouseButton1Click:Connect(function()
        if self._animating then return end
        self._animating = true
        self._minimized = not self._minimized

        local contentGroup = self._contentGroup
        local titleBarCorner = self._titleBarCorner
        local mainFrameRadius = self._mainFrameRadius

        if self._minimized then
            minimizeBtn.Text = "▢"
            self._resizeHandle.Visible = false

            local focused = UserInputService:GetFocusedTextBox()
            if focused then focused:ReleaseFocus() end

            Animator.FadeCanvasGroup(contentGroup, 1, CONTENT_FADE_OUT_TIME, connMgr, function()
                self._tabContainer.Visible = false
                for _, p in ipairs(self._pages) do p.Visible = false end

                reanchorFrame(mainFrame, Vector2.new(0.5, 0))
                local currentW = mainFrame.Size.X.Offset
                local shrink = Animator.Tween(mainFrame, {
                    Size = UDim2.new(0, currentW, 0, MINIMIZED_HEIGHT)
                }, SIZE_TWEEN_TIME)
                Animator.Tween(titleBarCorner, {
                    BottomLeftRadius = mainFrameRadius,
                    BottomRightRadius = mainFrameRadius,
                }, SIZE_TWEEN_TIME):Play()
                shrink.Completed:Connect(function() self._animating = false end)
                shrink:Play()
            end)
        else
            minimizeBtn.Text = "—"

            self._tabContainer.Visible = true
            for i, p in ipairs(self._pages) do
                p.Visible = (i == self._activeTabIndex)
                p.Position = UDim2.new(0, 10, 0, 95)
            end
            self._resizeHandle.Visible = true
            contentGroup.GroupTransparency = 1

            local targetSize = self._currentTargetSize
            local grow = Animator.Tween(mainFrame, { Size = targetSize }, SIZE_TWEEN_TIME)
            Animator.Tween(titleBarCorner, {
                BottomLeftRadius = UDim.new(0, 0),
                BottomRightRadius = UDim.new(0, 0),
            }, SIZE_TWEEN_TIME):Play()
            grow.Completed:Connect(function()
                reanchorFrame(mainFrame, Vector2.new(0.5, 0.5))
                if self._minimized then self._animating = false; return end

                Animator.FadeCanvasGroup(contentGroup, 0, CONTENT_FADE_IN_TIME, connMgr, function()
                    self._animating = false
                end)
            end)
            grow:Play()
        end
    end))
end

function Window:_restyleTabButtons(color, accent)
    local inactiveBg = Utils.Darken(color, 0.82)
    for i, btn in ipairs(self._tabButtons) do
        local isActive = (i == self._activeTabIndex)
        local bg = isActive and accent or inactiveBg
        Animator.Tween(btn, {
            BackgroundColor3 = bg,
            TextColor3 = Utils.GetTextColorFor(bg, accent),
        }, 0.25):Play()
    end
end

function Window:CreateTab(name)
    local index = #self._tabButtons + 1
    local connMgr, theme, mainFrame = self._connMgr, self._theme, self._mainFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 35)
    btn.LayoutOrder = index
    btn.BackgroundColor3 = (index == 1) and theme.Accent or Utils.Darken(theme.Color, 0.82)
    btn.Text = name
    btn.Font = Enum.Font.BuilderSansBold
    btn.TextSize = 15
    btn.AutoButtonColor = false
    btn.Parent = self._tabContainer
    Utils.AddCorner(btn, UDim.new(0, 6))

    local function tabBaseColor()
        return (index == self._activeTabIndex) and theme.Accent or Utils.Darken(theme.Color, 0.82)
    end
    local function tabTextColor()
        return Utils.GetTextColorFor(tabBaseColor(), theme.Accent)
    end
    local function tabHoverTextColor()
        return Utils.GetTextColorFor(Utils.Brighten(tabBaseColor(), 1.2), theme.Accent)
    end

    btn.TextColor3 = tabTextColor()

    connMgr:Track(btn.MouseEnter:Connect(function()
        local hoverBg = Utils.Brighten(tabBaseColor(), 1.2)
        TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), {
            BackgroundColor3 = hoverBg,
            TextColor3 = tabHoverTextColor(),
        }):Play()
    end))
    connMgr:Track(btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), {
            BackgroundColor3 = tabBaseColor(),
            TextColor3 = tabTextColor(),
        }):Play()
    end))
    table.insert(self._tabButtons, btn)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -20, 1, -110)
    page.Position = UDim2.new(0, 10, 0, 95)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = self._contentGroup
    page.Visible = (index == 1)
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = page
    Utils.AddPadding(page, UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 4))
    table.insert(self._pages, page)

    local switching = false
    local PAGE_BASE_POS = UDim2.new(0, 10, 0, 95)
    local function switchTo()
        if switching or index == self._activeTabIndex then return end
        switching = true
        local previousIndex = self._activeTabIndex
        local direction = (index > previousIndex) and 1 or -1
        self._activeTabIndex = index
        self:_restyleTabButtons(theme.Color, theme.Accent)

        self._pages[previousIndex].Visible = false
        self._pages[previousIndex].Position = PAGE_BASE_POS

        local newPage = self._pages[index]
        newPage.Position = UDim2.new(0, 10 + direction * self._slideOffset, 0, 95)
        newPage.Visible = true

        local slide = Animator.Tween(newPage, { Position = PAGE_BASE_POS }, 0.35)
        slide.Completed:Connect(function() switching = false end)
        slide:Play()
    end
    connMgr:Track(btn.MouseButton1Click:Connect(switchTo))

    local tab = setmetatable({
        _page = page,
        _button = btn,
        _theme = theme,
        _connMgr = connMgr,
        _window = self,
        _order = 0,
    }, TabMeta)
    table.insert(self._tabs, tab)
    return tab
end

function Window:Destroy()
    if activeWindows[self._title] == self._connMgr then
        activeWindows[self._title] = nil
    end
    self._connMgr:DisconnectAll()
    local mainScale = self._mainFrame:FindFirstChildOfClass("UIScale")
    local shadow = self._mainFrame:FindFirstChildOfClass("UIShadow")
    if mainScale then Animator.Tween(mainScale, { Scale = 0.5 }, 0.3, EASE, EASE_IN):Play() end
    Animator.Tween(self._mainFrame, { BackgroundTransparency = 1 }, 0.3, EASE, EASE_IN):Play()
    if shadow then Animator.Tween(shadow, { Transparency = 1 }, 0.3, EASE, EASE_IN):Play() end
    task.delay(0.3, function() self._screenGui:Destroy() end)
end

function Window:GetTheme() return self._theme end
function Window:GetGradients() return self._gradients end

function Window:_registerFlag(flag, obj)
    if not flag then return end
    if self._flags[flag] then
        warn(("[Selenix] Flag \"%s\" is already registered — SaveConfig/LoadConfig will only see the most recently created control using this Flag."):format(tostring(flag)))
    end
    self._flags[flag] = obj
end

local CONFIG_FOLDER = "Selenix/Config"
-- Marker file recording the name of the most recently *saved* config, kept
-- outside the .json namespace (ListConfigs' pattern only matches "*.json")
-- so it never shows up as a fake config entry. This is what
-- Window:GetLastConfig() / CreateConfigList's AutoLoadLast read from.
local LAST_CONFIG_MARKER = CONFIG_FOLDER .. "/_last.txt"

local function configFolder()
    if not (isfolder and makefolder) then return nil end
    if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
    return CONFIG_FOLDER
end

local function configPath(name)
    return CONFIG_FOLDER .. "/" .. (name or "default") .. ".json"
end

function Window:SaveConfig(name)
    if not writefile then return false, "executor has no writefile" end
    if not (name and name ~= "") then return false, "config name is empty" end

    configFolder()
    local path = configPath(name)

    local data = {}
    for flag, obj in pairs(self._flags) do
        if obj.Get then
            local ok, v = pcall(function() return obj:Get() end)
            if ok then
                if typeof(v) == "Color3" then
                    data[flag] = { __color3 = true, r = v.R, g = v.G, b = v.B }
                else
                    data[flag] = v
                end
            end
        end
    end

    local okEncode, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not okEncode then return false, "JSONEncode failed" end
    local okWrite = pcall(writefile, path, encoded)
    if not okWrite then return false, "writefile failed" end

    -- Record this as the most recently saved config. Best-effort: a failure
    -- here shouldn't turn a successful SaveConfig into a reported failure,
    -- it just means AutoLoadLast/GetLastConfig won't pick this one up.
    pcall(writefile, LAST_CONFIG_MARKER, name)

    return true
end

function Window:LoadConfig(name)
    if not (readfile and isfile) then return false, "executor has no readfile/isfile" end

    local path = configPath(name)
    if not isfile(path) then return false, "config file not found" end

    local okRead, raw = pcall(readfile, path)
    if not okRead then return false, "readfile failed" end
    local okDecode, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode or type(data) ~= "table" then return false, "JSONDecode failed" end

    for flag, obj in pairs(self._flags) do
        local v = data[flag]
        if v ~= nil and obj.Set then
            if type(v) == "table" and v.__color3 then
                v = Color3.new(v.r, v.g, v.b)
            end
            pcall(function() obj:Set(v) end)
        end
    end
    return true
end

function Window:ListConfigs()
    if not listfiles then return {} end
    local folder = configFolder()
    if not folder then return {} end

    local okList, files = pcall(listfiles, folder)
    if not okList then return {} end

    local names = {}
    for _, path in ipairs(files) do
        local fname = path:match("([^/\\]+)%.json$")
        if fname then table.insert(names, fname) end
    end
    table.sort(names)
    return names
end

-- Returns the name of the most recently *saved* config (via the marker
-- file SaveConfig writes), or nil if none is recorded / the executor
-- doesn't support readfile. Unlike ListConfigs()[#ListConfigs()] (what
-- CreateConfigList's AutoLoadLast used to fall back on), this reflects
-- actual save recency instead of alphabetical order — "abc" saved after
-- "main" no longer gets skipped in favor of "main" just because it sorts
-- earlier.
function Window:GetLastConfig()
    if not (readfile and isfile) then return nil end
    if not isfile(LAST_CONFIG_MARKER) then return nil end
    local okRead, name = pcall(readfile, LAST_CONFIG_MARKER)
    if not okRead or not name or name == "" then return nil end
    if not isfile(configPath(name)) then return nil end
    return name
end

function Window:DeleteConfig(name)
    if not delfile then return false, "executor has no delfile" end
    if not (name and name ~= "") then return false, "config name is empty" end

    local path = configPath(name)
    if not (isfile and isfile(path)) then return false, "config file not found" end

    local okDelete = pcall(delfile, path)
    if not okDelete then return false, "delfile failed" end
    return true
end

function Window:_buildNotificationLayer()
    local screenGui = self._screenGui

    local container = Instance.new("Frame")
    container.Name = "Notifications"
    container.AnchorPoint = Vector2.new(1, 0)
    container.Position = UDim2.new(1, -20, 0, 20)
    container.BackgroundTransparency = 1
    container.ZIndex = 100
    container.Parent = screenGui

    local MAX_WIDTH = 300
    local MIN_MARGIN = 20
    local function updateContainerSize()
        local viewport = workspace.CurrentCamera.ViewportSize
        local w = math.min(MAX_WIDTH, viewport.X - MIN_MARGIN * 2)
        container.Size = UDim2.new(0, w, 1, -40)
    end
    updateContainerSize()
    self._connMgr:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateContainerSize))

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.Padding = UDim.new(0, 8)
    layout.Parent = container

    self._notifContainer = container
    self._notifOrder = 0

    self._activeNotifs = {}
    self._maxNotifs = 5
end

function Window:Notify(opts)
    opts = opts or {}
    self._notifOrder = self._notifOrder + 1
    opts.LayoutOrder = self._notifOrder

    if #self._activeNotifs >= self._maxNotifs then
        local oldest = table.remove(self._activeNotifs, 1)
        if oldest and oldest.Dismiss then oldest:Dismiss() end
    end

    local notif = Components.Notification(self._notifContainer, self._theme, self._connMgr, opts)
    local userOnDismiss = opts.OnDismiss
    opts.OnDismiss = function()
        for i, n in ipairs(self._activeNotifs) do
            if n == notif then table.remove(self._activeNotifs, i); break end
        end
        if userOnDismiss then userOnDismiss() end
    end
    table.insert(self._activeNotifs, notif)
    return notif
end

local function nextOrder(tab)
    tab._order = tab._order + 1
    return tab._order
end

-- Generates the bulk of TabMeta:CreateXxx by table-driven dispatch instead
-- of ~20 hand-written, nearly-identical wrapper functions (each was just
-- "bump LayoutOrder, call the matching Components.* factory, optionally
-- register the Flag, return"). This mirrors the ACCORDION_FACTORY_MAP
-- pattern above — same shape of duplication, same fix. Any TabMeta:CreateXxx
-- with genuinely different logic (CreateAccordion needs to stamp _window/
-- _tab onto the returned object; CreateGradientPicker reserves two
-- LayoutOrder slots; CreateConfigList/CreateSearchBar/AddTooltip compose
-- several controls or don't create a page-level control at all) stays
-- hand-written below this table instead of being forced into the map.
local TAB_FACTORY_MAP = {
    CreateLabel = { fn = "Label" },
    CreateButton = { fn = "Button" },
    CreateToggle = { fn = "Toggle", flag = true },
    CreateSlider = { fn = "Slider", flag = true },
    CreateTextbox = { fn = "Textbox", flag = true },
    CreateDropdown = { fn = "Dropdown", flag = true },
    CreateMultiDropdown = { fn = "MultiDropdown", flag = true },
    CreateColorPicker = { fn = "ColorPicker", flag = true },
    CreateThemeGrid = { fn = "ThemeGrid" },
    CreateDivider = { fn = "Divider" },
    CreateParagraph = { fn = "Paragraph" },
    CreateKeybind = { fn = "Keybind", flag = true },
    CreateNumberStepper = { fn = "NumberStepper", flag = true },
    CreateRadioGroup = { fn = "RadioGroup", flag = true },
    CreateTableList = { fn = "TableList" },
    CreateProgressBar = { fn = "ProgressBar", flag = true },
    CreateSegmentedControl = { fn = "SegmentedControl", flag = true },
    CreateLogPanel = { fn = "LogPanel" },
}
for methodName, info in pairs(TAB_FACTORY_MAP) do
    TabMeta[methodName] = function(self, opts)
        opts = opts or {}
        opts.LayoutOrder = nextOrder(self)
        local obj = Components[info.fn](self._page, self._theme, self._connMgr, opts)
        if info.flag then self._window:_registerFlag(opts.Flag, obj) end
        return obj
    end
end

-- CreateGradientPicker reserves TWO LayoutOrder slots (the toggle row plus
-- its separately-parented preset grid, see Components.GradientPicker),
-- so it can't go through the one-slot TAB_FACTORY_MAP above.
function TabMeta:CreateGradientPicker(opts)
    opts = opts or {}
    opts.LayoutOrder = nextOrder(self)
    nextOrder(self)
    return Components.GradientPicker(self._page, self._theme, self._connMgr, opts)
end

-- CreateAccordion stamps _window/_tab onto the returned object (needed by
-- AccordionMeta:CreateXxx for Flag registration and search-index
-- registration of nested controls), which no other Create method needs.
function TabMeta:CreateAccordion(opts)
    opts = opts or {}
    opts.LayoutOrder = nextOrder(self)
    local acc = Components.Accordion(self._page, self._theme, self._connMgr, opts)
    acc._window = self._window
    acc._tab = self -- lets AccordionMeta:CreateXxx register children into this tab's search index
    return acc
end

-- Gắn tooltip lên MỘT control đã tạo trước đó — KHÔNG tạo dòng mới trong
-- tab (không gọi nextOrder, không cần LayoutOrder). Ví dụ:
--   local btn = tab:CreateButton({ Text = "Chạy" })
--   tab:AddTooltip(btn.Instance, { Text = "Chạy script chính" })
function TabMeta:AddTooltip(targetInstance, opts)
    return Components.Tooltip(targetInstance, self._theme, self._connMgr, opts)
end

function TabMeta:CreateConfigList(opts)
    opts = opts or {}
    local window = self._window

    local nameBox = self:CreateTextbox({
        Text = opts.NameText or "Tên config:",
        Placeholder = "vd: main",
    })

    local dropdown = self:CreateDropdown({
        Text = opts.Text or "Config đã lưu:",
        Options = window:ListConfigs(),
        Callback = function(selectedName)
            if selectedName then nameBox:Set(selectedName) end
        end,
    })

    local function refreshList(keepSelection)
        dropdown:Refresh(window:ListConfigs(), keepSelection)
    end

    self:CreateButton({
        Text = opts.SaveText or "Lưu Config",
        Callback = function()
            local name = nameBox:Get()
            local ok, err = window:SaveConfig(name)
            refreshList(true)
            if window.Notify then
                window:Notify({
                    Title = ok and "Đã lưu" or "Lỗi",
                    Text = ok and ("Đã lưu config \"" .. name .. "\"") or (err or "Không thể lưu config"),
                    Type = ok and "success" or "error",
                })
            end
        end,
    })

    self:CreateButton({
        Text = opts.LoadText or "Tải Config",
        Callback = function()
            local name = nameBox:Get()
            local ok, err = window:LoadConfig(name)
            if window.Notify then
                window:Notify({
                    Title = ok and "Đã tải" or "Lỗi",
                    Text = ok and ("Đã tải config \"" .. name .. "\"") or (err or "Không thể tải config"),
                    Type = ok and "success" or "error",
                })
            end
        end,
    })

    self:CreateButton({
        Text = opts.DeleteText or "Xoá Config",
        Callback = function()
            local name = nameBox:Get()
            local ok, err = window:DeleteConfig(name)
            refreshList(false)
            if ok then nameBox:Set("") end
            if window.Notify then
                window:Notify({
                    Title = ok and "Đã xoá" or "Lỗi",
                    Text = ok and ("Đã xoá config \"" .. name .. "\"") or (err or "Không thể xoá config"),
                    Type = ok and "success" or "error",
                })
            end
        end,
    })

    if opts.AutoLoadLast then
        -- Uses the actual last-*saved* config (see Window:GetLastConfig),
        -- not ListConfigs()[#ListConfigs()] — that list is alphabetically
        -- sorted, so it previously picked whichever name sorted last
        -- ("main") instead of whichever was actually saved most recently
        -- ("abc" saved afterwards).
        local last = window:GetLastConfig()
        if last then
            nameBox:Set(last)
            window:LoadConfig(last)
        end
    end

    return { Dropdown = dropdown, NameBox = nameBox, Refresh = refreshList }
end

-- Bọc mọi TabMeta:CreateXxx hiện có (được định nghĩa phía trên, kể cả
-- CreateConfigList) để tự gắn attribute chứa text tìm kiếm lên obj.Instance
-- và đăng ký vào self._searchEntries — nhờ vậy CreateSearchBar không cần
-- từng factory biết gì về search cả. Phải nằm SAU toàn bộ định nghĩa
-- TabMeta:CreateXxx gốc vì nó snapshot pairs(TabMeta) tại thời điểm chạy.
for methodName, fn in pairs(TabMeta) do
    if methodName:sub(1, 6) == "Create" then
        TabMeta[methodName] = function(self, opts, ...)
            local obj = fn(self, opts, ...)
            if obj and obj.Instance then
                local searchText = (opts and (opts.Text or opts.Title)) or ""
                local lowered = tostring(searchText):lower()
                obj.Instance:SetAttribute("SelenixSearchText", lowered)
                self._searchEntries = self._searchEntries or {}
                table.insert(self._searchEntries, obj.Instance)
                -- Some components (GradientPicker) render a SECOND top-level
                -- GuiObject alongside Instance (its preset grid, exposed as
                -- obj.GridInstance). Without also tagging/registering it
                -- here, filtering hides the toggle row but leaves the grid
                -- visible underneath it — tag it the same way when present.
                if obj.GridInstance then
                    obj.GridInstance:SetAttribute("SelenixSearchText", lowered)
                    table.insert(self._searchEntries, obj.GridInstance)
                end
            end
            return obj
        end
    end
end

-- ---------- Global SearchBar ----------
-- Đặt đầu tab, lọc mọi control TRONG TAB ĐÓ theo Text/Title (không phân
-- biệt hoa thường), ẩn/hiện qua Visible — UIListLayout của page tự reflow.
-- Định nghĩa SAU khối wrap ở trên nên bản thân nó không bị wrap / không tự
-- đăng ký làm search entry của chính nó.
function TabMeta:CreateSearchBar(opts)
    opts = opts or {}
    opts.LayoutOrder = nextOrder(self)
    local tab = self

    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder
    frame.Parent = self._page
    Utils.AddCorner(frame, UDim.new(0, 8))

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 1, 0)
    box.Position = UDim2.new(0, 10, 0, 0)
    box.Text = ""
    box.PlaceholderText = opts.Placeholder or "Tìm kiếm..."
    box.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.BuilderSans
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = frame
    Utils.AddCorner(box, UDim.new(0, 6))
    -- FIX: previously only PaddingLeft was passed here (Utils.AddPadding(box,
    -- UDim.new(0, 10)) with no second argument), so the text/placeholder sat
    -- flush against the box's right edge while the left side kept its 10px
    -- gap — the search bar's inner text visibly looked lopsided compared to
    -- every other input in the library (Textbox, Dropdown's search row,
    -- etc), which always pad both sides. Now padded symmetrically.
    Utils.AddPadding(box, UDim.new(0, 10), UDim.new(0, 10))

    local function applyFilter(query)
        query = query:lower()
        for _, inst in ipairs(tab._searchEntries or {}) do
            if inst.Parent then
                local text = inst:GetAttribute("SelenixSearchText") or ""
                inst.Visible = (query == "") or text:find(query, 1, true) ~= nil
            end
        end
    end
    self._connMgr:Track(box:GetPropertyChangedSignal("Text"):Connect(function()
        applyFilter(box.Text)
    end))

    local self2 = { Instance = frame }
    function self2:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, _, textColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { box, { BackgroundColor3 = darkBg, TextColor3 = textColor } },
        })
    end
    self._theme:Subscribe(function(c, a, initial) self2:ApplyTheme(c, a, initial) end)
    return self2
end

local Library = {}

-- All windows created via Library:CreateWindow this session — not just the
-- most recent one. Library:Destroy() tears down every one of them.
-- Previously only a single _activeWindow was tracked, so creating a second
-- window with a different Title silently orphaned the first one's
-- ScreenGui + every connection it held (drag, resize, hover, gradient/
-- notification Heartbeat loops) instead of cleaning it up.
Library._windows = {}

function Library:CreateWindow(config)
    local window = Window.new(config)
    table.insert(Library._windows, window)
    return window
end

function Library:Destroy()
    for _, window in ipairs(Library._windows) do
        window:Destroy()
    end
    table.clear(Library._windows)
end

return Library
