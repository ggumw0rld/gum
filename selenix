--[[
    ============================================================
    Selenix UI Library — Modular Rewrite (FIXED + Keybind + Extras)
    ============================================================
    Same visual/behavioural feature set as the original monolithic
    script, reorganized into independent modules:

        Utils      -> color math, corner/padding/stroke helpers, hex <-> Color3
        Animator   -> hover/press stroke effect, generic tween + gradient-lerp helper
        Theme      -> holds the current {Color, Accent}, notifies subscribers on change
        Window     -> chrome: loading screen, titlebar, drag, resize, minimize
        Components -> factory functions for each control (Button, Label, Toggle, Slider,
                       NumberStepper, Textbox, Dropdown, MultiDropdown, RadioGroup,
                       ColorPicker, ThemeGrid, GradientPicker, Keybind, Accordion,
                       TableList, Notification)
        Tab        -> a page + its tab button; exposes Tab:AddXxx(opts) which delegates to Components
        Config     -> Flags + SaveConfig/LoadConfig (writefile/readfile via executor)

    Every component returned by Components.* implements the same tiny interface:
        obj.Instance      -- root GuiObject
        obj:ApplyTheme(color, accent)  -- called automatically by Theme:Apply()
        obj:Destroy()                  -- optional cleanup

    This keeps the file a single drop-in script (works fine from an executor,
    no ReplicatedStorage / require() needed) while still being a real
    component library internally: every control is built once, in one place,
    and reused instead of copy-pasted three times (the old Dropdown /
    MultiDropdown / ColorPicker collapsible-header logic is now one
    `Components.ExpandableHeader` helper shared by all three).

    The window has no in-UI close button / close-confirm dialog — it is
    closed programmatically instead, via `Selenix:Destroy()`.

    CHANGES IN THIS REVISION:
      * Fix: Dropdown/MultiDropdown row buttons now use their own
        per-instance ConnectionManager ("rowConnMgr") that is fully
        disconnected before each Refresh()/rebuild, instead of leaking a
        growing pile of dead connections into the window's shared
        ConnectionManager every time :Refresh() is called (e.g. every
        Save/Delete in CreateConfigList).
      * Components.Keybind + TabMeta:CreateKeybind, following the
        same {Instance, Get, Set, ApplyTheme} contract as Toggle/Slider/
        Textbox, so it auto-registers into SaveConfig/LoadConfig via
        opts.Flag. Includes a per-window "only one Keybind capturing at a
        time" guard (keybindListening) so rebinding one Keybind can't
        spuriously fire another Keybind's Pressed() callback.
      * Fix: Toggle:Set / Textbox:Set / Keybind:Set now fire opts.Callback,
        so Window:LoadConfig actually rewires consumer-side logic instead
        of only repainting the control.
      * Fix: Slider Min > Max is now swapped instead of falling back to a
        range of 1 (which produced silently-wrong alpha math).
      * New: Components.NumberStepper — textbox + -/+ buttons, easier to
        drive precisely on touch than dragging Slider.
      * New: Components.RadioGroup — always-expanded single-select list,
        for 2-4 option choices that don't need Dropdown's collapse.
      * New: Components.Accordion (+ AccordionMeta) — reuses
        ExpandableHeader but self-measures its body height from the
        content UIListLayout instead of a fixed BodyHeight, so any mix of
        child controls can be nested inside and it still expands/collapses
        to the right size.
      * New: Components.TableList — scrollable row list with an optional
        per-row toggle (checkbox) or click callback, for ???-style
        per-entity lists. :Refresh(newItems) rebuilds cheaply via its own
        rowConnMgr (same leak-avoidance pattern as Dropdown/MultiDropdown).
      * New: TabMeta:CreateSearchBar — filters every control created in
        that tab (via a generic wrapper around every TabMeta:CreateXxx
        that tags obj.Instance with a searchable attribute) by Text/Title,
        case-insensitive substring match, toggling Visible so
        UIListLayout reflows automatically.

    PATCH NOTES (this file):
      * Fix: Accordion no longer skips its first-open height priming when
        DefaultOpen is false/omitted — previously :recompute() only ran
        inside the DefaultOpen branch, so the FIRST manual open of an
        accordion snapped to the stale BodyHeight=0 default (closedHeight
        + 6px) before AbsoluteContentSize fired and corrected it, which
        looked like the body "jumping"/overlapping the header on open.
      * Fix: TabMeta:CreateSearchBar's input box now gets both left AND
        right UIPadding (previously only left was passed to
        Utils.AddPadding, so the placeholder/typed text sat flush against
        the right edge while the left side had a 10px gap).
      * Fix: Components.Paragraph now waits two Heartbeat frames (matching
        the pattern already used by Components.Notification) before
        measuring body.AbsoluteSize.Y for the clipped bodyClip height —
        one frame was not always enough for a multi-line TextLabel's
        AutomaticSize to fully converge, which cropped the last line.
      * Fix: Components.TableList — the per-row checkmark TextLabel was
        being assigned to a NEW block-scoped `local mark` inside the
        `if hasToggle then` branch instead of the outer `mark` variable
        declared alongside `check`. That left the outer `mark` permanently
        nil, so MouseButton1Click handler's `TweenService:Create(mark, ...)`
        threw on every click — which meant the following lines, including
        `item.OnToggle(toggled)`, never ran. Any consumer callback wired to
        a TableList row's checkbox was silently dead. Fixed by assigning to
        the outer `mark` instead of shadowing it.
      * Change: Components.RadioGroup no longer supports deselecting the
        currently-selected option by clicking it again (previously reused
        Dropdown's toggle-off-on-reclick behavior). A radio group should
        always have exactly one option selected once a Default is provided;
        Dropdown keeps its original deselect-on-reclick behavior since an
        optional "nothing selected" dropdown state is still a legitimate,
        commonly-used pattern.
      * Robustness: Dropdown/MultiDropdown's searchable variant no longer
        mutates the caller's own `opts.OnToggle` in place to hook "clear
        filter on close". It now reads/wraps the original callback into a
        fresh local closure instead, so the `opts` table handed in by the
        caller is left untouched (relevant if the same opts table were ever
        reused across multiple CreateDropdown/CreateMultiDropdown calls).
    ============================================================
]]

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContentProvider = game:GetService("ContentProvider")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer

local EASE = Enum.EasingStyle.Quint
local EASE_OUT = Enum.EasingDirection.Out
local EASE_IN = Enum.EasingDirection.In

-- Shared duration for the "theme changed" recolor tween used by every
-- component's ApplyTheme(). Previously most components just snapped their
-- colors straight to the new theme instead of tweening, so picking a new
-- theme in ThemeGrid looked jarring/inconsistent (only the tab buttons
-- actually animated). Everything below now tweens using this constant.
local THEME_TWEEN_DURATION = 0.3
local THEME_TWEEN_INFO = TweenInfo.new(THEME_TWEEN_DURATION, EASE, EASE_OUT)

--============================================================
-- MODULE: Utils
--============================================================
local Utils = {}

function Utils.Brighten(color, factor)
    return Color3.new(
        math.min(color.R * factor, 1),
        math.min(color.G * factor, 1),
        math.min(color.B * factor, 1)
    )
end
Utils.Darken = Utils.Brighten -- factor < 1 darkens, factor > 1 brightens; same math either way

function Utils.GetLuminance(c)
    return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

-- Contrast-safe text color for a given background, lightly tinted with `tint` (usually the accent)
function Utils.GetTextColorFor(bg, tint)
    if Utils.GetLuminance(bg) > 0.55 then
        return Color3.new(
            math.min(tint.R * 0.55 + 0.02, 1),
            math.min(tint.G * 0.55 + 0.02, 1),
            math.min(tint.B * 0.55 + 0.02, 1)
        )
    else
        return Color3.new(
            math.min(0.82 + tint.R * 0.18, 1),
            math.min(0.82 + tint.G * 0.18, 1),
            math.min(0.82 + tint.B * 0.18, 1)
        )
    end
end

-- Near-white color, lightly tinted by `tint` (usually the accent), regardless
-- of what it will sit on top of. Used for control knobs (Toggle,
-- GradientPicker's toggle) that should always read as "white" at a glance
-- but still pick up a touch of the current theme's accent so they don't look
-- totally disconnected from it.
function Utils.GetKnobColor(tint)
    return Color3.new(
        math.min(0.88 + tint.R * 0.12, 1),
        math.min(0.88 + tint.G * 0.12, 1),
        math.min(0.88 + tint.B * 0.12, 1)
    )
end

-- Standard "panel on top of the theme background" color set: a slightly
-- brightened panel background plus a slightly darkened "recessed" background
-- (used for inputs/tracks/bars sitting inside a panel), each paired with a
-- contrast-safe text color. This is the exact {panelBg, textFor(panelBg)} /
-- {darkBg, textFor(darkBg)} computation that used to be re-typed by hand at
-- the top of nearly every component's ApplyTheme — centralized here so
-- there's one place that defines "what a themed panel/input looks like".
-- Free function (not a Theme method) because ApplyTheme(color, accent,
-- isInitial) callbacks receive raw color/accent values, not the Theme
-- object itself.
function Utils.PanelColors(color, accent)
    local panelBg = Utils.Brighten(color, 1.2)
    local darkBg = Utils.Darken(color, 0.8)
    return panelBg, darkBg,
        Utils.GetTextColorFor(panelBg, accent),
        Utils.GetTextColorFor(darkBg, accent)
end

-- "Secondary"/dimmed variant of a contrast-safe text color, used by every
-- component that shows a de-emphasized label next to a primary one
-- (Label's opts.Muted, Divider's title, Paragraph's body). Previously each
-- of those three re-typed the identical "is this a light or dark theme"
-- branch by hand; centralized here so there's exactly one definition of
-- what "muted" means. `amount` (default 0.3) is how much of the base
-- textColor's tint survives on a dark theme / how much it's dimmed by on a
-- light theme — same knob every call site used with a slightly different
-- literal (0.3 for Label/Paragraph, 0.25 for Divider), now explicit.
function Utils.MutedTextColor(color, accent, amount)
    amount = amount or 0.3
    local textColor = Utils.GetTextColorFor(color, accent)
    if Utils.GetLuminance(color) > 0.55 then
        local keep = 1 - amount
        return Color3.new(textColor.R * keep, textColor.G * keep, textColor.B * keep)
    else
        local base = 1 - amount
        return Color3.new(base + textColor.R * amount, base + textColor.G * amount, base + textColor.B * amount)
    end
end

-- Swaps min/max if given in the wrong order, and returns a safe non-zero
-- range alongside them. Every ranged numeric control (Slider, NumberStepper,
-- ProgressBar) divides by (max - min) for its alpha math, so a caller
-- passing Min > Max — or Min == Max — used to either crash (math.clamp
-- requires min <= max) or divide by zero. Centralizing this means the fix
-- only has to happen (and be tested) once.
function Utils.ClampRange(min, max)
    if min > max then min, max = max, min end
    local range = (max > min) and (max - min) or 1
    return min, max, range
end

-- Returns a {roundTo, fmt} pair of functions for a given decimal precision,
-- identical logic previously hand-duplicated inside both Components.Slider
-- and Components.NumberStepper. `decimals` is clamped to a non-negative
-- integer. roundTo(n) snaps a raw number to that precision; fmt(n) renders
-- it as a display string (no trailing ".0" for whole numbers).
function Utils.MakeRounder(decimals)
    decimals = math.max(math.floor(decimals or 0), 0)
    local mult = 10 ^ decimals
    local function roundTo(n)
        return math.round(n * mult) / mult
    end
    local function fmt(n)
        if decimals <= 0 then return tostring(math.floor(n + 0.5)) end
        return string.format("%." .. decimals .. "f", n)
    end
    return roundTo, fmt
end

-- Shared substring filter used by Dropdown/MultiDropdown's Searchable
-- mode. `rows` is an array of {btn = TextButton, text = string, ...};
-- toggles each row's Visible based on a case-insensitive substring match
-- against `query` (empty query shows everything). Both components
-- previously carried a byte-identical copy of this loop.
function Utils.FilterRowsByText(rows, query)
    query = (query or ""):lower()
    for _, row in ipairs(rows) do
        row.btn.Visible = (query == "") or row.text:lower():find(query, 1, true) ~= nil
    end
end

-- Roblox has no single "pointer" UserInputType — mouse and touch each need
-- their own check everywhere a drag needs to work with both. This pair of
-- one-line checks was duplicated inline across Slider's drag/bar handlers
-- and ColorPicker's SV/Hue/BW bars; centralizing them means "what counts
-- as a drag start" and "what counts as a drag move" are each defined once.
function Utils.IsPointerDown(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end
function Utils.IsPointerMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

function Utils.AddCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = radius or UDim.new(0, 8)
    c.Parent = parent
    return c
end

-- Bo góc riêng từng góc (per-corner UICorner rounding, fully released on
-- Roblox June 23, 2026: TopLeftRadius / TopRightRadius / BottomLeftRadius /
-- BottomRightRadius). Truyền nil cho góc nào muốn giữ vuông (mặc định 0).
function Utils.AddCornerEx(parent, topLeft, topRight, bottomLeft, bottomRight)
    local c = Instance.new("UICorner")
    c.TopLeftRadius = topLeft or UDim.new(0, 0)
    c.TopRightRadius = topRight or UDim.new(0, 0)
    c.BottomLeftRadius = bottomLeft or UDim.new(0, 0)
    c.BottomRightRadius = bottomRight or UDim.new(0, 0)
    c.Parent = parent
    return c
end

function Utils.AddPadding(parent, left, right, top, bottom)
    local p = Instance.new("UIPadding")
    if left then p.PaddingLeft = left end
    if right then p.PaddingRight = right end
    if top then p.PaddingTop = top end
    if bottom then p.PaddingBottom = bottom end
    p.Parent = parent
    return p
end

function Utils.ToHex(color)
    return string.format("#%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5))
end

-- Returns color, success
function Utils.HexToColor3(text)
    local hex = text:gsub("#", ""):gsub("%s", "")
    if #hex ~= 6 or hex:match("[^0-9a-fA-F]") then
        return nil, false
    end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    return Color3.fromRGB(r, g, b), true
end

--============================================================
-- MODULE: ConnectionManager
-- Central place to track every RBXScriptConnection created by the
-- UI so Window:Destroy() can cleanly tear everything down (fixes
-- the "leak on rerun" class of bugs from the original script).
--============================================================
local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager

function ConnectionManager.new()
    return setmetatable({ _connections = {} }, ConnectionManager)
end

function ConnectionManager:Track(conn)
    table.insert(self._connections, conn)
    return conn
end

function ConnectionManager:DisconnectAll()
    for _, conn in ipairs(self._connections) do
        if conn.Connected then conn:Disconnect() end
    end
    table.clear(self._connections)
end

-- Weak-keyed by connMgr (== per window, since each Window.new gets its own
-- ConnectionManager). Tracks whether ANY Keybind belonging to that window
-- is currently capturing input, so other Keybinds on the same window can
-- suppress their Pressed() callback while a rebind is in progress —
-- otherwise typing the target key while rebinding Keybind A would also
-- fire Keybind B's/C's Pressed() if they happen to share that key. Weak
-- keys mean this table self-cleans once a window's connMgr is GC'd.
local keybindListening = setmetatable({}, { __mode = "k" })

--============================================================
-- MODULE: Animator
--============================================================
local Animator = {}

local HOVER_THICKNESS = 1.5
local PRESSED_THICKNESS = 1.5

-- Adds the thin "outline grows on hover/press" stroke used by every clickable control.
function Animator.AddThickenStroke(btn, connMgr)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "ThickenStroke"
    stroke.Thickness = 0
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn

    local function to(thickness, dur)
        TweenService:Create(stroke, TweenInfo.new(dur, EASE, EASE_OUT), { Thickness = thickness }):Play()
    end

    connMgr:Track(btn.MouseEnter:Connect(function() to(HOVER_THICKNESS, 0.25) end))
    connMgr:Track(btn.MouseLeave:Connect(function() to(0, 0.25) end))
    connMgr:Track(btn.MouseButton1Down:Connect(function() to(PRESSED_THICKNESS, 0.12) end))
    connMgr:Track(btn.MouseButton1Up:Connect(function() to(HOVER_THICKNESS, 0.18) end))
    connMgr:Track(btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then to(PRESSED_THICKNESS, 0.12) end
    end))
    connMgr:Track(btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then to(0, 0.25) end
    end))

    return stroke
end

-- Background-color hover effect.
-- baseColor can be:
--   * nil                -> "live" mode: auto-brighten whatever BackgroundColor3
--                           currently is when the mouse enters, and restore that
--                           captured value on leave. Only safe for buttons whose
--                           color is never changed by anything else afterwards.
--   * a function          -> "reactive" mode: on both enter and leave, the base
--                           color is *recomputed* by calling baseColor() fresh,
--                           instead of relying on a value captured at MouseEnter
--                           time. Use this whenever the button's real base color
--                           is also being retweened elsewhere (e.g. by
--                           Theme:Apply()) — otherwise a theme change that lands
--                           while the mouse is still hovering gets silently
--                           overwritten by the *stale* pre-change color the next
--                           time MouseLeave fires.
--   * a Color3             -> "static" mode: fixed base/hover colors, used for
--                           chrome buttons whose colors never depend on theme.
function Animator.AddHoverEffect(btn, connMgr, baseColor, hoverColor, skipStroke)
    if not skipStroke then Animator.AddThickenStroke(btn, connMgr) end
    local isDynamic = (type(baseColor) == "function")
    local liveMode = (baseColor == nil)
    local storedBase

    connMgr:Track(btn.MouseEnter:Connect(function()
        if isDynamic then
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(baseColor(), 1.2) }):Play()
        elseif liveMode then
            storedBase = btn.BackgroundColor3
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(storedBase, 1.2) }):Play()
        elseif hoverColor then
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = hoverColor }):Play()
        end
    end))
    connMgr:Track(btn.MouseLeave:Connect(function()
        if isDynamic then
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = baseColor() }):Play()
        elseif liveMode then
            if storedBase then
                TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = storedBase }):Play()
            end
        elseif baseColor then
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = baseColor }):Play()
        end
    end))
end

function Animator.Tween(obj, props, duration, style, dir)
    return TweenService:Create(obj, TweenInfo.new(duration or 0.3, style or EASE, dir or EASE_OUT), props)
end

-- Plays the same {instance, props} tween on every entry in one call, all
-- sharing one duration/style/dir. Components.Notification's Dismiss() used
-- to fire ~10 near-identical `Animator.Tween(x, {...}, 0.18, EASE, EASE_IN):Play()`
-- calls back to back for its fade-out; this collapses that into one data
-- table + one loop, the same shape Animator.ApplyTheme already uses for
-- theme-change tweens. Returns nothing — fire-and-forget, matching how the
-- original calls were used (only the outer slide/collapse tweens below are
-- gated on .Completed).
function Animator.TweenAll(entries, duration, style, dir)
    for _, entry in ipairs(entries) do
        Animator.Tween(entry[1], entry[2], duration, style, dir):Play()
    end
end

-- Shared "snap on first paint, tween on every theme change afterwards"
-- dispatcher. `entries` is an array of { instance, props } pairs, where
-- `props` is a table of {PropertyName = value} to apply to that instance.
--
-- This collapses the near-identical
--     if isInitial then
--         inst.Prop = value
--     else
--         TweenService:Create(inst, THEME_TWEEN_INFO, { Prop = value }):Play()
--     end
-- block that used to be hand-written, once per instance, inside every
-- single component's ApplyTheme(color, accent, isInitial) — component code
-- now only needs to compute the target colors and hand them to this.
function Animator.ApplyTheme(isInitial, entries)
    for _, entry in ipairs(entries) do
        local inst, props = entry[1], entry[2]
        if isInitial then
            for prop, value in pairs(props) do
                inst[prop] = value
            end
        else
            TweenService:Create(inst, THEME_TWEEN_INFO, props):Play()
        end
    end
end

-- TweenService cannot tween ColorSequence, so gradient recoloring is done with a
-- manual per-frame lerp between two flat colors (start/end keypoints).
local activeGradientLerps = setmetatable({}, { __mode = "k" }) -- weak keys: entries self-clean if `grad` is GC'd/destroyed mid-lerp
function Animator.TweenGradientColor(grad, colorSeq, duration, connMgr, instant)
    if activeGradientLerps[grad] then
        activeGradientLerps[grad]:Disconnect()
        activeGradientLerps[grad] = nil
    end
    if instant then
        grad.Color = colorSeq
        return
    end
    local targetC1 = colorSeq.Keypoints[1].Value
    local targetC2 = colorSeq.Keypoints[#colorSeq.Keypoints].Value
    local startSeq = grad.Color
    local startC1 = startSeq.Keypoints[1].Value
    local startC2 = startSeq.Keypoints[#startSeq.Keypoints].Value
    local startTime = tick()

    local conn
    conn = RunService.Heartbeat:Connect(function()
        -- grad may have been Destroy()'d while this Heartbeat connection was
        -- still pending disconnect (e.g. Window:Destroy() mid-lerp); guard
        -- against writing to / reading a dead Instance instead of relying
        -- solely on ConnectionManager's teardown timing.
        if not grad.Parent then
            conn:Disconnect()
            activeGradientLerps[grad] = nil
            return
        end
        local alpha = math.clamp((tick() - startTime) / (duration or 0.35), 0, 1)
        grad.Color = ColorSequence.new(startC1:Lerp(targetC1, alpha), startC2:Lerp(targetC2, alpha))
        if alpha >= 1 then
            conn:Disconnect()
            activeGradientLerps[grad] = nil
        end
    end)
    if connMgr then connMgr:Track(conn) end
    activeGradientLerps[grad] = conn
end

-- Manually drives GroupTransparency frame-by-frame instead of letting
-- TweenService interpolate it internally. CanvasGroup composites its whole
-- subtree into an offscreen buffer; on some executors that buffer doesn't
-- get re-composited in sync with TweenService's internal interpolation, so
-- the fade tween "completes" logically while nothing visibly changes until
-- the final frame (reads as a hard pop instead of a fade). Writing
-- GroupTransparency explicitly every Heartbeat forces a real redraw each
-- step, so the fade is guaranteed to actually render.
function Animator.FadeCanvasGroup(group, target, duration, connMgr, onComplete)
    local start = group.GroupTransparency
    local startTime = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not group.Parent then
            conn:Disconnect()
            return
        end
        local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
        local eased = 1 - (1 - alpha) ^ 3 -- cubic-out, matches the feel of EASE/EASE_OUT elsewhere
        group.GroupTransparency = start + (target - start) * eased
        if alpha >= 1 then
            conn:Disconnect()
            if onComplete then onComplete() end
        end
    end)
    if connMgr then connMgr:Track(conn) end
    return conn
end

--============================================================
-- MODULE: Theme
-- Single source of truth for {Color, Accent}. Components register
-- themselves once and get restyled automatically on every change,
-- instead of the old approach of manually listing every object in
-- one giant ApplyTheme() function.
--============================================================
local Theme = {}
Theme.__index = Theme

function Theme.new(color, accent)
    return setmetatable({
        Color = color,
        Accent = accent,
        _subscribers = {},
    }, Theme)
end

-- fn(color, accent, isInitial) is called immediately once with isInitial=true,
-- then again with isInitial=false on every subsequent Apply(). Passing this
-- flag lets every subscriber snap on the first paint and only tween on real
-- theme changes, instead of each component having to hand-roll its own
-- "initialized" flag (which most of them previously didn't, causing a
-- visible flash-then-tween on creation — see Components.* ApplyTheme below).
function Theme:Subscribe(fn)
    table.insert(self._subscribers, fn)
    fn(self.Color, self.Accent, true)
end

function Theme:Apply(color, accent)
    self.Color, self.Accent = color, accent
    for _, fn in ipairs(self._subscribers) do
        fn(color, accent, false)
    end
end

function Theme:PanelColors()
    return Utils.PanelColors(self.Color, self.Accent)
end

--============================================================
-- MODULE: Components
-- Every factory returns { Instance, ApplyTheme(color,accent), Destroy() }
--============================================================
local Components = {}

-- ---------- Label ----------
function Components.Label(parent, theme, connMgr, opts)
    local holder = Instance.new("Frame")
    holder.Size = opts.Size or UDim2.new(1, 0, 0, 34)
    holder.LayoutOrder = opts.LayoutOrder or 0
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Text or ""
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Font = opts.Bold and Enum.Font.BuilderSansBold or Enum.Font.BuilderSans
    label.TextSize = opts.TextSize or 14
    label.TextWrapped = true
    label.Parent = holder
    if opts.Padded ~= false then Utils.AddPadding(label, UDim.new(0, 15)) end

    local self = { Instance = holder }
    -- Labels sit directly on mainFrame's background (no panel of their own),
    -- so their contrast-safe color is computed against the live theme.Color
    -- itself rather than the brightened "panel" background other controls
    -- use. opts.Muted dims that same contrast-safe color instead of using a
    -- fixed gray, so muted labels stay readable on both dark and light themes.
    function self:ApplyTheme(color, accent, isInitial)
        local textColor = opts.Muted and Utils.MutedTextColor(color, accent) or Utils.GetTextColorFor(color, accent)
        Animator.ApplyTheme(isInitial, { { label, { TextColor3 = textColor } } })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Button ----------
function Components.Button(parent, theme, connMgr, opts)
    local holder = Instance.new("Frame")
    holder.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    holder.LayoutOrder = opts.LayoutOrder or 0
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = opts.Text or "Button"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.BuilderSansBold
    btn.TextSize = 16
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = holder
    Utils.AddPadding(btn, UDim.new(0, 15))
    Utils.AddCorner(btn, UDim.new(0, 8))
    -- Reactive mode: base color is recomputed fresh from the live theme on
    -- every enter/leave, so a theme change landing mid-hover can't get
    -- clobbered by a stale pre-change color when the mouse leaves.
    Animator.AddHoverEffect(btn, connMgr, function() return Utils.Brighten(theme.Color, 1.2) end)

    if opts.Callback then
        connMgr:Track(btn.MouseButton1Click:Connect(opts.Callback))
    end

    local self = { Instance = holder }
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { btn, { BackgroundColor3 = panelBg, TextColor3 = textColor } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Toggle ----------
function Components.Toggle(parent, theme, connMgr, opts)
    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -85, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.BuilderSansBold
    label.TextSize = 16
    label.Parent = frame

    local track = Instance.new("TextButton")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -15, 0.5, 0)
    track.Size = UDim2.new(0, 52, 0, 28)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = frame
    Utils.AddCorner(track, UDim.new(1, 0))

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 3, 0.5, 0)
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Utils.AddCorner(knob, UDim.new(1, 0))

    local state = opts.Default or false
    local function labelText()
        return (opts.Text or "Trạng thái") .. ": " .. (state and (opts.OnText or "Bật") or (opts.OffText or "Tắt"))
    end
    label.Text = labelText()

    local function restyle(instant)
        local darkBg = Utils.Darken(theme.Color, 0.8)
        local trackColor = state and Utils.Brighten(theme.Accent, 1.15) or darkBg
        -- Knob stays near-white at all times (readable/consistent regardless
        -- of on/off track color) but is still lightly tinted by the live
        -- accent so it doesn't look totally disconnected from the theme.
        local knobColor = Utils.GetKnobColor(theme.Accent)
        local knobX = state and (52 - 22 - 3) or 3
        local info = TweenInfo.new(instant and 0 or 0.3, EASE, EASE_OUT)
        TweenService:Create(track, info, { BackgroundColor3 = trackColor }):Play()
        TweenService:Create(knob, info, { Position = UDim2.new(0, knobX, 0.5, 0), BackgroundColor3 = knobColor }):Play()
    end

    connMgr:Track(track.MouseButton1Click:Connect(function()
        state = not state
        label.Text = labelText()
        restyle(false)
        if opts.Callback then opts.Callback(state) end
    end))

    local self = { Instance = frame }
    function self:Get() return state end
    function self:Set(v)
        if v == state then return end
        state = v
        label.Text = labelText()
        restyle(false)
        if opts.Callback then opts.Callback(state) end
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { label, { TextColor3 = textColor } },
        })
        restyle(isInitial)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Slider ----------
-- opts.Decimals (integer, default 0) lets the slider represent fractional
-- values (e.g. 0.0-1.0 uniforms) instead of always rounding to whole
-- numbers — previously `value = math.round(...)` made it impossible to
-- drive a 0-1 float parameter from this control at all.
function Components.Slider(parent, theme, connMgr, opts)
    -- Utils.ClampRange swaps a misconfigured Min > Max instead of erroring
    -- out / producing NaN positions, sizes, and drag values; Utils.MakeRounder
    -- replaces the roundTo/fmt pair that used to be hand-written here (and,
    -- identically, inside NumberStepper below).
    local min, max, range = Utils.ClampRange(opts.Min or 0, opts.Max or 100)
    local roundTo, fmt = Utils.MakeRounder(opts.Decimals)

    local value = roundTo(math.clamp(opts.Default or min, min, max))
    local suffix = opts.Suffix or "%"

    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.45, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.BuilderSansBold
    label.TextSize = 15
    label.Parent = frame

    local function labelText() return (opts.Text or "Giá trị") .. ": " .. fmt(value) .. suffix end
    label.Text = labelText()

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0.35, 0, 0, 4)
    bar.Position = UDim2.new(0.58, 0, 0, 18)
    bar.BorderSizePixel = 0
    bar.Parent = frame
    Utils.AddCorner(bar, UDim.new(1, 0))

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((value - min) / range, 0, 1, 0)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Utils.AddCorner(fill, UDim.new(1, 0))

    local drag = Instance.new("TextButton")
    drag.Size = UDim2.new(0, 20, 0, 20)
    drag.AnchorPoint = Vector2.new(0.5, 0.5)
    drag.Position = UDim2.new((value - min) / range, 0, 0.5, 0)
    drag.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    drag.Text = ""
    drag.ZIndex = 2
    drag.Parent = bar
    Utils.AddCorner(drag, UDim.new(1, 0))

    local dragging = false
    local function update(inputPos)
        local absPos, absSize = bar.AbsolutePosition, bar.AbsoluteSize
        local alpha = math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
        value = roundTo(min + alpha * range)
        alpha = (value - min) / range
        label.Text = labelText()
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        drag.Position = UDim2.new(alpha, 0, 0.5, 0)
        if opts.Callback then opts.Callback(value) end
    end

    connMgr:Track(drag.InputBegan:Connect(function(input)
        if Utils.IsPointerDown(input) then
            dragging = true
        end
    end))
    connMgr:Track(bar.InputBegan:Connect(function(input)
        if Utils.IsPointerDown(input) then
            dragging = true
            update(input.Position)
        end
    end))
    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if Utils.IsPointerDown(input) then
            dragging = false
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if dragging and Utils.IsPointerMove(input) then
            update(input.Position)
        end
    end))

    local self = { Instance = frame }
    function self:Get() return value end
    -- Programmatically set the value (used by Window:LoadConfig). Clamps
    -- to [min, max] and rounds to the same precision as manual dragging,
    -- then updates the visuals/label the same way update() does, and fires
    -- opts.Callback so consumer code stays in sync.
    function self:Set(v)
        v = roundTo(math.clamp(v, min, max))
        if v == value then return end
        value = v
        local alpha = (value - min) / range
        label.Text = labelText()
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        drag.Position = UDim2.new(alpha, 0, 0.5, 0)
        if opts.Callback then opts.Callback(value) end
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, textColor = Utils.PanelColors(color, accent)
        -- The drag handle is 20px tall against a 4px bar, so most of its
        -- visible area actually sits over the panel background rather than
        -- the thin track/fill strip beneath it — same contrast-safe color
        -- as the label, reusing `textColor`, keeps it themed instead of a
        -- fixed white that used to wash out on light themes.
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { label, { TextColor3 = textColor } },
            { bar, { BackgroundColor3 = darkBg } },
            { fill, { BackgroundColor3 = accent } },
            { drag, { BackgroundColor3 = textColor } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- NumberStepper ----------
-- Textbox nhập số trực tiếp + nút -/+ bước theo opts.Step. Dễ thao tác trên
-- Android hơn Slider (kéo tay chính xác khó), phù hợp cho giá trị rời rạc
-- (số lượng, index, iteration count...).
function Components.NumberStepper(parent, theme, connMgr, opts)
    local min, max = Utils.ClampRange(opts.Min or 0, opts.Max or 100)
    local step = opts.Step or 1
    local suffix = opts.Suffix or ""
    local function escapePattern(s)
        return (s:gsub("[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%1"))
    end
    local suffixPattern = escapePattern(suffix) .. "$"

    local roundTo, fmt = Utils.MakeRounder(opts.Decimals)

    local value = roundTo(math.clamp(opts.Default or min, min, max))

    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -160, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Text or "Giá trị"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.BuilderSansBold
    label.TextSize = 15
    label.Parent = frame

    local function makeStepBtn(xOffsetFromRight, text)
        local b = Instance.new("TextButton")
        b.AnchorPoint = Vector2.new(1, 0.5)
        b.Position = UDim2.new(1, xOffsetFromRight, 0.5, 0)
        b.Size = UDim2.new(0, 26, 0, 26)
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.BuilderSansBold
        b.TextSize = 16
        b.AutoButtonColor = false
        b.Parent = frame
        Utils.AddCorner(b, UDim.new(0, 6))
        Animator.AddThickenStroke(b, connMgr)
        return b
    end

    local plusBtn = makeStepBtn(-10, "+")
    local box = Instance.new("TextBox")
    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, -42, 0.5, 0)
    box.Size = UDim2.new(0, 60, 0, 28)
    box.Text = fmt(value) .. suffix
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.BuilderSans
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = frame
    Utils.AddCorner(box, UDim.new(0, 6))
    local minusBtn = makeStepBtn(-108, "−")

    local function setValue(v)
        v = roundTo(math.clamp(v, min, max))
        value = v
        if not box:IsFocused() then box.Text = fmt(value) .. suffix end
        if opts.Callback then opts.Callback(value) end
    end

    connMgr:Track(minusBtn.MouseButton1Click:Connect(function() setValue(value - step) end))
    connMgr:Track(plusBtn.MouseButton1Click:Connect(function() setValue(value + step) end))
    connMgr:Track(box.FocusLost:Connect(function()
        local numStr = box.Text:gsub(suffixPattern, ""):gsub("[^%d%.%-]", "")
        local n = tonumber(numStr)
        if n then setValue(n) else box.Text = fmt(value) .. suffix end
    end))

    local self = { Instance = frame }
    function self:Get() return value end
    -- Programmatically set the value (used by Window:LoadConfig).
    function self:Set(v) setValue(v) end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, textColor, boxTextColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { label, { TextColor3 = textColor } },
            { box, { BackgroundColor3 = darkBg, TextColor3 = boxTextColor } },
            { minusBtn, { BackgroundColor3 = darkBg } },
            { plusBtn, { BackgroundColor3 = darkBg } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- RadioGroup ----------
-- Chọn 1-trong-N hiển thị luôn cả list (không cần mở/đóng như Dropdown),
-- hợp khi chỉ 2-4 lựa chọn.
--
-- FIX: previously reused Dropdown's "click the selected option again to
-- deselect" behavior, which left a RadioGroup able to end up with NO
-- option selected — unexpected for a control whose whole point is "always
-- exactly one choice". Clicking the already-selected row is now a no-op;
-- selection only ever changes to a DIFFERENT option, and Options[1] is a
-- guaranteed non-nil initial selection unless the caller explicitly passes
-- Default = nil with an empty Options list.
function Components.RadioGroup(parent, theme, connMgr, opts)
    local options = opts.Options or {}
    local selected = opts.Default or options[1]
    local optionHeight = 34
    local titleHeight = (opts.Text and opts.Text ~= "") and 24 or 0

    local container = Instance.new("Frame")
    container.Size = opts.Size or UDim2.new(1, 0, 0,
        titleHeight + (#options * optionHeight) + math.max(#options - 1, 0) * 6 + 12)
    container.LayoutOrder = opts.LayoutOrder or 0
    container.Parent = parent
    Utils.AddCorner(container, UDim.new(0, 8))

    local titleLabel
    if titleHeight > 0 then
        titleLabel = Instance.new("TextLabel")
        titleLabel.Size = UDim2.new(1, -20, 0, titleHeight)
        titleLabel.Position = UDim2.new(0, 10, 0, 6)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Text = opts.Text
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left
        titleLabel.Font = Enum.Font.BuilderSansBold
        titleLabel.TextSize = 15
        titleLabel.Parent = container
    end

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, -12, 0, 0)
    list.Position = UDim2.new(0, 6, 0, titleHeight + 6)
    list.AutomaticSize = Enum.AutomaticSize.Y
    list.BackgroundTransparency = 1
    list.Parent = container
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = list

    local rows = {}
    local function restyleRows()
        for _, row in ipairs(rows) do
            local isSel = (row.text == selected)
            TweenService:Create(row.ring, TweenInfo.new(0.2, EASE, EASE_OUT), {
                BackgroundColor3 = isSel and theme.Accent or Utils.Darken(theme.Color, 0.75)
            }):Play()
            TweenService:Create(row.dot, TweenInfo.new(0.2, EASE, EASE_OUT), {
                BackgroundTransparency = isSel and 0 or 1
            }):Play()
        end
    end

    -- THÊM: đọc AllowDeselect, mặc định false (không cho bỏ chọn)
    local allowDeselect = opts.AllowDeselect == true

    local function select(text)
        -- Nếu bấm vào option đang chọn
        if text == selected then
            if allowDeselect then
                selected = nil
                restyleRows()
                if opts.Callback then opts.Callback(nil) end
            end
            return -- không làm gì thêm
        end
        -- Chọn option khác
        selected = text
        restyleRows()
        if opts.Callback then opts.Callback(text) end
    end

    for i, text in ipairs(options) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, optionHeight)
        row.LayoutOrder = i
        row.BackgroundTransparency = 1
        row.Text = ""
        row.AutoButtonColor = false
        row.Parent = list
        Animator.AddThickenStroke(row, connMgr)
        Utils.AddCorner(row, UDim.new(0, 6))

        local ring = Instance.new("Frame")
        ring.AnchorPoint = Vector2.new(0, 0.5)
        ring.Position = UDim2.new(0, 8, 0.5, 0)
        ring.Size = UDim2.new(0, 20, 0, 20)
        ring.BackgroundColor3 = Utils.Darken(theme.Color, 0.75)
        ring.Parent = row
        Utils.AddCorner(ring, UDim.new(1, 0))

        local dot = Instance.new("Frame")
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Position = UDim2.new(0.5, 0, 0.5, 0)
        dot.Size = UDim2.new(0, 10, 0, 10)
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        dot.BackgroundTransparency = (text == selected) and 0 or 1
        dot.Parent = ring
        Utils.AddCorner(dot, UDim.new(1, 0))

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -42, 1, 0)
        lbl.Position = UDim2.new(0, 36, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Font = Enum.Font.BuilderSans
        lbl.TextSize = 14
        lbl.Parent = row

        connMgr:Track(row.MouseButton1Click:Connect(function()
            select(text)
        end))
        table.insert(rows, { ring = ring, dot = dot, label = lbl, text = text })
    end

    local self = { Instance = container }
    function self:Get() return selected end
    function self:Set(v)
        if v == nil then
            if selected == nil then return end
            selected = nil
            restyleRows()
            if opts.Callback then opts.Callback(nil) end
            return
        end
        local found = false
        for _, t in ipairs(options) do if t == v then found = true break end end
        if not found then return end
        select(v)
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, _, textColor = Utils.PanelColors(color, accent)
        local entries = { { container, { BackgroundColor3 = panelBg } } }
        if titleLabel then table.insert(entries, { titleLabel, { TextColor3 = textColor } }) end
        for _, row in ipairs(rows) do
            table.insert(entries, { row.label, { TextColor3 = textColor } })
        end
        Animator.ApplyTheme(isInitial, entries)
        restyleRows()
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Textbox ----------
function Components.Textbox(parent, theme, connMgr, opts)
    local frame = Instance.new("Frame")
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = opts.LayoutOrder or 0
    frame.Parent = parent
    Utils.AddCorner(frame, UDim.new(0, 8))

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 90, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Text or "Nhập:"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.BuilderSansBold
    label.TextSize = 15
    label.Parent = frame

    local box = Instance.new("TextBox")
    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, -10, 0.5, 0)
    box.Size = UDim2.new(0, 150, 0, 28)
    box.Text = opts.Default or ""
    box.PlaceholderText = opts.Placeholder or "Nhập nội dung..."
    box.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.BuilderSans
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.ClipsDescendants = true
    box.Parent = frame
    Utils.AddPadding(box, UDim.new(0, 10), UDim.new(0, 10))
    Utils.AddCorner(box, UDim.new(0, 6))

    connMgr:Track(box.FocusLost:Connect(function(enterPressed)
        if enterPressed and opts.Callback then opts.Callback(box.Text) end
    end))

    local self = { Instance = frame }
    function self:Get() return box.Text end
    -- Programmatically set the text (used by Window:LoadConfig). Also fires
    -- opts.Callback so a config-loaded value actually reaches consumer code
    -- and not just the visible text — previously only a real FocusLost+Enter
    -- fired it, so loading a config silently never applied the effect tied
    -- to this field.
    function self:Set(v)
        box.Text = tostring(v)
        if opts.Callback then opts.Callback(box.Text) end
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, labelTextColor, boxTextColor = Utils.PanelColors(color, accent)
        Animator.ApplyTheme(isInitial, {
            { frame, { BackgroundColor3 = panelBg } },
            { label, { TextColor3 = labelTextColor } },
            { box, { BackgroundColor3 = darkBg, TextColor3 = boxTextColor } },
        })
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Divider / Section ----------
-- A section header used to visually group controls within a tab. Renders
-- optional title text plus a thin horizontal rule; unlike Label, this is
-- meant purely as a layout separator, not a themed panel background.
--
-- opts: { Text (optional), Size (optional) }
function Components.Divider(parent, theme, connMgr, opts)
    opts = opts or {}
    local hasText = opts.Text and opts.Text ~= ""

    local holder = Instance.new("Frame")
    holder.Size = opts.Size or UDim2.new(1, 0, 0, hasText and 30 or 14)
    holder.LayoutOrder = opts.LayoutOrder or 0
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label
    if hasText then
        label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 18)
        label.Position = UDim2.new(0, 0, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = opts.Text
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.BuilderSansBold
        label.TextSize = 13
        label.Parent = holder
        Utils.AddPadding(label, UDim.new(0, 2))
    end

    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 1)
    line.Position = UDim2.new(0, 0, 1, -1)
    line.BorderSizePixel = 0
    line.Parent = holder
    Utils.AddCorner(line, UDim.new(1, 0))

    local self = { Instance = holder }
    function self:ApplyTheme(color, accent, isInitial)
        local darkBg = Utils.Darken(color, 0.8)
        -- Section title reads as secondary, not primary, text — same
        -- muted-color helper Label(opts.Muted)/Paragraph's body use, with
        -- the slightly stronger 0.25 dim this control always used.
        local entries = { { line, { BackgroundColor3 = darkBg } } }
        if label then table.insert(entries, { label, { TextColor3 = Utils.MutedTextColor(color, accent, 0.25) } }) end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Paragraph ----------
-- A block of wrapped body text under a bold title. Optionally collapsible
-- (opts.Collapsible = true) so a long explanation can start hidden and be
-- expanded on click, matching the same header-click affordance as
-- ExpandableHeader-based controls (Dropdown/ColorPicker/etc), but without
-- a themed panel background of its own — it sits directly on the tab page
-- like Components.Label does.
--
-- The collapse/expand itself is animated: the body sits inside a clipped
-- "bodyClip" frame whose height is tweened between 0 and the body's
-- natural (AutomaticSize-computed) height, with the body's text fading in
-- lockstep, instead of the old instant Visible-toggle snap.
--
-- opts: { Title, Text, Collapsible (default false), DefaultOpen (default false) }
function Components.Paragraph(parent, theme, connMgr, opts)
    opts = opts or {}
    local collapsible = opts.Collapsible == true
    local open = (not collapsible) or (opts.DefaultOpen == true)

    local holder = Instance.new(collapsible and "TextButton" or "Frame")
    holder.Size = opts.Size or UDim2.new(1, 0, 0, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.LayoutOrder = opts.LayoutOrder or 0
    holder.BackgroundTransparency = 1
    if collapsible then
        holder.Text = ""
        holder.AutoButtonColor = false
    end
    holder.Parent = parent

    local inner = Instance.new("Frame")
    inner.Size = UDim2.new(1, 0, 0, 0)
    inner.AutomaticSize = Enum.AutomaticSize.Y
    inner.BackgroundTransparency = 1
    inner.Parent = holder
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = inner
    Utils.AddPadding(inner, UDim.new(0, 15), UDim.new(0, 15), UDim.new(0, 8), UDim.new(0, 8))

    local titleRow = Instance.new("Frame")
    titleRow.Size = UDim2.new(1, 0, 0, 20)
    titleRow.LayoutOrder = 1
    titleRow.BackgroundTransparency = 1
    titleRow.Parent = inner

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 1, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = opts.Title or ""
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.BuilderSansBold
    titleLabel.TextSize = 15
    titleLabel.Parent = titleRow

    local arrow
    if collapsible then
        arrow = Instance.new("TextLabel")
        arrow.AnchorPoint = Vector2.new(1, 0.5)
        arrow.Position = UDim2.new(1, 0, 0.5, 0)
        arrow.Size = UDim2.new(0, 18, 0, 18)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▾"
        arrow.Rotation = open and 180 or 0
        arrow.Font = Enum.Font.BuilderSansBold
        arrow.TextSize = 14
        arrow.Parent = titleRow
    end

    -- bodyClip: the actual LayoutOrder=2 child of `inner`. Its height is
    -- what gets tweened between 0 and the body's natural height, and its
    -- ClipsDescendants=true crops the body text during that tween instead
    -- of it just snapping visible/invisible. `body` itself always keeps
    -- AutomaticSize = Y and stays parented (and un-hidden) inside it, so
    -- its natural height can be measured/re-measured at any time via
    -- body.AbsoluteSize.Y regardless of the clip's current height.
    local bodyClip = Instance.new("Frame")
    bodyClip.Size = UDim2.new(1, 0, 0, 0)
    bodyClip.LayoutOrder = 2
    bodyClip.BackgroundTransparency = 1
    bodyClip.ClipsDescendants = true
    bodyClip.Parent = inner

    local body = Instance.new("TextLabel")
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.BackgroundTransparency = 1
    body.Text = opts.Text or ""
    body.TextWrapped = true
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.Font = Enum.Font.BuilderSans
    body.TextSize = 13
    body.TextTransparency = open and 0 or 1
    body.Parent = bodyClip

    local COLLAPSE_DURATION = 0.3

    -- Sets bodyClip's height instantly to match the body's current natural
    -- height (used for the initial paint, so a DefaultOpen=true paragraph
    -- doesn't play an opening animation the moment it's created).
    local function snapToNatural(isOpen)
        bodyClip.Size = UDim2.new(1, 0, 0, isOpen and body.AbsoluteSize.Y or 0)
    end

    if collapsible then
        -- Body text needs a render step (or two) before AbsoluteSize.Y
        -- reflects the actual wrapped height, so the very first paint is
        -- deferred — matches the pattern used elsewhere in this library
        -- for AutomaticSize convergence (see Components.Notification,
        -- which also waits two Heartbeats). One frame was not always
        -- enough for a multi-line TextLabel to finish wrapping/resizing,
        -- which cropped the last line of text on first render.
        task.defer(function()
            RunService.Heartbeat:Wait()
            RunService.Heartbeat:Wait()
            snapToNatural(open)
        end)

        connMgr:Track(holder.MouseButton1Click:Connect(function()
            open = not open
            TweenService:Create(arrow, TweenInfo.new(0.25, EASE, EASE_OUT), { Rotation = open and 180 or 0 }):Play()
            local targetHeight = open and body.AbsoluteSize.Y or 0
            TweenService:Create(bodyClip, TweenInfo.new(COLLAPSE_DURATION, EASE, EASE_OUT), {
                Size = UDim2.new(1, 0, 0, targetHeight),
            }):Play()
            TweenService:Create(body, TweenInfo.new(open and COLLAPSE_DURATION * 0.8 or COLLAPSE_DURATION * 0.5, EASE, EASE_OUT), {
                TextTransparency = open and 0 or 1,
            }):Play()
        end))
    else
        -- Not collapsible: always fully open, same two-frame defer so the
        -- clip's height matches the text's real wrapped height immediately.
        task.defer(function()
            RunService.Heartbeat:Wait()
            RunService.Heartbeat:Wait()
            snapToNatural(true)
        end)
    end

    local self = { Instance = holder }
    function self:ApplyTheme(color, accent, isInitial)
        local titleColor = Utils.GetTextColorFor(color, accent)
        local bodyColor = Utils.MutedTextColor(color, accent)
        local entries = {
            { titleLabel, { TextColor3 = titleColor } },
            { body, { TextColor3 = bodyColor } },
        }
        if arrow then table.insert(entries, { arrow, { TextColor3 = titleColor } }) end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- ExpandableHeader ----------
-- Shared "header row that expands into a body panel" used by Dropdown,
-- MultiDropdown, ColorPicker, and Accordion. Collapses several near-
-- identical blocks from the original script into one reusable piece.
function Components.ExpandableHeader(parent, theme, connMgr, opts)
    local closedHeight = opts.ClosedHeight or 46
    local bodyHeight = opts.BodyHeight or 200
    local openHeight = closedHeight + bodyHeight + 6

    local container = Instance.new("Frame")
    container.Size = opts.Size or UDim2.new(1, 0, 0, closedHeight)
    container.LayoutOrder = opts.LayoutOrder or 0
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.Parent = parent

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, -4, 0, 40)
    header.Position = UDim2.new(0, 2, 0, 3)
    header.Text = ""
    header.AutoButtonColor = false
    header.Parent = container
    Utils.AddCorner(header, UDim.new(0, 8))

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.Size = UDim2.new(1, -95, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = opts.Text or ""
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.BuilderSansBold
    titleLabel.TextSize = 15
    titleLabel.Parent = header

    local arrow = Instance.new("TextLabel")
    arrow.AnchorPoint = Vector2.new(1, 0.5)
    arrow.Position = UDim2.new(1, -12, 0.5, 0)
    arrow.Size = UDim2.new(0, 18, 0, 18)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▾"
    arrow.TextColor3 = Color3.fromRGB(255, 255, 255)
    arrow.Font = Enum.Font.BuilderSansBold
    arrow.TextSize = 16
    arrow.Parent = header

    local body = Instance.new("Frame")
    body.Position = UDim2.new(0, 2, 0, 47)
    body.Size = UDim2.new(1, -4, 0, bodyHeight)
    body.BackgroundTransparency = 1
    body.Parent = container

    -- Reactive mode: recompute the header's base color fresh from the live
    -- theme on every enter/leave (see Animator.AddHoverEffect) instead of
    -- capturing it once — otherwise a theme change while the header is
    -- hovered gets overwritten by the stale color on MouseLeave.
    Animator.AddHoverEffect(header, connMgr, function() return Utils.Brighten(theme.Color, 1.2) end)

    local open, animating = false, false
    local function setOpen(v)
        if animating or v == open then return end
        animating = true
        open = v
        TweenService:Create(arrow, TweenInfo.new(0.3, EASE, EASE_OUT), { Rotation = open and 180 or 0 }):Play()
        local tw = TweenService:Create(container, TweenInfo.new(0.33, EASE, EASE_OUT), {
            Size = UDim2.new(1, 0, 0, open and openHeight or closedHeight)
        })
        -- Gated on the tween's own Completed event so `animating` clears in
        -- sync with the actual on-screen animation instead of a fixed
        -- task.delay guess (which can unlock slightly early/late under lag
        -- and reads as stuttery timing).
        tw.Completed:Connect(function() animating = false end)
        tw:Play()
        if opts.OnToggle then opts.OnToggle(open) end
    end
    connMgr:Track(header.MouseButton1Click:Connect(function() setOpen(not open) end))

    return {
        Container = container,
        Header = header,
        TitleLabel = titleLabel,
        Arrow = arrow,
        Body = body,
        SetOpen = setOpen,
        -- Exposes closedHeight/openHeight and a way to change bodyHeight at
        -- runtime (see Components.Dropdown:Refresh below), so a caller can
        -- rebuild the body content and have the expand/collapse size still
        -- match the new content instead of clipping it or leaving dead space.
        GetClosedHeight = function() return closedHeight end,
        SetBodyHeight = function(newBodyHeight)
            bodyHeight = newBodyHeight
            openHeight = closedHeight + bodyHeight + 6
            if open then
                container.Size = UDim2.new(1, 0, 0, openHeight)
            end
        end,
    }
end

-- Shared "filter TextBox row" used by Dropdown/MultiDropdown's
-- opts.Searchable mode — both previously hand-built an identical
-- TextBox-in-a-Frame here (~15 duplicate lines each). Returns the
-- TextBox; the caller wires up its own GetPropertyChangedSignal("Text")
-- filter connection since Dropdown and MultiDropdown filter different
-- row-array shapes.
local function makeSearchBox(bodyParent, placeholder)
    local searchHolder = Instance.new("Frame")
    searchHolder.Size = UDim2.new(1, 0, 0, 28)
    searchHolder.LayoutOrder = 0
    searchHolder.BackgroundTransparency = 1
    searchHolder.Parent = bodyParent

    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, 0, 1, 0)
    searchBox.Text = ""
    searchBox.PlaceholderText = placeholder or "Tìm kiếm..."
    searchBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
    searchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    searchBox.Font = Enum.Font.BuilderSans
    searchBox.TextSize = 13
    searchBox.ClearTextOnFocus = false
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.Parent = searchHolder
    Utils.AddPadding(searchBox, UDim.new(0, 10), UDim.new(0, 10))
    Utils.AddCorner(searchBox, UDim.new(0, 6))
    return searchBox
end

-- ---------- Dropdown (single select) ----------
-- Supports opts.Searchable = true, which adds a filter TextBox above the
-- option list. Typing filters rows by a case-insensitive substring match
-- on their text (Visible toggled per-row; UIListLayout ignores invisible
-- children, so the list reflows automatically with no manual
-- repositioning needed). opts.SearchPlaceholder overrides the placeholder
-- text. The filter clears whenever the dropdown closes.
--
-- Deselect-on-reclick is intentionally KEPT for Dropdown (unlike
-- RadioGroup): clicking the currently-selected option clears the
-- selection, since "nothing chosen" is a normal, useful state for an
-- optional dropdown filter/setting.
function Components.Dropdown(parent, theme, connMgr, opts)
    local optionHeight = 32
    local searchable = opts.Searchable == true
    local SEARCH_ROW_HEIGHT = 34
    local optionButtons = {}
    local options, selected

    local rowConnMgr = ConnectionManager.new()

    local function bodyHeightFor(count)
        local base = count * optionHeight + math.max(count - 1, 0) * 6
        return searchable and (base + SEARCH_ROW_HEIGHT) or base
    end

    options = opts.Options or {}
    selected = opts.Default or options[1]

    local userOnToggle = opts.OnToggle
    local function fireOnToggle(isOpen)
        if userOnToggle then userOnToggle(isOpen) end
    end

    local exp = Components.ExpandableHeader(parent, theme, connMgr, {
        Text = opts.Text or "Chọn mục:",
        LayoutOrder = opts.LayoutOrder,
        BodyHeight = bodyHeightFor(#options),
        OnToggle = function(isOpen) fireOnToggle(isOpen) end,
    })

    local valueLabel = Instance.new("TextLabel")
    valueLabel.AnchorPoint = Vector2.new(1, 0.5)
    valueLabel.Position = UDim2.new(1, -35, 0.5, 0)
    valueLabel.Size = UDim2.new(0, 110, 1, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = selected or ""
    valueLabel.TextColor3 = Color3.fromRGB(190, 190, 200)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = Enum.Font.BuilderSans
    valueLabel.TextSize = 14
    valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
    valueLabel.Parent = exp.Header

    local searchBox
    if searchable then
        searchBox = makeSearchBox(exp.Body, opts.SearchPlaceholder)
    end

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 1, 0)
    list.Position = searchable and UDim2.new(0, 0, 0, SEARCH_ROW_HEIGHT) or UDim2.new(0, 0, 0, 0)
    list.BackgroundTransparency = 1
    list.Parent = exp.Body
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = list

    local function baseColorFor(text)
        return (text == selected) and theme.Accent or Utils.Darken(theme.Color, 0.8)
    end

    local function select(text)
        selected = text
        valueLabel.Text = text or ""
        for _, row in ipairs(optionButtons) do
            local isSel = (row.text == text)
            TweenService:Create(row.btn, TweenInfo.new(0.25, EASE, EASE_OUT), {
                BackgroundColor3 = isSel and theme.Accent or Utils.Darken(theme.Color, 0.8)
            }):Play()
        end
        if opts.Callback then opts.Callback(text) end
    end

    local function applyFilter(query)
        Utils.FilterRowsByText(optionButtons, query)
    end

    -- THÊM: đọc option AllowDeselect, mặc định true (giống hành vi cũ)
    local allowDeselect = opts.AllowDeselect ~= false

    local function rebuildOptions()
        rowConnMgr:DisconnectAll()
        for _, row in ipairs(optionButtons) do row.btn:Destroy() end
        table.clear(optionButtons)

        for i, text in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, optionHeight)
            btn.LayoutOrder = i
            btn.BackgroundColor3 = baseColorFor(text)
            btn.Text = text
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.BuilderSans
            btn.TextSize = 14
            btn.Parent = list
            Utils.AddCorner(btn, UDim.new(0, 6))
            Utils.AddPadding(btn, UDim.new(0, 10))
            Animator.AddThickenStroke(btn, rowConnMgr)

            rowConnMgr:Track(btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.18, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(baseColorFor(text), 1.2) }):Play()
            end))
            rowConnMgr:Track(btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.18, EASE, EASE_OUT), { BackgroundColor3 = baseColorFor(text) }):Play()
            end))

            -- SỬA: logic click có điều kiện AllowDeselect
            rowConnMgr:Track(btn.MouseButton1Click:Connect(function()
                if allowDeselect then
                    select(text == selected and nil or text)
                else
                    if text ~= selected then select(text) end
                end
            end))

            table.insert(optionButtons, { btn = btn, text = text })
        end

        if searchable then applyFilter(searchBox.Text) end
    end
    rebuildOptions()

    if searchable then
        -- Setting searchBox.Text below already fires this same connection
        -- (Roblox property-changed signals fire synchronously), which in
        -- turn calls applyFilter — so closing the dropdown no longer needs
        -- its own separate applyFilter("") call the way the original code
        -- had; clearing the Text is enough to clear the filter too.
        connMgr:Track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            applyFilter(searchBox.Text)
        end))
        local originalOnToggle = userOnToggle
        userOnToggle = function(isOpen)
            if not isOpen then
                searchBox.Text = ""
            end
            if originalOnToggle then originalOnToggle(isOpen) end
        end
    end

    local self = { Instance = exp.Container }
    function self:Get() return selected end
    function self:Set(v)
        if v == nil then
            select(nil)
            return
        end
        local found = false
        for _, t in ipairs(options) do if t == v then found = true break end end
        if not found then return end
        select(v)
    end
    function self:Refresh(newOptions, keepSelection)
        options = newOptions or {}
        if keepSelection then
            local stillValid = false
            for _, t in ipairs(options) do if t == selected then stillValid = true break end end
            if not stillValid then selected = options[1] end
        else
            selected = options[1]
        end
        exp.SetBodyHeight(bodyHeightFor(#options))
        rebuildOptions()
        valueLabel.Text = selected or ""
    end
    function self:Destroy()
        rowConnMgr:DisconnectAll()
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, headerTextColor, searchTextColor = Utils.PanelColors(color, accent)
        local valueTextColor = (Utils.GetLuminance(panelBg) > 0.55) and Color3.fromRGB(90, 90, 100) or Color3.fromRGB(190, 190, 200)
        local entries = {
            { exp.Header, { BackgroundColor3 = panelBg } },
            { exp.TitleLabel, { TextColor3 = headerTextColor } },
            { valueLabel, { TextColor3 = valueTextColor } },
        }
        for _, row in ipairs(optionButtons) do
            table.insert(entries, { row.btn, { BackgroundColor3 = baseColorFor(row.text) } })
        end
        if searchable then
            table.insert(entries, { searchBox, { BackgroundColor3 = darkBg, TextColor3 = searchTextColor } })
        end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- MultiDropdown ----------
-- Same opts.Searchable support as Dropdown above.
function Components.MultiDropdown(parent, theme, connMgr, opts)
    local options = opts.Options or {}
    local optionHeight = 32
    local searchable = opts.Searchable == true
    local SEARCH_ROW_HEIGHT = 34
    local selectedSet = {}
    for _, v in ipairs(opts.Default or {}) do selectedSet[v] = true end

    -- Same fix as Dropdown above: row connections live on their own
    -- ConnectionManager so :Refresh() can drop the old rows' connections
    -- instead of leaking them into the shared window connMgr.
    local rowConnMgr = ConnectionManager.new()

    local function bodyHeightFor(count)
        local base = count * optionHeight + math.max(count - 1, 0) * 6
        return searchable and (base + SEARCH_ROW_HEIGHT) or base
    end

    -- Same "don't mutate the caller's opts.OnToggle" fix as Dropdown above.
    local userOnToggle = opts.OnToggle
    local function fireOnToggle(isOpen)
        if userOnToggle then userOnToggle(isOpen) end
    end

    local exp = Components.ExpandableHeader(parent, theme, connMgr, {
        Text = opts.Text or "Chọn nhiều:",
        LayoutOrder = opts.LayoutOrder,
        BodyHeight = bodyHeightFor(#options),
        OnToggle = function(isOpen) fireOnToggle(isOpen) end,
    })

    local function summaryText()
        local names = {}
        for _, text in ipairs(options) do
            if selectedSet[text] then table.insert(names, text) end
        end
        if #names == 0 then return "Chưa chọn" end
        if #names == 1 then return names[1] end
        return #names .. " đã chọn"
    end

    local valueLabel = Instance.new("TextLabel")
    valueLabel.AnchorPoint = Vector2.new(1, 0.5)
    valueLabel.Position = UDim2.new(1, -35, 0.5, 0)
    valueLabel.Size = UDim2.new(0, 110, 1, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = summaryText()
    valueLabel.TextColor3 = Color3.fromRGB(190, 190, 200)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = Enum.Font.BuilderSans
    valueLabel.TextSize = 14
    valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
    valueLabel.Parent = exp.Header

    local searchBox
    if searchable then
        searchBox = makeSearchBox(exp.Body, opts.SearchPlaceholder)
    end

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 1, 0)
    list.Position = searchable and UDim2.new(0, 0, 0, SEARCH_ROW_HEIGHT) or UDim2.new(0, 0, 0, 0)
    list.BackgroundTransparency = 1
    list.Parent = exp.Body
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = list

    local rows = {}
    local function baseColorFor(text)
        return selectedSet[text] and theme.Accent or Utils.Darken(theme.Color, 0.8)
    end

    local function toggle(text)
        selectedSet[text] = (not selectedSet[text]) or nil
        for _, row in ipairs(rows) do
            if row.text == text then
                local isSel = selectedSet[text] and true or false
                TweenService:Create(row.btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = baseColorFor(text) }):Play()
                TweenService:Create(row.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
            end
        end
        valueLabel.Text = summaryText()
        if opts.Callback then
            local out = {}
            for _, t in ipairs(options) do if selectedSet[t] then table.insert(out, t) end end
            opts.Callback(out)
        end
    end

    local function applyFilter(query)
        Utils.FilterRowsByText(rows, query)
    end

    -- Rebuilds the option rows in `list` from the `options` array. Used both
    -- at creation and by :Refresh() below (mirrors Dropdown:Refresh).
    local function rebuildRows()
        rowConnMgr:DisconnectAll() -- drop connections belonging to the OLD rows first
        for _, row in ipairs(rows) do row.btn:Destroy() end
        table.clear(rows)

        for i, text in ipairs(options) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, optionHeight)
            btn.LayoutOrder = i
            btn.BackgroundColor3 = baseColorFor(text)
            btn.Text = "   " .. text
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.BuilderSans
            btn.TextSize = 14
            btn.Parent = list
            Utils.AddCorner(btn, UDim.new(0, 6))
            Utils.AddPadding(btn, UDim.new(0, 10))

            local check = Instance.new("TextLabel")
            check.AnchorPoint = Vector2.new(1, 0.5)
            check.Position = UDim2.new(1, -10, 0.5, 0)
            check.Size = UDim2.new(0, 20, 1, 0)
            check.BackgroundTransparency = 1
            check.Text = "✓"
            check.TextColor3 = Color3.fromRGB(255, 255, 255)
            check.Font = Enum.Font.BuilderSansBold
            check.TextSize = 16
            check.TextTransparency = selectedSet[text] and 0 or 1
            check.Parent = btn

            Animator.AddThickenStroke(btn, rowConnMgr)
            rowConnMgr:Track(btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.18, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(baseColorFor(text), 1.2) }):Play()
            end))
            rowConnMgr:Track(btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.18, EASE, EASE_OUT), { BackgroundColor3 = baseColorFor(text) }):Play()
            end))
            rowConnMgr:Track(btn.MouseButton1Click:Connect(function() toggle(text) end))

            table.insert(rows, { btn = btn, check = check, text = text })
        end

        if searchable then applyFilter(searchBox.Text) end
    end
    rebuildRows()

    if searchable then
        -- Same redundant-call removal as Dropdown above: Text = "" already
        -- fires this connection synchronously, so it clears the filter on
        -- its own without a second explicit applyFilter("") call.
        connMgr:Track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            applyFilter(searchBox.Text)
        end))
        local originalOnToggle = userOnToggle
        userOnToggle = function(isOpen)
            if not isOpen then
                searchBox.Text = ""
            end
            if originalOnToggle then originalOnToggle(isOpen) end
        end
    end

    local self = { Instance = exp.Container }
    function self:Get()
        local out = {}
        for _, t in ipairs(options) do if selectedSet[t] then table.insert(out, t) end end
        return out
    end
    -- Programmatically set the full selection (used by Window:LoadConfig).
    -- Expects an array of option strings; rebuilds selectedSet and restyles
    -- every row + the summary label to match.
    function self:Set(list_)
        local newSet = {}
        for _, v in ipairs(list_ or {}) do newSet[v] = true end
        selectedSet = newSet
        for _, row in ipairs(rows) do
            local isSel = selectedSet[row.text] and true or false
            TweenService:Create(row.btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = baseColorFor(row.text) }):Play()
            TweenService:Create(row.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
        end
        valueLabel.Text = summaryText()
        if opts.Callback then
            local out = {}
            for _, t in ipairs(options) do if selectedSet[t] then table.insert(out, t) end end
            opts.Callback(out)
        end
    end
    -- Replaces the Options list at runtime, same contract as
    -- Dropdown:Refresh (keepSelection preserves any still-valid selected
    -- entries instead of clearing the whole selection).
    function self:Refresh(newOptions, keepSelection)
        options = newOptions or {}
        if keepSelection then
            local newSet = {}
            for _, t in ipairs(options) do
                if selectedSet[t] then newSet[t] = true end
            end
            selectedSet = newSet
        else
            selectedSet = {}
        end
        exp.SetBodyHeight(bodyHeightFor(#options))
        rebuildRows()
        valueLabel.Text = summaryText()
    end
    -- See Dropdown:Destroy above.
    function self:Destroy()
        rowConnMgr:DisconnectAll()
    end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg, darkBg, headerTextColor, searchTextColor = Utils.PanelColors(color, accent)
        local valueTextColor = (Utils.GetLuminance(panelBg) > 0.55) and Color3.fromRGB(90, 90, 100) or Color3.fromRGB(190, 190, 200)
        local entries = {
            { exp.Header, { BackgroundColor3 = panelBg } },
            { exp.TitleLabel, { TextColor3 = headerTextColor } },
            { valueLabel, { TextColor3 = valueTextColor } },
        }
        for _, row in ipairs(rows) do
            table.insert(entries, { row.btn, { BackgroundColor3 = baseColorFor(row.text) } })
        end
        if searchable then
            table.insert(entries, { searchBox, { BackgroundColor3 = darkBg, TextColor3 = searchTextColor } })
        end
        Animator.ApplyTheme(isInitial, entries)
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

