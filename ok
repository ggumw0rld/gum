local Library = {}

-- Tracks the most recently created window so Library:Destroy() (i.e.
-- `Selenix:Destroy()`) has something to close without the caller needing
-- to hold onto the Window object themselves.
Library._activeWindow = nil

function Library:CreateWindow(config)
    local window = Window.new(config)
    Library._activeWindow = window
    return window
end

-- Closes the UI programmatically — e.g. `Selenix:Destroy()` — running the
-- same fade/scale-down teardown as Window:Destroy(). No-op if there is no
-- active window (already destroyed, or never created).
function Library:Destroy()
