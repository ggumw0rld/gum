        Animator.AddHoverEffect(b, connMgr, bgColor, hoverColor, true) -- skipStroke: no hover-outline frame on chrome buttons
        return b
    end

    local minimizeBtn = chromeButton(-40, "—", Color3.fromRGB(60, 60, 70), Color3.fromRGB(80, 80, 95))
    -- (close button removed — the window is closed programmatically via
    -- Selenix:Destroy(); the resize/expand titlebar button was removed
    -- earlier too — resizing is still available via the drag handle in the
    -- window's bottom-right corner)

    self:_setupDrag(titleBar, mainFrame)

    -- Theme-driven gradients (used by GradientPicker component)
    local mainGradient = Instance.new("UIGradient"); mainGradient.Rotation = 45; mainGradient.Enabled = false; mainGradient.Parent = mainFrame
    local titleGradient = Instance.new("UIGradient"); titleGradient.Rotation = 45; titleGradient.Enabled = false; titleGradient.Parent = titleBar

    -- Tab strip
    local tabContainer = Instance.new("ScrollingFrame")
    tabContainer.Size = UDim2.new(1, 0, 0, 45)
    tabContainer.Position = UDim2.new(0, 0, 0, 40)
    tabContainer.BorderSizePixel = 0
    tabContainer.ScrollingDirection = Enum.ScrollingDirection.X
    tabContainer.ScrollBarThickness = 0
    tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabContainer.AutomaticCanvasSize = Enum.AutomaticSize.X
    tabContainer.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    tabContainer.BackgroundTransparency = 1 -- hidden; blends straight into mainFrame
    tabContainer.Parent = mainFrame
    local tabContainerGradient = Instance.new("UIGradient"); tabContainerGradient.Rotation = 45; tabContainerGradient.Enabled = false; tabContainerGradient.Parent = tabContainer
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.Padding = UDim.new(0, 10)
    tabLayout.Parent = tabContainer
    Utils.AddPadding(tabContainer, UDim.new(0, 10), UDim.new(0, 10))
    self._tabContainer = tabContainer

    -- Still used as the horizontal offset new pages slide in from during a
    -- tab switch (see CreateTab's switchTo) — kept even though the cover
    -- overlay that used to size itself off of it is gone.
    local SLIDE_OFFSET = 26
    self._slideOffset = SLIDE_OFFSET

    self._gradients = {
        { Gradient = mainGradient, Tint = 1 },
        { Gradient = titleGradient, Tint = 0.7 },
        { Gradient = tabContainerGradient, Tint = 0.85 },
    }

    self:_setupResize(mainFrame, originalSize)
    self:_setupMinimize(mainFrame, minimizeBtn)

    -- Theme subscription for chrome pieces. isInitial=true on the first
    -- (synchronous) call snaps every color instantly; every call after that
    -- is a real theme change from ThemeGrid, so it animates like every other
    -- component instead of the old hand-rolled `chromeThemeInitialized` flag.
    theme:Subscribe(function(color, accent, isInitial)
        local darkTitle = Utils.Darken(color, 0.7)
        local darkTab = Utils.Darken(color, 0.85)
        local strokeColor = Utils.Brighten(color, 1.3)
        local titleTextColor = Utils.GetTextColorFor(darkTitle, accent)

        if isInitial then
            mainFrame.BackgroundColor3 = color
            titleBar.BackgroundColor3 = darkTitle
            tabContainer.BackgroundColor3 = darkTab
            stroke.Color = strokeColor
            titleLabel.TextColor3 = titleTextColor
        else
            local info = THEME_TWEEN_INFO
            TweenService:Create(mainFrame, info, { BackgroundColor3 = color }):Play()
            TweenService:Create(titleBar, info, { BackgroundColor3 = darkTitle }):Play()
            TweenService:Create(tabContainer, info, { BackgroundColor3 = darkTab }):Play()
            TweenService:Create(stroke, info, { Color = strokeColor }):Play()
            TweenService:Create(titleLabel, info, { TextColor3 = titleTextColor }):Play()
        end

        self:_restyleTabButtons(color, accent)
    end)
end

