function Window:_setupDrag(titleBar, mainFrame)
    local connMgr = self._connMgr
    local dragging, dragInput, dragStart, startPos
    local dragEndConn

    connMgr:Track(titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            if dragEndConn then dragEndConn:Disconnect() end
            dragEndConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))
    connMgr:Track(titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
end

function Window:_setupResize(mainFrame, originalSize)
    local connMgr = self._connMgr
    local MIN_W, MIN_H, MAX_W, MAX_H = 340, 260, 700, 650
    self._currentTargetSize = originalSize

    local handle = Instance.new("TextButton")
    handle.AnchorPoint = Vector2.new(1, 1)
    handle.Size = UDim2.new(0, 22, 0, 22)
    handle.Position = UDim2.new(1, -2, 1, -2)
    handle.BackgroundTransparency = 1
    handle.Text = "◢"
    handle.TextColor3 = Color3.fromRGB(150, 150, 165)
    handle.TextSize = 16
    handle.Font = Enum.Font.GothamBold
    handle.ZIndex = 15
    handle.Active = true
    handle.Parent = mainFrame
    self._resizeHandle = handle

    local dragging, dragStart, startSize
    connMgr:Track(handle.InputBegan:Connect(function(input)
        if self._minimized or self._animating then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startSize = mainFrame.Size
        end
    end))
    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            self._currentTargetSize = mainFrame.Size
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local w = math.clamp(startSize.X.Offset + delta.X, MIN_W, MAX_W)
            local h = math.clamp(startSize.Y.Offset + delta.Y, MIN_H, MAX_H)
            mainFrame.Size = UDim2.new(0, w, 0, h)
        end
    end))
    connMgr:Track(handle.MouseEnter:Connect(function()
        if not self._minimized then Animator.Tween(handle, { TextColor3 = Color3.fromRGB(220, 220, 230) }, 0.25):Play() end
    end))
    connMgr:Track(handle.MouseLeave:Connect(function()
        Animator.Tween(handle, { TextColor3 = Color3.fromRGB(150, 150, 165) }, 0.25):Play()
    end))
end

function Window:_setupMinimize(mainFrame, minimizeBtn)
    local connMgr = self._connMgr
    self._minimized = false
    self._animating = false

    connMgr:Track(minimizeBtn.MouseButton1Click:Connect(function()
        if self._animating then return end
        self._animating = true
        self._minimized = not self._minimized
        if self._minimized then
            minimizeBtn.Text = "▢"
            self._resizeHandle.Visible = false
            self._tabContainer.Visible = false
            for _, p in ipairs(self._pages) do p.Visible = false end
            Animator.Tween(mainFrame, { Size = UDim2.new(mainFrame.Size.X.Scale, mainFrame.Size.X.Offset, 0, 40) }, 0.45):Play()
        else
            minimizeBtn.Text = "—"
            Animator.Tween(mainFrame, { Size = self._currentTargetSize }, 0.45):Play()
            self._tabContainer.Visible = true
            for i, p in ipairs(self._pages) do
                p.Visible = (i == self._activeTabIndex)
                p.Position = UDim2.new(0, 10, 0, 95)
            end
            self._resizeHandle.Visible = true
        end
        task.delay(0.45, function() self._animating = false end)
    end))
end

-- Tab text colors are theme-driven: active tab uses a contrast-safe color
-- computed against the accent (like Button/Toggle do), inactive tabs use
-- contrast-safe color against the dark inactive background, instead of the
-- old hardcoded white/gray pair that never adapted to the live theme.
function Window:_restyleTabButtons(color, accent)
    local inactiveBg = Utils.Darken(color, 0.82)
    for i, btn in ipairs(self._tabButtons) do
        local isActive = (i == self._activeTabIndex)
        local bg = isActive and accent or inactiveBg
        Animator.Tween(btn, {
            BackgroundColor3 = bg,
            TextColor3 = Utils.GetTextColorFor(bg, accent),
        }, 0.25):Play()
    end
end

function Window:CreateTab(name)
    local index = #self._tabButtons + 1
    local connMgr, theme, mainFrame = self._connMgr, self._theme, self._mainFrame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 120, 0, 35)
    btn.LayoutOrder = index
    btn.BackgroundColor3 = (index == 1) and theme.Accent or Utils.Darken(theme.Color, 0.82)
    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    -- Without this, Roblox's own built-in button-hover recolor runs on top
    -- of BackgroundColor3 alongside our tween below, fighting it every frame.
    btn.AutoButtonColor = false
    btn.Parent = self._tabContainer
    Utils.AddCorner(btn, UDim.new(0, 6))

    local function tabBaseColor()
        return (index == self._activeTabIndex) and theme.Accent or Utils.Darken(theme.Color, 0.82)
    end
    -- Text color is now computed for contrast against the live theme instead
    -- of a hardcoded white/gray pair, so it stays readable (and tweens
    -- correctly) on any theme, including light ones.
    local function tabTextColor()
        return Utils.GetTextColorFor(tabBaseColor(), theme.Accent)
    end
    local function tabHoverTextColor()
        return Utils.GetTextColorFor(Utils.Brighten(tabBaseColor(), 1.2), theme.Accent)
    end

    btn.TextColor3 = tabTextColor() -- initial paint, matches the theme active at creation time

    connMgr:Track(btn.MouseEnter:Connect(function()
        local hoverBg = Utils.Brighten(tabBaseColor(), 1.2)
        TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), {
            BackgroundColor3 = hoverBg,
            TextColor3 = tabHoverTextColor(),
        }):Play()
    end))
    connMgr:Track(btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), {
            BackgroundColor3 = tabBaseColor(),
            TextColor3 = tabTextColor(),
        }):Play()
    end))
    table.insert(self._tabButtons, btn)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -20, 1, -110)
    page.Position = UDim2.new(0, 10, 0, 95)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = mainFrame
    page.Visible = (index == 1)
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)
    layout.Parent = page
    Utils.AddPadding(page, UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 4), UDim.new(0, 4))
    table.insert(self._pages, page)

    local switching = false
    local PAGE_BASE_POS = UDim2.new(0, 10, 0, 95)
    local function switchTo()
        if switching or index == self._activeTabIndex then return end
        switching = true
        local previousIndex = self._activeTabIndex
        local direction = (index > previousIndex) and 1 or -1
        self._activeTabIndex = index
        self:_restyleTabButtons(theme.Color, theme.Accent)

        self._pages[previousIndex].Visible = false
        self._pages[previousIndex].Position = PAGE_BASE_POS

        local newPage = self._pages[index]
        newPage.Position = UDim2.new(0, 10 + direction * self._slideOffset, 0, 95)
        newPage.Visible = true

        local slide = Animator.Tween(newPage, { Position = PAGE_BASE_POS }, 0.35)
        slide.Completed:Connect(function() switching = false end)
        slide:Play()
    end
    connMgr:Track(btn.MouseButton1Click:Connect(switchTo))

    theme:Subscribe(function(color, accent) self:_restyleTabButtons(color, accent) end)

    local tab = setmetatable({
        _page = page,
        _button = btn,
        _theme = theme,
        _connMgr = connMgr,
        _order = 0,
    }, TabMeta)
    table.insert(self._tabs, tab)
    return tab
end

function Window:Destroy()
    if activeWindows[self._title] == self._connMgr then
        activeWindows[self._title] = nil
    end
    self._connMgr:DisconnectAll()
    local mainScale = self._mainFrame:FindFirstChildOfClass("UIScale")
    local shadow = self._mainFrame:FindFirstChildOfClass("UIShadow")
    if mainScale then Animator.Tween(mainScale, { Scale = 0.5 }, 0.3, EASE, EASE_IN):Play() end
    Animator.Tween(self._mainFrame, { BackgroundTransparency = 1 }, 0.3, EASE, EASE_IN):Play()
    if shadow then Animator.Tween(shadow, { Transparency = 1 }, 0.3, EASE, EASE_IN):Play() end
    task.delay(0.3, function() self._screenGui:Destroy() end)
end

function Window:GetTheme() return self._theme end
function Window:GetGradients() return self._gradients end

--============================================================
-- Notification layer
-- Independent of mainFrame (parented directly to the ScreenGui) so
-- toasts keep showing even while the window is minimized, and stay
-- visible above the rest of the chrome via ZIndex.
--============================================================
function Window:_buildNotificationLayer()
    local screenGui = self._screenGui

    local container = Instance.new("Frame")
    container.Name = "Notifications"
    container.AnchorPoint = Vector2.new(1, 0)
    container.Position = UDim2.new(1, -20, 0, 20)
    container.BackgroundTransparency = 1
    container.ZIndex = 100
    container.Parent = screenGui

    -- Width caps at 300px but shrinks on narrow/mobile screens, always
    -- keeping a 20px margin on both sides so the rounded card never clips
    -- off the left edge of the viewport.
    local MAX_WIDTH = 300
    local MIN_MARGIN = 20
    local function updateContainerSize()
        local viewport = workspace.CurrentCamera.ViewportSize
        local w = math.min(MAX_WIDTH, viewport.X - MIN_MARGIN * 2)
        container.Size = UDim2.new(0, w, 1, -40)
    end
    updateContainerSize()
    self._connMgr:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateContainerSize))

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.Padding = UDim.new(0, 8)
    layout.Parent = container

    self._notifContainer = container
    self._notifOrder = 0

    -- Caps the number of simultaneous toasts so a spammy Notify() loop can't
    -- flood the whole viewport; oldest visible toast is dismissed to make
    -- room for a new one instead of growing the stack unbounded.
    self._activeNotifs = {}
    self._maxNotifs = 5
end

-- opts: { Title, Text, Type = "success"|"error"|"warning"|"info", Duration (seconds, 0/nil = sticky) }
function Window:Notify(opts)
    opts = opts or {}
    self._notifOrder = self._notifOrder + 1
    opts.LayoutOrder = self._notifOrder

    if #self._activeNotifs >= self._maxNotifs then
        local oldest = table.remove(self._activeNotifs, 1)
        if oldest and oldest.Dismiss then oldest:Dismiss() end
    end

    local notif = Components.Notification(self._notifContainer, self._theme, self._connMgr, opts)
    local userOnDismiss = opts.OnDismiss
    opts.OnDismiss = function()
        for i, n in ipairs(self._activeNotifs) do
            if n == notif then table.remove(self._activeNotifs, i); break end
        end
        if userOnDismiss then userOnDismiss() end
    end
    table.insert(self._activeNotifs, notif)
    return notif
end

