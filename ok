    bwCursorStroke.Thickness = 1.5
    bwCursorStroke.Color = Color3.fromRGB(20, 20, 25)
    bwCursorStroke.Parent = bwCursor

    -- Hex input
    local hexRow = Instance.new("Frame")
    hexRow.Size = UDim2.new(1, 0, 0, 32)
    hexRow.Position = UDim2.new(0, 0, 0, 214)
    hexRow.BackgroundTransparency = 1
    hexRow.Parent = exp.Body
    local hexRowLabel = Instance.new("TextLabel")
    hexRowLabel.Size = UDim2.new(0, 40, 1, 0)
    hexRowLabel.BackgroundTransparency = 1
    hexRowLabel.Text = "HEX:"
    hexRowLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
    hexRowLabel.Font = Enum.Font.GothamBold
    hexRowLabel.TextSize = 14
    hexRowLabel.TextXAlignment = Enum.TextXAlignment.Left
    hexRowLabel.Parent = hexRow
    local hexBox = Instance.new("TextBox")
    hexBox.AnchorPoint = Vector2.new(1, 0.5)
    hexBox.Position = UDim2.new(1, 0, 0.5, 0)
    hexBox.Size = UDim2.new(0, 110, 0, 28)
    hexBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    hexBox.Text = Utils.ToHex(current())
    hexBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    hexBox.Font = Enum.Font.Gotham
    hexBox.TextSize = 14
    hexBox.ClearTextOnFocus = false
    hexBox.Parent = hexRow
    Utils.AddCorner(hexBox, UDim.new(0, 6))
    Utils.AddPadding(hexBox, UDim.new(0, 8))

    -- RGB inputs (vertical, non-overlapping)
    local rgbRow = Instance.new("Frame")
    rgbRow.Size = UDim2.new(1, 0, 0, 108)
    rgbRow.Position = UDim2.new(0, 0, 0, 254)
    rgbRow.BackgroundTransparency = 1
    rgbRow.Parent = exp.Body
    local rgbLayout = Instance.new("UIListLayout")
    rgbLayout.Padding = UDim.new(0, 6)
    rgbLayout.Parent = rgbRow

    local refresh -- forward declaration

    local function sanitizeRGBText(txt)
        local filtered = txt:gsub("%D", "")
        if #filtered > 3 then filtered = filtered:sub(1, 3) end
        local num = tonumber(filtered) or 0
        if num > 255 then filtered = "255" end
        if filtered == "" then filtered = "0" end
        return filtered
    end

    -- RGB fields used to call refresh() on EVERY keystroke via
    -- GetPropertyChangedSignal("Text"), which re-set ~10 properties (hex
    -- label, all three color bars, both cursors, swatch, sibling boxes)
    -- per character typed. Typing "255" fired 3 full refreshes. Debounced
    -- with task.defer so rapid keystrokes within the same frame collapse
    -- into a single refresh, while still feeling instant to the user.
    local rgbRefreshPending = false
    local function requestRGBRefresh(onCommit)
        if rgbRefreshPending then return end
        rgbRefreshPending = true
        task.defer(function()
            rgbRefreshPending = false
            onCommit()
        end)
    end

    local function makeRGBField(labelText, order, onCommit)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1, 0, 0, 32)
        holder.LayoutOrder = order
        holder.BackgroundTransparency = 1
        holder.Parent = rgbRow
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 30, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = labelText
        lbl.TextColor3 = Color3.fromRGB(200, 200, 210)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = holder
        local box = Instance.new("TextBox")
        box.Position = UDim2.new(0, 34, 0, 0)
        box.Size = UDim2.new(1, -34, 1, 0)
        box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        box.Text = "0"
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.Font = Enum.Font.Gotham
        box.TextSize = 14
        box.ClearTextOnFocus = false
        box.Parent = holder
        Utils.AddCorner(box, UDim.new(0, 6))
        Utils.AddPadding(box, UDim.new(0, 6))

        local isUpdating = false
        connMgr:Track(box:GetPropertyChangedSignal("Text"):Connect(function()
            if isUpdating then return end
            local clean = sanitizeRGBText(box.Text)
            if clean ~= box.Text then
                isUpdating = true
                box.Text = clean
                box.CursorPosition = #clean + 1
                isUpdating = false
            end
            requestRGBRefresh(onCommit)
        end))
        connMgr:Track(box.FocusLost:Connect(function()
            local clean = sanitizeRGBText(box.Text)
            if clean ~= box.Text then box.Text = clean end
            onCommit()
        end))
        return box
    end

    local rBox, gBox, bBox
    local function updateColorFromRGB()
        local r = math.clamp(tonumber(rBox.Text) or 0, 0, 255)
        local g = math.clamp(tonumber(gBox.Text) or 0, 0, 255)
        local b = math.clamp(tonumber(bBox.Text) or 0, 0, 255)
        hue, sat, val = Color3.fromRGB(r, g, b):ToHSV()
        refresh()
    end
    rBox = makeRGBField("R:", 1, updateColorFromRGB)
    gBox = makeRGBField("G:", 2, updateColorFromRGB)
    bBox = makeRGBField("B:", 3, updateColorFromRGB)

    -- Presets
    local presetColors = opts.Presets or {
        Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0),
        Color3.fromRGB(255, 60, 60), Color3.fromRGB(255, 150, 40),
        Color3.fromRGB(255, 230, 50), Color3.fromRGB(60, 220, 90),
        Color3.fromRGB(50, 210, 220), Color3.fromRGB(60, 120, 255),
        Color3.fromRGB(170, 80, 255), Color3.fromRGB(255, 90, 180),
    }
    local presetRow = Instance.new("Frame")
    presetRow.Size = UDim2.new(1, 0, 0, 26)
    presetRow.Position = UDim2.new(0, 0, 0, 370)
    presetRow.BackgroundTransparency = 1
    presetRow.Parent = exp.Body
    local presetLayout = Instance.new("UIListLayout")
    presetLayout.FillDirection = Enum.FillDirection.Horizontal
    presetLayout.Padding = UDim.new(0, 6)
    presetLayout.Parent = presetRow

    refresh = function()
        local pureHue = Color3.fromHSV(hue, 1, 1)
        sv.BackgroundColor3 = pureHue
        local picked = current()
        swatch.BackgroundColor3 = picked
        hexLabel.Text = Utils.ToHex(picked)
        if not hexBox:IsFocused() then hexBox.Text = Utils.ToHex(picked) end
        if not rBox:IsFocused() then rBox.Text = tostring(math.floor(picked.R * 255 + 0.5)) end
        if not gBox:IsFocused() then gBox.Text = tostring(math.floor(picked.G * 255 + 0.5)) end
        if not bBox:IsFocused() then bBox.Text = tostring(math.floor(picked.B * 255 + 0.5)) end
        svCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
        hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
        bwCursor.Position = UDim2.new(val, 0, 0.5, 0)
        bwGrad.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromHSV(hue, sat, 1))
        if opts.Callback then opts.Callback(picked) end
    end

    for _, presetColor in ipairs(presetColors) do
        local pbtn = Instance.new("TextButton")
        pbtn.Size = UDim2.new(0, 26, 0, 26)
        pbtn.BackgroundColor3 = presetColor
        pbtn.Text = ""
        pbtn.Parent = presetRow
        Utils.AddCorner(pbtn, UDim.new(0, 6))
        Animator.AddThickenStroke(pbtn, connMgr)
        connMgr:Track(pbtn.MouseButton1Click:Connect(function()
            hue, sat, val = presetColor:ToHSV()
            refresh()
        end))
    end

    -- Drag handling for SV box / hue bar / bw bar
    local activeDrag = nil
    local function updateSV(pos)
        local absPos, absSize = sv.AbsolutePosition, sv.AbsoluteSize
        sat = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        val = 1 - math.clamp((pos.Y - absPos.Y) / absSize.Y, 0, 1)
        refresh()
    end
    local function updateHue(pos)
        local absPos, absSize = hueBar.AbsolutePosition, hueBar.AbsoluteSize
        hue = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        refresh()
    end
    local function updateBW(pos)
        local absPos, absSize = bwBar.AbsolutePosition, bwBar.AbsoluteSize
        val = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
        refresh()
    end

    connMgr:Track(sv.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = "sv"; updateSV(input.Position)
        end
    end))
    connMgr:Track(hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = "hue"; updateHue(input.Position)
        end
    end))
    connMgr:Track(bwBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = "bw"; updateBW(input.Position)
        end
    end))
    connMgr:Track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = nil
        end
    end))
    connMgr:Track(UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if activeDrag == "sv" then updateSV(input.Position)
            elseif activeDrag == "hue" then updateHue(input.Position)
            elseif activeDrag == "bw" then updateBW(input.Position) end
        end
    end))

    connMgr:Track(hexBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local color, ok = Utils.HexToColor3(hexBox.Text)
            if ok then
                hue, sat, val = color:ToHSV()
                refresh()
                return
            end
        end
        hexBox.Text = Utils.ToHex(current())
    end))

    refresh()

    local self = { Instance = exp.Container }
    function self:Get() return current() end
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg = Utils.Brighten(color, 1.2)
        local headerTextColor = Utils.GetTextColorFor(panelBg, accent)
        local hexTextColor = (Utils.GetLuminance(panelBg) > 0.55) and Color3.fromRGB(90, 90, 100) or Color3.fromRGB(190, 190, 200)
        if isInitial then
            exp.Header.BackgroundColor3 = panelBg
            exp.TitleLabel.TextColor3 = headerTextColor
            hexLabel.TextColor3 = hexTextColor
        else
            TweenService:Create(exp.Header, THEME_TWEEN_INFO, { BackgroundColor3 = panelBg }):Play()
            TweenService:Create(exp.TitleLabel, THEME_TWEEN_INFO, { TextColor3 = headerTextColor }):Play()
            TweenService:Create(hexLabel, THEME_TWEEN_INFO, { TextColor3 = hexTextColor }):Play()
        end
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- ThemeGrid (grid of preset color/accent swatches) ----------
function Components.ThemeGrid(parent, theme, connMgr, opts)
    local presets = opts.Presets or {}

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.LayoutOrder = opts.LayoutOrder or 0
    container.BackgroundTransparency = 1
    container.Parent = parent
    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 44, 0, 44)
    grid.CellPadding = UDim2.new(0, 14, 0, 14)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = container

    local swatches = {}
    local selectedIndex = opts.DefaultIndex or 1

    local function selectIndex(index)
        selectedIndex = index
        for i, s in ipairs(swatches) do
            local isSel = (i == index)
            TweenService:Create(s.stroke, TweenInfo.new(0.25, EASE, EASE_OUT), { Transparency = isSel and 0 or 1 }):Play()
            TweenService:Create(s.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
        end
    end

    for index, preset in ipairs(presets) do
        local color, accent = preset[1], preset[2]
        local previewColor = Utils.Brighten(color, 1.7)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.BackgroundColor3 = previewColor
        btn.Text = ""
        btn.Parent = container
        Utils.AddCorner(btn, UDim.new(1, 0))

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = (index == selectedIndex) and 0 or 1
        stroke.Parent = btn

        local check = Instance.new("TextLabel")
        check.Size = UDim2.new(1, 0, 1, 0)
        check.BackgroundTransparency = 1
        check.Text = "✓"
        check.TextColor3 = Color3.fromRGB(255, 255, 255)
        check.Font = Enum.Font.GothamBold
        check.TextSize = 20
        check.TextTransparency = (index == selectedIndex) and 0 or 1
        check.ZIndex = 2
        check.Parent = btn

        table.insert(swatches, { check = check, stroke = stroke })

        Animator.AddThickenStroke(btn, connMgr)
        connMgr:Track(btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(previewColor, 1.15) }):Play()
        end))
        connMgr:Track(btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.25, EASE, EASE_OUT), { BackgroundColor3 = previewColor }):Play()
        end))
        connMgr:Track(btn.MouseButton1Click:Connect(function()
            theme:Apply(color, accent)
            selectIndex(index)
            if opts.Callback then opts.Callback(color, accent) end
        end))
    end

    local self = { Instance = container }
    function self:ApplyTheme() end -- swatches show fixed preset colors, not the live theme
    return self
end

-- ---------- GradientPicker (toggle + preset gradient grid) ----------
function Components.GradientPicker(parent, theme, connMgr, opts)
    local gradients = opts.TargetGradients or {} -- list of UIGradient objects to drive
    local presets = opts.Presets or {}

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, 0, 0, 40)
    toggleFrame.LayoutOrder = opts.LayoutOrder or 0
    toggleFrame.Parent = parent
    Utils.AddCorner(toggleFrame, UDim.new(0, 8))

    local toggleLabel = Instance.new("TextLabel")
    toggleLabel.Size = UDim2.new(1, -85, 1, 0)
    toggleLabel.Position = UDim2.new(0, 10, 0, 0)
    toggleLabel.BackgroundTransparency = 1
    toggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleLabel.TextXAlignment = Enum.TextXAlignment.Left
    toggleLabel.Font = Enum.Font.GothamBold
    toggleLabel.TextSize = 16
    toggleLabel.Parent = toggleFrame

    local track = Instance.new("TextButton")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -15, 0.5, 0)
    track.Size = UDim2.new(0, 52, 0, 28)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = toggleFrame
    Utils.AddCorner(track, UDim.new(1, 0))
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 3, 0.5, 0)
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
    knob.BorderSizePixel = 0
    knob.Parent = track
    Utils.AddCorner(knob, UDim.new(1, 0))

    local gridContainer = Instance.new("Frame")
    gridContainer.Size = UDim2.new(1, 0, 0, 0)
    gridContainer.AutomaticSize = Enum.AutomaticSize.Y
    gridContainer.LayoutOrder = (opts.LayoutOrder or 0) + 1
    gridContainer.BackgroundTransparency = 1
    gridContainer.Parent = parent
    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 44, 0, 44)
    grid.CellPadding = UDim2.new(0, 14, 0, 14)
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = gridContainer

    local GRADIENT_BRIGHTEN = 1.35
    local enabled = false
    local selectedIndex = nil
    local swatches = {}

    local function pushGradientColors(instant)
        local c1, c2
        if selectedIndex then
            c1, c2 = presets[selectedIndex][1], presets[selectedIndex][2]
        else
            c1, c2 = theme.Color, theme.Accent
        end
        local b1, b2 = Utils.Brighten(c1, GRADIENT_BRIGHTEN), Utils.Brighten(c2, GRADIENT_BRIGHTEN)
        for _, entry in ipairs(gradients) do
            local grad, tint = entry.Gradient, entry.Tint or 1
            local sc = ColorSequence.new(Utils.Darken(b1, tint), Utils.Darken(b2, tint))
            Animator.TweenGradientColor(grad, sc, 0.35, connMgr, instant)
        end
    end

    local function setEnabled(v)
        enabled = v
        toggleLabel.Text = (opts.Text or "Chế độ Gradient") .. ": " .. (enabled and "Bật" or "Tắt")
        local darkBg = Utils.Darken(theme.Color, 0.8)
        local trackColor = enabled and Utils.Brighten(theme.Accent, 1.15) or darkBg
        local knobX = enabled and (52 - 22 - 3) or 3
        TweenService:Create(track, TweenInfo.new(0.3, EASE, EASE_OUT), { BackgroundColor3 = trackColor }):Play()
        TweenService:Create(knob, TweenInfo.new(0.3, EASE, EASE_OUT), { Position = UDim2.new(0, knobX, 0.5, 0) }):Play()
        for _, entry in ipairs(gradients) do entry.Gradient.Enabled = enabled end
        if enabled then pushGradientColors(true) end
    end

    connMgr:Track(track.MouseButton1Click:Connect(function() setEnabled(not enabled) end))

    local function selectPreset(index)
        selectedIndex = index
        for i, s in ipairs(swatches) do
            local isSel = (i == index)
            TweenService:Create(s.stroke, TweenInfo.new(0.25, EASE, EASE_OUT), { Transparency = isSel and 0 or 1 }):Play()
            TweenService:Create(s.check, TweenInfo.new(0.25, EASE, EASE_OUT), { TextTransparency = isSel and 0 or 1 }):Play()
        end
        if enabled then pushGradientColors(false) end
    end

    for index, preset in ipairs(presets) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.BackgroundColor3 = preset[1]
        btn.Text = ""
        btn.Parent = gridContainer
        Utils.AddCorner(btn, UDim.new(0, 10))

        local swatchGrad = Instance.new("UIGradient")
        swatchGrad.Color = ColorSequence.new(preset[1], preset[2])
        swatchGrad.Rotation = 45
        swatchGrad.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 1
        stroke.Parent = btn

        local check = Instance.new("TextLabel")
        check.Size = UDim2.new(1, 0, 1, 0)
        check.BackgroundTransparency = 1
        check.Text = "✓"
        check.TextColor3 = Color3.fromRGB(255, 255, 255)
        check.Font = Enum.Font.GothamBold
        check.TextSize = 20
        check.TextTransparency = 1
        check.ZIndex = 2
        check.Parent = btn

        table.insert(swatches, { check = check, stroke = stroke })
        Animator.AddThickenStroke(btn, connMgr)
        connMgr:Track(btn.MouseButton1Click:Connect(function()
            selectPreset(index)
            if not enabled then setEnabled(true) end
        end))
    end

    setEnabled(false)

    local self = { Instance = toggleFrame, GridInstance = gridContainer }
    function self:ApplyTheme(color, accent, isInitial)
        local panelBg = Utils.Brighten(color, 1.2)
        local textColor = Utils.GetTextColorFor(panelBg, accent)
        -- Retint the track in both states now — previously this only fired
        -- when `enabled` was false, so picking a new theme while gradient
        -- mode was ON left the toggle showing the *old* accent color.
        local trackColor = enabled and Utils.Brighten(accent, 1.15) or Utils.Darken(color, 0.8)
        if isInitial then
            toggleFrame.BackgroundColor3 = panelBg
            toggleLabel.TextColor3 = textColor
            track.BackgroundColor3 = trackColor
        else
            TweenService:Create(toggleFrame, THEME_TWEEN_INFO, { BackgroundColor3 = panelBg }):Play()
            TweenService:Create(toggleLabel, THEME_TWEEN_INFO, { TextColor3 = textColor }):Play()
            TweenService:Create(track, THEME_TWEEN_INFO, { BackgroundColor3 = trackColor }):Play()
        end
        if enabled and not selectedIndex then
            pushGradientColors(isInitial)
        end
    end
    theme:Subscribe(function(c, a, initial) self:ApplyTheme(c, a, initial) end)
    return self
end

-- ---------- Notification (toast card) ----------
-- Not theme-subscribed like other controls: notifications are transient and
-- keep whatever color they were created with, except for the semantic type
-- stripe/icon color which stays fixed regardless of theme.
local NOTIF_TYPES = {
    success = { Color3.fromRGB(60, 200, 120), "✓" },
    error   = { Color3.fromRGB(220, 70, 70),  "×" },
    warning = { Color3.fromRGB(230, 170, 50), "!" },
    info    = { Color3.fromRGB(70, 140, 230), "i" },
}

function Components.Notification(parent, theme, connMgr, opts)
    local typeInfo = NOTIF_TYPES[opts.Type] or NOTIF_TYPES.info
    local accentColor, iconText = typeInfo[1], typeInfo[2]
    local duration = opts.Duration or 4

    -- Notifications are laid out by a UIListLayout on `parent` (the toast
    -- container). UIListLayout re-applies its own computed Position to every
    -- direct child whenever it recalculates the stack (new toast added,
    -- another toast resized/removed, etc), which fights any tween that's
    -- also driving that child's Position — the two write to the same
    -- property in the same frame, so the entrance slide-in / exit slide-out
    -- either snaps straight to place with no visible motion or visibly
    -- jitters as the two fight for control every time the stack reflows.
    -- Fix: give each toast its own invisible "slot" that IS the direct
    -- list-managed child (reserves the correct stacking space via
    -- AutomaticSize, never has its Position tweened), and make the visible
    -- `card` a child of that slot instead of of `parent` directly. Position
    -- tweens on `card` now happen inside a plain Frame with no layout
    -- controlling it, so they're free to run without being overwritten.
    local slot = Instance.new("Frame")
    slot.Name = "NotificationSlot"
    slot.Size = UDim2.new(1, 0, 0, 0)
    slot.AutomaticSize = Enum.AutomaticSize.Y
    slot.LayoutOrder = opts.LayoutOrder or 0
    slot.BackgroundTransparency = 1
    slot.Parent = parent

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = Utils.Brighten(theme.Color, 1.25)
    card.BorderSizePixel = 0
    -- Left un-clipped until Dismiss() explicitly turns it on. card nests two
    -- levels of AutomaticSize (card -> textHolder), which can take a frame
    -- or two to converge; clipping from the very first frame was catching it
    -- mid-computation and cutting the card down to ~icon height, which made
    -- the progress bar (anchored to that too-short height) render straight
    -- across the title/body text instead of below it.
    card.ClipsDescendants = false
    card.Parent = slot
    Utils.AddCorner(card, UDim.new(0, 10))

    local stroke = Instance.new("UIStroke")
    stroke.Color = Utils.Brighten(theme.Color, 1.5)
    stroke.Thickness = 1
    stroke.Parent = card

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 4, 1, 0)
    accentBar.BackgroundColor3 = accentColor
    accentBar.BorderSizePixel = 0
    accentBar.Parent = card
    Utils.AddCorner(accentBar, UDim.new(0, 2))

    local iconHolder = Instance.new("Frame")
    iconHolder.Size = UDim2.new(0, 26, 0, 26)
    iconHolder.Position = UDim2.new(0, 14, 0, 14)
    iconHolder.BackgroundColor3 = accentColor
    iconHolder.BackgroundTransparency = 0.8
    iconHolder.BorderSizePixel = 0
    iconHolder.Parent = card
    Utils.AddCorner(iconHolder, UDim.new(1, 0))

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(1, 0, 1, 0)
    icon.BackgroundTransparency = 1
    icon.Text = iconText
    icon.TextColor3 = accentColor
    icon.Font = Enum.Font.GothamBold
    icon.TextSize = 14
    icon.Parent = iconHolder

    local textHolder = Instance.new("Frame")
    textHolder.Position = UDim2.new(0, 52, 0, 12)
    textHolder.Size = UDim2.new(1, -90, 0, 0)
    textHolder.AutomaticSize = Enum.AutomaticSize.Y
    textHolder.BackgroundTransparency = 1
    textHolder.Parent = card
    local textLayout = Instance.new("UIListLayout")
    textLayout.Padding = UDim.new(0, 2)
    textLayout.Parent = textHolder

    -- Title auto-grows in height and wraps so long titles don't get clipped
    -- (previously fixed at 18px with no wrapping).
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, 0, 0, 0)
    titleLabel.AutomaticSize = Enum.AutomaticSize.Y
    titleLabel.LayoutOrder = 1
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = opts.Title or "Thông báo"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextYAlignment = Enum.TextYAlignment.Top
    titleLabel.TextWrapped = true
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 15
    titleLabel.Parent = textHolder

    local bodyLabel = Instance.new("TextLabel")
    bodyLabel.Size = UDim2.new(1, 0, 0, 0)
    bodyLabel.AutomaticSize = Enum.AutomaticSize.Y
    bodyLabel.LayoutOrder = 2
    bodyLabel.BackgroundTransparency = 1
    bodyLabel.Text = opts.Text or ""
    bodyLabel.TextColor3 = Color3.fromRGB(195, 195, 205)
    bodyLabel.TextXAlignment = Enum.TextXAlignment.Left
    bodyLabel.TextYAlignment = Enum.TextYAlignment.Top
    bodyLabel.TextWrapped = true
    bodyLabel.Font = Enum.Font.Gotham
    bodyLabel.TextSize = 13
    bodyLabel.Parent = textHolder

    local closeBtn = Instance.new("TextButton")
    closeBtn.AnchorPoint = Vector2.new(1, 0)
    closeBtn.Position = UDim2.new(1, -10, 0, 10)
    closeBtn.Size = UDim2.new(0, 22, 0, 22)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.Parent = card

    local bottomSpacer = Instance.new("Frame")
    bottomSpacer.Size = UDim2.new(1, 0, 0, 16)
    bottomSpacer.LayoutOrder = 3
    bottomSpacer.BackgroundTransparency = 1
    bottomSpacer.Parent = textHolder

    -- progress bar showing remaining time before auto-dismiss
    local progressTrack, progressFill
    if duration and duration > 0 then
        progressTrack = Instance.new("Frame")
        progressTrack.Size = UDim2.new(1, 0, 0, 3)
        progressTrack.AnchorPoint = Vector2.new(0, 1)
        progressTrack.Position = UDim2.new(0, 0, 1, 0)
        progressTrack.BackgroundColor3 = Utils.Darken(theme.Color, 0.8)
        progressTrack.BorderSizePixel = 0
        progressTrack.Parent = card
        progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.new(1, 0, 1, 0)
        progressFill.BackgroundColor3 = accentColor
        progressFill.BorderSizePixel = 0
        progressFill.Parent = progressTrack
    end

    connMgr:Track(closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
    end))
    connMgr:Track(closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.2, EASE, EASE_OUT), { TextColor3 = Color3.fromRGB(180, 180, 190) }):Play()
    end))

    -- Whole-card scale for a springy pop on entrance/exit (Size itself is
    -- driven by AutomaticSize, so scale is layered on top via UIScale instead
    -- of tweening Size directly).
    local cardScale = Instance.new("UIScale")
    cardScale.Scale = 0.9
    cardScale.Parent = card

    local iconScale = Instance.new("UIScale")
    iconScale.Scale = 0
    iconScale.Parent = iconHolder

    local baseCardColor = Utils.Brighten(theme.Color, 1.25)
    local baseStrokeColor = Utils.Brighten(theme.Color, 1.5)
    local dismissed = false
    local timerGeneration = 0
    local progressTween
    local self = { Instance = slot }

    card.Active = true -- lets a plain Frame receive MouseEnter/MouseLeave for hover-to-pause

    -- (Re)starts the countdown + progress-bar tween for `time` seconds and
    -- schedules the auto-dismiss. `timerGeneration` invalidates any
    -- previously-scheduled dismiss when the timer is paused/restarted.
    local function startCountdown(time)
        timerGeneration = timerGeneration + 1
        local myGen = timerGeneration
        if progressFill then
            progressTween = Animator.Tween(progressFill, { Size = UDim2.new(0, 0, 1, 0) }, time, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
            progressTween:Play()
        end
        task.delay(time, function()
            if myGen == timerGeneration and not dismissed then self:Dismiss() end
        end)
    end

    function self:Dismiss()
        if dismissed then return end
        dismissed = true
        timerGeneration = timerGeneration + 1 -- invalidate any pending auto-dismiss
        if progressTween then progressTween:Cancel() end

        -- Now that the entrance/hover phase is fully done, clip again for
        -- the exit — this hides the slide-out overshoot and the height
        -- collapse in step 2 from spilling outside the card's rounded corners.
        card.ClipsDescendants = true

        -- Step 1: slide the whole card out to the right, clear past its own
        -- width, so the exit reads as a deliberate "swipe away" instead of
        -- the small in-place fade it used to be. `card` lives inside `slot`
        -- (not directly inside the list-managed container), so this Position
        -- tween is free to run without a UIListLayout recompute snapping it
        -- back mid-flight.
        local slideDistance = card.AbsoluteSize.X + 60
        Animator.Tween(cardScale, { Scale = 0.94 }, 0.28, EASE, EASE_IN):Play()
        Animator.Tween(stroke, { Transparency = 1 }, 0.22, EASE, EASE_IN):Play()
        Animator.Tween(accentBar, { BackgroundTransparency = 1 }, 0.22, EASE, EASE_IN):Play()
        Animator.Tween(titleLabel, { TextTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        Animator.Tween(bodyLabel, { TextTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        Animator.Tween(icon, { TextTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        Animator.Tween(iconHolder, { BackgroundTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        Animator.Tween(closeBtn, { TextTransparency = 1 }, 0.18, EASE, EASE_IN):Play()
        local slideOut = Animator.Tween(card, { Position = UDim2.new(0, slideDistance, 0, 0), BackgroundTransparency = 1 }, 0.3, EASE, EASE_IN)
        slideOut:Play()

        slideOut.Completed:Connect(function()
            -- Step 2: collapse height smoothly so notifications below slide
            -- up into place instead of jumping the instant this one is gone.
            -- Shrinking `card`'s height shrinks `slot`'s AutomaticSize right
            -- along with it, which is what actually drives the list reflow.
            card.AutomaticSize = Enum.AutomaticSize.None
            card.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
            local collapse = Animator.Tween(card, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, EASE, EASE_IN)
            collapse.Completed:Connect(function()
                if opts.OnDismiss then opts.OnDismiss() end
                slot:Destroy()
            end)
            collapse:Play()
        end)
    end

    connMgr:Track(closeBtn.MouseButton1Click:Connect(function() self:Dismiss() end))

    -- Hovering a notification pauses its countdown (classic toast-UX
    -- courtesy so it doesn't vanish while you're reading it) and gives a
    -- subtle highlight so the card reads as interactive.
    connMgr:Track(card.MouseEnter:Connect(function()
        if dismissed then return end
        if progressTween then progressTween:Cancel() end
        timerGeneration = timerGeneration + 1 -- invalidate the scheduled auto-dismiss while hovered
        TweenService:Create(card, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = Utils.Brighten(baseCardColor, 1.1) }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2, EASE, EASE_OUT), { Color = accentColor, Thickness = 1.5 }):Play()
    end))
    connMgr:Track(card.MouseLeave:Connect(function()
        if dismissed then return end
        TweenService:Create(card, TweenInfo.new(0.2, EASE, EASE_OUT), { BackgroundColor3 = baseCardColor }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2, EASE, EASE_OUT), { Color = baseStrokeColor, Thickness = 1 }):Play()
        if progressFill and duration and duration > 0 then
            -- resume the countdown for whatever fraction of the bar is left,
            -- read straight off the frozen tween instead of tracking ticks
            local remaining = progressFill.Size.X.Scale * duration
            if remaining > 0.05 then
                startCountdown(remaining)
            else
                self:Dismiss()
            end
        end
    end))

    -- Entrance: slide in from the side + fade + a small springy scale
    -- overshoot (Back easing), with the icon popping in a beat later so the
    -- card doesn't feel like everything landed in one flat motion. `card` is
    -- a plain (non-list-managed) child of `slot`, so this Position tween
    -- runs uncontested.
    card.Position = UDim2.new(0, 36, 0, 0)
    card.BackgroundTransparency = 1
    stroke.Transparency = 1
    Animator.Tween(card, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 }, 0.4, Enum.EasingStyle.Back, EASE_OUT):Play()
    Animator.Tween(cardScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back, EASE_OUT):Play()
    Animator.Tween(stroke, { Transparency = 0 }, 0.3):Play()
    task.delay(0.1, function()
        if dismissed then return end
        Animator.Tween(iconScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back, EASE_OUT):Play()
    end)

    if progressFill and duration and duration > 0 then
        startCountdown(duration)
    end

    function self:ApplyTheme() end -- notifications keep their creation-time look; they're short-lived
    return self
end

--============================================================
-- MODULE: Tab (forward-declared; methods attached after Window below)
--============================================================
local TabMeta = {}
TabMeta.__index = TabMeta

--============================================================
-- MODULE: Window
-- Owns the ScreenGui, loading screen, chrome (titlebar/drag/resize/
-- minimize) and the tab strip. Delegates page content to Tab objects,
-- which delegate individual controls to Components. There is no in-UI
-- close button — the window is closed programmatically instead, via
-- Library:Destroy() (or Window:Destroy() directly).
--============================================================
local Window = {}
Window.__index = Window

-- Maps a window Title -> its ConnectionManager, for the currently-live
-- window using that title. Lets destroyExisting() fully tear down a
-- previous run's connections (drag/resize/hover/heartbeat tweens) instead
-- of only deleting its ScreenGui and leaking every connection it made,
-- which is what re-running this script used to do every single time.
local activeWindows = {}

local function destroyExisting(playerGui, name)
    local prevConnMgr = activeWindows[name]
    if prevConnMgr then
        prevConnMgr:DisconnectAll()
        activeWindows[name] = nil
    end
    local existing = playerGui:FindFirstChild(name)
    if existing then existing:Destroy() end
end

function Window.new(config)
    config = config or {}
    local title = config.Title or "Selenix"
    local size = config.Size or UDim2.new(0, 460, 0, 390)
    -- Optional titlebar icon. Pass an asset id string (e.g. "rbxassetid://123"
    -- or just the numeric id, both accepted below). Leave nil/"" to omit the
    -- icon entirely — the title text then shifts left to fill the freed space
    -- instead of leaving an empty gap where the icon would have been.
    local icon = config.Icon
    if type(icon) == "number" then icon = "rbxassetid://" .. tostring(icon) end
    if icon == "" then icon = nil end

    local playerGui = Player:WaitForChild("PlayerGui")
    destroyExisting(playerGui, title)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = title
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local connMgr = ConnectionManager.new()
    local theme = Theme.new(config.Color or Color3.fromRGB(30, 30, 35), config.Accent or Color3.fromRGB(60, 60, 70))
    activeWindows[title] = connMgr

    local self = setmetatable({
        _title = title,
        _icon = icon,
        _screenGui = screenGui,
        _connMgr = connMgr,
        _theme = theme,
        _tabs = {},
        _tabButtons = {},
        _pages = {},
        _activeTabIndex = 1,
    }, Window)

    self:_buildChrome(title, size)
    self:_buildNotificationLayer()
    return self
end

function Window:_buildChrome(title, originalSize)
    local screenGui, connMgr, theme = self._screenGui, self._connMgr, self._theme

    -- Main frame
    local mainFrame = Instance.new("Frame")
    mainFrame.AnchorPoint = Vector2.new(0.5, 0)
    mainFrame.Size = originalSize
    mainFrame.Position = UDim2.new(0.5, 0, 0.5, -originalSize.Y.Offset / 2)
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = true
    mainFrame.Active = true
    mainFrame.Visible = false
    mainFrame.BackgroundTransparency = 1
    mainFrame.Parent = screenGui
    Utils.AddCorner(mainFrame, UDim.new(0, 12))
    self._mainFrame = mainFrame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Parent = mainFrame

    local shadow = Instance.new("UIShadow")
    shadow.Color = Color3.fromRGB(0, 0, 0)
    shadow.Transparency = 1
    shadow.BlurRadius = UDim.new(0, 18)
    shadow.Offset = UDim2.new(0, 0, 0, 6)
    shadow.Parent = mainFrame

    local mainScale = Instance.new("UIScale")
    mainScale.Scale = 0.8
    mainScale.Parent = mainFrame

    -- Loading screen
    self:_buildLoadingScreen(title, mainFrame, mainScale, shadow)

    -- Titlebar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BorderSizePixel = 0
    titleBar.Active = true
    titleBar.Parent = mainFrame
    Utils.AddCorner(titleBar, UDim.new(0, 12))
    self._titleBar = titleBar

    -- Icon is only created when one was provided in CreateWindow's config;
    -- without it there's nothing reserving that left-hand space, so the
    -- title label starts further left (15px, matching the titlebar's other
    -- edge paddings) and claims the width the icon would have used instead
    -- of leaving a blank gap.
    local hasIcon = self._icon ~= nil
    local titleIcon
    if hasIcon then
        titleIcon = Instance.new("ImageLabel")
